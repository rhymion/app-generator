PORT=3001

# Dev reuses the test Postgres container/DB (my_next_test) instead of a
# separate my_next_dev. Reason: this project provisions its DB via
# `prisma db push` (PoC phase, no prisma/migrations/ yet — see
# docs/knowledge/migration-guide.md), so there's no migration-file-driven
# workflow that a separate, independently-migrated dev DB would serve.
# A standalone `my_next_dev` was defined in docker-compose.dev.yml but
# never actually provisioned, leaving DATABASE_URL pointing at a DB that
# didn't exist (cmd_368/cmd_370). Keep POSTGRES_PORT in sync with
# .env.test's POSTGRES_PORT — they must point at the same container.
POSTGRES_PORT=5433
POSTGRES_DB=my_next_test
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/my_next_test"
NEXTAUTH_URL="http://localhost:3001"

# NextAuth secret - must match the variable name used in auth.ts (AUTH_SECRET)
AUTH_TRUST_HOST=true

# Enables /api/_test/reset-caches so cypress can clear in-process LRU caches
# (api-key, permission) after cy.task('db:reset'). Production deployments
# leave this unset; the route then returns 404.
TEST_RESET_TOKEN="cypress-reset-token"

# Disable Prisma Accelerate in dev env (use direct local DB connection)
PRISMA_DATABASE_URL=
