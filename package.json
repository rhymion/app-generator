{
  "name": "my-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cleanup": "python3 code_generator/cleanup.py code_generator/json_schema.yaml ./",
    "docker:up:test": "dotenv -e .env.test -- docker compose -f docker-compose.test.yml up -d",
    "docker:down:test": "dotenv -e .env.test -- docker compose -f docker-compose.test.yml down",
    "generate-code": "python3 code_generator/generate.py code_generator/json_schema.yaml ./",
    "check:generated": "python3 code_generator/check_generated.py code_generator/json_schema.yaml ./",
    "db:push": "prisma db push",
    "db:push:test": "dotenv -e .env.test -- prisma db push",
    "migrate:dev": "prisma migrate dev",
    "migrate:dev:create-only": "prisma migrate dev --create-only",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset:test": "dotenv -e .env.test -- prisma migrate reset",
    "migrate:reset:test:force": "dotenv -e .env.test -- prisma migrate reset --force",
    "db:generate": "prisma generate",
    "db:seed-tenant:test": "dotenv -e .env.test -- tsx scripts/seed-tenant.ts",
    "db:seed:test": "dotenv -e .env.test -- tsx scripts/seed.ts",
    "dev": "next dev",
    "dev:test": "dotenv -e .env.test -- next dev",
    "build": "next build",
    "start": "next start",
    "start:test": "dotenv -e .env.test -- next start",
    "lint": "eslint",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "build:pdf-font": "python3 scripts/build_pdf_font.py",
    "cy:open": "cypress open",
    "cy:run": "cypress run --browser chromium",
    "cy:run:api": "cypress run --browser chromium --spec cypress/e2e/api/*",
    "cy:test": "start-server-and-test demo:start http://localhost:${PORT:-3000} cy:run",
    "cy:test:api": "start-server-and-test 'dotenv -e .env.test -- next dev' http://localhost:${PORT:-3000} cy:run:api",
    "db:studio": "prisma studio",
    "db:studio:test": "dotenv -e .env.test -- prisma studio",
    "env:use": "bash scripts/env-use.sh",
    "env:current": "bash scripts/env-current.sh",

    "demo:cleanup": "python3 code_generator/cleanup.py code_generator/json_schema.yaml ./ && npm run docker:up:test && dotenv -e .env.test -- prisma migrate reset --force",
    "demo:generate": "python3 code_generator/generate.py code_generator/json_schema.yaml ./  && dotenv -e .env.test -- prisma db push && prisma generate",
    "demo:start": "next build && dotenv -e .env.test -- next start",
    "build:all:test": "python3 code_generator/generate.py code_generator/json_schema.yaml ./  && dotenv -e .env.test -- prisma db push && prisma generate && next build",
    "dev:generated:test": "python3 code_generator/generate.py code_generator/json_schema.yaml ./ && dotenv -e .env.test -- prisma db push && prisma generate && dotenv -e .env.test -- next dev",
    "vercel-build": "npm run prj:sync && prisma generate && next build",
    "prj:sync": "if [ -d ../prj ]; then cp -a ../prj/. .; echo 'prj:sync: copied ../prj/. -> .'; else echo 'prj:sync: no ../prj, skipping'; fi"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/material-nextjs": "^7.3.9",
    "@mui/x-charts": "^9.1.0",
    "@mui/x-data-grid": "^8.25.0",
    "@mui/x-date-pickers": "^8.26.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@next/mdx": "^16.1.7",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-better-sqlite3": "^7.2.0",
    "@prisma/client": "^7.5.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@vercel/blob": "^2.0.1",
    "@vercel/postgres": "^0.10.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "next": "^16.1.1",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.8.3",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@marp-team/marp-cli": "^4.2.3",
    "@prisma/adapter-pg": "^7.4.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "cypress": "^15.9.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.0.2",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^27.4.0",
    "prisma": "^7.5.0",
    "start-server-and-test": "^2.1.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.17"
  }
}
