{
  "name": "my-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:pdf-font": "python3 scripts/build_pdf_font.py",
    "cleanup": "python3 code_generator/cleanup.py code_generator/json_schema.yaml ./",
    "check:generated": "python3 code_generator/check_generated.py code_generator/json_schema.yaml ./",
    "cy:open": "cross-env NODE_ENV=test cypress open",
    "db:generate": "prisma generate",
    "db:reset:test:sql": "cross-env NODE_ENV=test bash scripts/db-reset-sql.sh",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-tenant": "tsx scripts/seed-tenant.ts",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "dev": "node scripts/run-next-dev.js",
    "docker:up:dev": "docker compose --env-file .env.development -f docker-compose.dev.yml up -d",
    "docker:down:dev": "docker compose --env-file .env.development -f docker-compose.dev.yml down",
    "docker:up:test": "docker compose --env-file .env.test -f docker-compose.test.yml up -d",
    "docker:down:test": "docker compose --env-file .env.test -f docker-compose.test.yml down",
    "docker:up:prod": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d",
    "docker:down:prod": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "generate-code": "python3 code_generator/generate.py code_generator/json_schema.yaml ./",
    "migrate:dev": "prisma migrate dev",
    "migrate:dev:create-only": "prisma migrate dev --create-only",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset:test": "cross-env NODE_ENV=test prisma migrate reset",
    "lint": "eslint",
    "test:pytest": "pytest code_generator/tests",
    "start": "node scripts/run-next-start.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e:build": "cross-env NODE_ENV=test run-s docker:up:test generate-code db:push db:generate db:seed-tenant test:e2e:build:only",
    "test:e2e:start": "cross-env NODE_ENV=test node scripts/run-next-start.js",
    "test:e2e": "cross-env NODE_ENV=test run-s docker:up:test generate-code db:push db:generate db:seed-tenant test:e2e:build:only test:e2e:cy:start",
    "test:e2e:dev": "cross-env NODE_ENV=test run-s docker:up:test generate-code db:push db:generate db:seed-tenant dev",
    "test:e2e:dev:run": "cross-env NODE_ENV=test run-s docker:up:test generate-code db:push db:generate db:seed-tenant test:e2e:cy:dev",
    "test:e2e:build:only": "cross-env NODE_ENV=test next build",
    "test:e2e:cy:dev": "cross-env NODE_ENV=test node scripts/run-e2e.js dev 'cypress run --browser chromium'",
    "test:e2e:cy:api": "cross-env NODE_ENV=test node scripts/run-e2e.js test:e2e:start 'cypress run --browser chromium --spec \"cypress/e2e/api/**\"'",
    "test:e2e:cy:start": "cross-env NODE_ENV=test node scripts/run-e2e.js test:e2e:start 'cypress run --browser chromium'",
    "test:flows": "vitest run --config vitest.flows.config.ts",
    "cleanup:all": "npm run cleanup",
    "setup": "run-s generate-code db:push db:generate db:seed-tenant",
    "dev:full": "run-s docker:up:dev generate-code migrate:dev db:generate db:seed-tenant dev",
    "build:full": "cross-env NODE_ENV=production run-s docker:up:prod generate-code migrate:deploy db:generate db:seed-tenant build",
    "python-generate": "uv venv --python 3.12 .venv && source .venv/bin/activate && uv pip install -r requirements.txt && npm run generate-code",
    "vercel-build": "run-s prj:sync python-generate migrate:deploy db:generate db:seed-tenant build",
    "prj:sync": "if [ -d ../prj ]; then cp -a ../prj/. .; echo 'prj:sync: copied ../prj/. -> .'; else echo 'prj:sync: no ../prj, skipping'; fi"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@base-ui/react": "^1.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/material-nextjs": "^7.3.9",
    "@mui/x-charts": "^9.1.0",
    "@mui/x-data-grid": "^8.25.0",
    "@mui/x-date-pickers": "^8.26.0",
    "@next/mdx": "^16.1.7",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-better-sqlite3": "^7.2.0",
    "@prisma/client": "^7.8.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@vercel/blob": "^2.0.1",
    "@vercel/postgres": "^0.10.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "next": "^16.1.1",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.8.3",
    "otplib": "^13.4.0",
    "posthog-js": "^1.378.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  },
  "devDependencies": {
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@marp-team/marp-cli": "^4.2.3",
    "@prisma/adapter-pg": "^7.4.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "cross-env": "^10.1.0",
    "cypress": "^15.9.0",
    "eslint": "^10.0.2",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^27.4.0",
    "npm-run-all": "^4.1.5",
    "prisma": "^7.5.0",
    "start-server-and-test": "^2.1.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.17"
  }
}
