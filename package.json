{
  "name": "my-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:test": "dotenv -e .env.test -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "vercel-build": "prisma generate && next build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "cy:open": "cypress open",
    "cy:run": "cypress run --browser chromium",
    "cy:test": "start-server-and-test dev:test http://localhost:3000 cy:run",
    "docker:test:up": "docker-compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker-compose -f docker-compose.test.yml down",
    "db:migrate": "prisma migrate dev",
    "db:reset:test": "dotenv -e .env.test -- prisma migrate reset --force && dotenv -e .env.test -- prisma db push",
    "db:seed:test": "dotenv -e .env.test -- tsx scripts/seed-test-db.ts",
    "db:studio": "prisma studio",
    "db:use:sqlite": "bash scripts/use-sqlite.sh",
    "db:use:postgres": "bash scripts/use-postgres.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/x-data-grid": "^8.25.0",
    "@mui/x-date-pickers": "^8.26.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-better-sqlite3": "^7.2.0",
    "@prisma/client": "^7.3.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "@vercel/blob": "^2.0.1",
    "@vercel/postgres": "^0.10.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.1.1",
    "next-auth": "^4.24.13",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "cypress": "^15.9.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1-canary.15",
    "jsdom": "^27.4.0",
    "prisma": "^7.2.0",
    "start-server-and-test": "^2.1.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.17"
  }
}
