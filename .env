# Shared baseline for all environments.
# Environment-specific overrides:
#   .env.development  (NODE_ENV=development)
#   .env.test         (NODE_ENV=test)
#   .env.local        (gitignored, local secrets — skipped when NODE_ENV=test)

# Disable Prisma Accelerate; use direct local database connection by default
PRISMA_DATABASE_URL=
