# Shared baseline for all environments.
# Environment-specific overrides:
#   .env.development  (NODE_ENV=development)
#   .env.test         (NODE_ENV=test)
#   .env.local        (gitignored, local secrets — skipped when NODE_ENV=test)

# Disable Prisma Accelerate; use direct local database connection by default
PRISMA_DATABASE_URL=

# How often NotificationBell.tsx polls GET /api/notifications (ms). Notifications
# aren't urgent, so the production default is minutes-scale; .env.test overrides
# this to seconds so Cypress specs don't need to wait minutes for the bell to
# reflect a new notification. NEXT_PUBLIC_ is required because this is read in
# client-side code (Next.js inlines it at build time).
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL_MS=180000
