// [parent:music] fc_linkable_id String       @unique

// [parent:music] fc_linkable    fc_linkable? @relation("MusicFcLinkable", fields: [fc_linkable_id], references: [id])

// [parent:channel] fc_linkable_id String       @unique

// [parent:channel] fc_linkable    fc_linkable? @relation("ChannelFcLinkable", fields: [fc_linkable_id], references: [id])

// [child:fc_link] fc_linkable_id String

