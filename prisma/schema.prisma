// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  password String
  api_key   String?
  avatar   String?
  reviews  reviews[]
}

model books {
  id        String   @id @default(cuid())
  title     String
  author    String
  price     Int
  publisher String
  published String
  image     String
  reviews   reviews[]
}

model reviews {
  id        String   @id @default(cuid())
  memo      String
  read      DateTime @default(now())
  book_id    String
  book       books     @relation(fields: [book_id], references: [id])
  author_id  String
  author     users     @relation(fields: [author_id], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model db_table {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String? 
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  fields       field[]
}

model field {
  id          String   @id @default(cuid())
  name        String
  type        String
  table_id    String     
  table       db_table @relation(fields: [table_id], references: [id], onDelete: Cascade)
  max_length  Int?
  max         Int?
  regex       String?
  required    Boolean   @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model xxxxx_xxxxx {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String? 
  team         String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  yyyyy_yyyyys yyyyy_yyyyy[]
}

model yyyyy_yyyyy {
  id          String   @id @default(cuid())
  name        String
  type        String
  xxxxx_xxxxx_id    String     
  xxxxx_xxxxx       xxxxx_xxxxx @relation(fields: [xxxxx_xxxxx_id], references: [id], onDelete: Cascade)
  max_length  Int?
  max         Int?
  regex       String?
  required    Boolean   @default(true)
  written_by  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model parent1 {
  id           String   @id @default(cuid())
  name         String   @unique
  organization_id    String     
  organization       organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  description  String? 
  price        Int
  due_date     DateTime
  image_url    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  parent1_child1s parent1_child1[]
  parent1_child2s parent1_child2[]
  parent1_lists   parent1_list[]
}

model parent1_child1 {
  id          String   @id @default(cuid())
  order       Int      @default(0)
  name        String
  type        String
  parent1_id    String     
  parent1       parent1 @relation(fields: [parent1_id], references: [id], onDelete: Cascade)
  max_length  Int?
  max         Int?
  regex       String?
  required    Boolean   @default(true)
  written_by  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model parent1_child2 {
  id          String   @id @default(cuid())
  name        String
  parent1_id    String     
  parent1       parent1 @relation(fields: [parent1_id], references: [id], onDelete: Cascade)
  required    Boolean   @default(true)
  start_date  DateTime?
  end_date    DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model parent1_list {
  id          String   @id @default(cuid())
  name        String
  parent1_id    String     
  parent1       parent1 @relation(fields: [parent1_id], references: [id], onDelete: Cascade)
}

model parent_only {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String? 
  login_time   DateTime?
  logout_time  DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model user_account {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  api_key  String?
  avatar   String?
  roles    role[]
  organizations organization[]
}

model role {
  id       String  @id @default(cuid())
  name     String
  description String?
  user_accounts user_account[]
}

model organization {
  id       String  @id @default(cuid())
  name     String
  description String?
  user_accounts user_account[]
  parent1s parent1[]
}