// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model tenant {
  id          String @id @default(cuid())
  name        String?
}

model db_table {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String? 
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user_account @relation("DbTableCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user_account @relation("DbTableUpdater", fields: [updater_id], references: [id])
  fields       field[] @relation("ParentTable")
  referenced_by field[] @relation("ReferenceTable")
  db_table_comments       db_table_comment[] @relation("CommentParentTable")
}

model field {
  id          String   @id @default(cuid())
  name        String
  type        String
  db_table_id    String     
  db_table       db_table @relation("ParentTable", fields: [db_table_id], references: [id], onDelete: Cascade)
  reference_id   String?
  reference      db_table? @relation("ReferenceTable", fields: [reference_id], references: [id])
  max_length  Int
  max         Int?
  regex       String?
  required    Boolean   @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
}

model db_table_comment {
  id          String   @id @default(cuid())
  message     String
  db_table_id    String     
  db_table       db_table @relation("CommentParentTable", fields: [db_table_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user_account @relation("DbTableCommentCreator", fields: [creator_id], references: [id])
}

model xxxxx_xxxxx {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String? 
  team         String?
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user_account @relation("XxxxxXxxxxCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user_account @relation("XxxxxXxxxxUpdater", fields: [updater_id], references: [id])
  yyyyy_yyyyys yyyyy_yyyyy[]
}

model yyyyy_yyyyy {
  id          String   @id @default(cuid())
  name        String
  type        String
  xxxxx_xxxxx_id    String     
  xxxxx_xxxxx       xxxxx_xxxxx @relation(fields: [xxxxx_xxxxx_id], references: [id], onDelete: Cascade)
  max_length  Int?
  max         Int?
  regex       String?
  required    Boolean   @default(true)
  written_by  String
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
}

model parent1 {
  id           String   @id @default(cuid())
  name         String   @unique
  organization_id    String     
  organization       organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  description  String? 
  price        Int
  due_date     DateTime @db.Timestamptz(0)
  image_url    String?
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user_account @relation("Parent1Creator", fields: [creator_id], references: [id])
  updater_id String
  updater    user_account @relation("Parent1Updater", fields: [updater_id], references: [id])
  parent1_child1s parent1_child1[]
  parent1_child2s parent1_child2[]
  parent1_lists   parent1_list[]
}

model parent1_child1 {
  id          String   @id @default(cuid())
  order       Int      @default(0)
  name        String
  type        String
  parent1_id    String     
  parent1       parent1 @relation(fields: [parent1_id], references: [id], onDelete: Cascade)
  max_length  Int?
  max         Int?
  regex       String?
  required    Boolean   @default(true)
  written_by  String
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
}

model parent1_child2 {
  id          String   @id @default(cuid())
  name        String
  parent1_id    String     
  parent1       parent1 @relation(fields: [parent1_id], references: [id], onDelete: Cascade)
  required    Boolean   @default(true)
  start_date  DateTime? @db.Timestamptz(0)
  end_date    DateTime  @db.Timestamptz(0)
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
}

model parent1_list {
  id          String   @id @default(cuid())
  name        String
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  parent1_id    String     
  parent1       parent1 @relation(fields: [parent1_id], references: [id], onDelete: Cascade)
}

model parent_only {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String? 
  login_time   DateTime? @db.Timestamptz(0)
  logout_time  DateTime? @db.Timestamptz(0)
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user_account @relation("ParentOnlyCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user_account @relation("ParentOnlyUpdater", fields: [updater_id], references: [id])
}

model user_account {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  api_key  String?
  avatar   String?
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user_account @relation("UserAccountCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user_account @relation("UserAccountUpdater", fields: [updater_id], references: [id])
  roles    role[] @relation("UserRoles")
  shift_templates    shift_template[] @relation("ShiftTemplateUser")
  shifts    shift[] @relation("ShiftUser")
  organizations organization[] @relation("UserOrganizations")
  purchase_orders purchase_order[] @relation("Buyer")
  created_db_tables db_table[] @relation("DbTableCreator")
  updated_db_tables db_table[] @relation("DbTableUpdater")
  created_xxxxx_xxxxxs xxxxx_xxxxx[] @relation("XxxxxXxxxxCreator")
  updated_xxxxx_xxxxxs xxxxx_xxxxx[] @relation("XxxxxXxxxxUpdater")
  created_parent1s parent1[] @relation("Parent1Creator")
  updated_parent1s parent1[] @relation("Parent1Updater")
  created_parent_onlys parent_only[] @relation("ParentOnlyCreator")
  updated_parent_onlys parent_only[] @relation("ParentOnlyUpdater")
  created_permissions permission[] @relation("PermissionCreator")
  updated_permissions permission[] @relation("PermissionUpdater")
  created_procedures procedure[] @relation("ProcedureCreator")
  updated_procedures procedure[] @relation("ProcedureUpdater")
  assigned_procedures procedure[] @relation("ProcedureAssignee")
  created_roles    role[] @relation("RoleCreator")
  updated_roles    role[] @relation("RoleUpdater")
  created_organizations organization[] @relation("OrganizationCreator")
  updated_organizations organization[] @relation("OrganizationUpdater")
  created_user_accounts user_account[] @relation("UserAccountCreator")
  updated_user_accounts user_account[] @relation("UserAccountUpdater")
  created_resources resource[] @relation("ResourceCreator")
  updated_resources resource[] @relation("ResourceUpdater")
  created_bookings  booking[] @relation("BookingCreator")
  updated_bookings  booking[] @relation("BookingUpdater")
  created_shift_templates  shift_template[] @relation("ShiftTemplateCreator")
  updated_shift_templates  shift_template[] @relation("ShiftTemplateUpdater")
  created_shifts  shift[] @relation("ShiftCreator")
  updated_shifts  shift[] @relation("ShiftUpdater")
  created_products  product[] @relation("ProductCreator")
  updated_products  product[] @relation("ProductUpdater")
  created_inventories  inventory[] @relation("InventoryCreator")
  updated_inventories  inventory[] @relation("InventoryUpdater")
  created_purchase_orders  purchase_order[] @relation("PurchaseOrderCreator")
  updated_purchase_orders  purchase_order[] @relation("PurchaseOrderUpdater")
  created_db_table_comments  db_table_comment[] @relation("DbTableCommentCreator")
  leave_requests  leave_request[] @relation("LeaveRequestUser")
  created_leave_requests  leave_request[] @relation("LeaveRequestCreator")
  updated_leave_requests  leave_request[] @relation("LeaveRequestUpdater")
  created_approval_flows  approval_flow[] @relation("ApprovalFlowCreator")
  updated_approval_flows  approval_flow[] @relation("ApprovalFlowUpdater")
  @@index([api_key])
}

model role {
  id       String  @id @default(cuid())
  name     String
  description String?
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user_account @relation("RoleCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user_account @relation("RoleUpdater", fields: [updater_id], references: [id])
  user_accounts user_account[] @relation("UserRoles")
  permissions permission[]
  requestor_approval_flows approval_flow[] @relation("ApprovalFlowRequestorRole")
  approver_approval_flows  approval_flow[] @relation("ApprovalFlowApproverRole")
}

model organization {
  id       String  @id @default(cuid())
  name     String
  description String?
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user_account @relation("OrganizationCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user_account @relation("OrganizationUpdater", fields: [updater_id], references: [id])
  user_accounts user_account[] @relation("UserOrganizations")
  parent1s parent1[]
  resources resource[]
}

model permission {
  id       String @id @default(cuid())
  name     String
  role_id  String?
  role     role? @relation(fields: [role_id], references: [id], onDelete: Cascade)
  create   Boolean
  read     Boolean
  update   Boolean
  delete   Boolean
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user_account @relation("PermissionCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user_account @relation("PermissionUpdater", fields: [updater_id], references: [id])
  @@unique([name, role_id])
}

model procedure {
  id           String @id @default(cuid())
  name         String
  description  String?
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user_account @relation("ProcedureCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user_account @relation("ProcedureUpdater", fields: [updater_id], references: [id])
  assignee_id  String?
  assignee     user_account? @relation("ProcedureAssignee", fields: [assignee_id], references: [id])
  parent_id     String?
  parent       procedure? @relation("ParentChild", fields: [parent_id], references: [id])
  children     procedure[] @relation("ParentChild")
  preceded_by  procedure[] @relation("BeforeAfter")
  followed_by  procedure[] @relation("BeforeAfter")
}

model resource {
  id           String @id @default(cuid())
  name         String
  description  String?
  organization_id String
  organization organization @relation(fields: [organization_id], references: [id])
  resource_attachments  resource_attachment[]
  resource_images  resource_image[]
  bookings     booking[]
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user_account @relation("ResourceCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user_account @relation("ResourceUpdater", fields: [updater_id], references: [id])
}

model resource_attachment {
  id           String @id @default(cuid())
  order        Int @default(0)
  name         String
  path         String
  resource_id  String
  resource     resource @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
}

model resource_image {
  id           String @id @default(cuid())
  name         String
  path         String
  resource_id  String
  resource     resource @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
}

model booking {
  id           String @id @default(cuid())
  name         String
  resource_id  String
  resource     resource @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  start_time   DateTime @db.Timestamptz(0)
  end_time     DateTime @db.Timestamptz(0)
  created_at  DateTime @default(now()) @db.Timestamptz(0)
  updated_at  DateTime @updatedAt @db.Timestamptz(0)
  creator_id   String
  creator      user_account @relation("BookingCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user_account @relation("BookingUpdater", fields: [updater_id], references: [id])
}

model shift_template {
  id          String @id @default(cuid())
  user_account_id     String
  user_account        user_account @relation("ShiftTemplateUser", fields: [user_account_id], references: [id])
  day_of_week Int
  start_time  DateTime @db.Timetz(0)
  end_time    DateTime @db.Timetz(0)
  created_at  DateTime @default(now()) @db.Timestamptz(0)
  updated_at  DateTime @updatedAt @db.Timestamptz(0)
  creator_id  String
  creator     user_account @relation("ShiftTemplateCreator", fields: [creator_id], references: [id])
  updater_id  String
  updater     user_account @relation("ShiftTemplateUpdater", fields: [updater_id], references: [id])
}

model shift {
  id          String @id @default(cuid())
  user_account_id     String
  user_account        user_account @relation("ShiftUser", fields: [user_account_id], references: [id])
  start_time  DateTime @db.Timestamptz(0)
  end_time    DateTime @db.Timestamptz(0)
  status      Int
  created_at  DateTime @default(now()) @db.Timestamptz(0)
  updated_at  DateTime @updatedAt @db.Timestamptz(0)
  creator_id  String
  creator     user_account @relation("ShiftCreator", fields: [creator_id], references: [id])
  updater_id  String
  updater     user_account @relation("ShiftUpdater", fields: [updater_id], references: [id])
}

model product {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  price       Int
  barcode     String?
  images      product_image[]
  inventories  inventory[]
  purchase_per_items purchase_per_item[]
  created_at  DateTime @default(now()) @db.Timestamptz(0)
  updated_at  DateTime @updatedAt @db.Timestamptz(0)
  creator_id  String
  creator     user_account @relation("ProductCreator", fields: [creator_id], references: [id])
  updater_id  String
  updater     user_account @relation("ProductUpdater", fields: [updater_id], references: [id])
}

model product_image {
  id           String @id @default(cuid())
  name         String
  path         String
  product_id   String
  product      product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now()) @db.Timestamptz(0)
  updated_at  DateTime @updatedAt @db.Timestamptz(0)
}

model inventory {
  id          String @id @default(cuid())
  product_id  String
  product     product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  quantity    Int
  reserved_quantity    Int
  location    String?
  lot_number  String?
  expiration_date DateTime?
  created_at  DateTime @default(now()) @db.Timestamptz(0)
  updated_at  DateTime @updatedAt @db.Timestamptz(0)
  creator_id  String
  creator     user_account @relation("InventoryCreator", fields: [creator_id], references: [id])
  updater_id  String
  updater     user_account @relation("InventoryUpdater", fields: [updater_id], references: [id])
}

model purchase_order {
  id          String @id @default(cuid())
  order_no    String
  customer_id String
  customer    user_account @relation("Buyer", fields: [customer_id], references: [id])
  items       purchase_per_item[]
  created_at  DateTime @default(now()) @db.Timestamptz(0)
  updated_at  DateTime @updatedAt @db.Timestamptz(0)
  creator_id  String
  creator     user_account @relation("PurchaseOrderCreator", fields: [creator_id], references: [id])
  updater_id  String
  updater     user_account @relation("PurchaseOrderUpdater", fields: [updater_id], references: [id])
}

model purchase_per_item {
  id          String @id @default(cuid())
  purchase_order_id String
  purchase_order    purchase_order @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  product_id  String
  product     product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  quantity    Int
  price       Int?
  created_at  DateTime @default(now()) @db.Timestamptz(0)
  updated_at  DateTime @updatedAt @db.Timestamptz(0)
}

model leave_request {
  id              String   @id @default(cuid())
  user_account_id String
  user_account    user_account @relation("LeaveRequestUser", fields: [user_account_id], references: [id])
  start_date      DateTime @db.Timestamptz(0)
  end_date        DateTime @db.Timestamptz(0)
  reason          String
  approvable_id   String   @unique
  approvable      approvable @relation(fields: [approvable_id], references: [id])
  created_at      DateTime @default(now()) @db.Timestamptz(0)
  updated_at      DateTime @updatedAt @db.Timestamptz(0)
  creator_id      String
  creator         user_account @relation("LeaveRequestCreator", fields: [creator_id], references: [id])
  updater_id      String
  updater         user_account @relation("LeaveRequestUpdater", fields: [updater_id], references: [id])
}

model approvable {
  id               String   @id @default(cuid())
  approval_requests approval_request[]
  leave_request    leave_request?
}

model approval_flow {
  id               String   @id @default(cuid())
  entity_name      String
  requestor_role_id String?
  requestor_role   role?    @relation("ApprovalFlowRequestorRole", fields: [requestor_role_id], references: [id])
  approver_role_id String
  approver_role    role     @relation("ApprovalFlowApproverRole", fields: [approver_role_id], references: [id])
  approval_requests approval_request[]
  preceded_by      approval_flow[] @relation("ApprovalFlowOrder")
  followed_by      approval_flow[] @relation("ApprovalFlowOrder")
  created_at       DateTime @default(now()) @db.Timestamptz(0)
  updated_at       DateTime @updatedAt @db.Timestamptz(0)
  creator_id       String
  creator          user_account @relation("ApprovalFlowCreator", fields: [creator_id], references: [id])
  updater_id       String
  updater          user_account @relation("ApprovalFlowUpdater", fields: [updater_id], references: [id])
}

model approval_request {
  id               String   @id @default(cuid())
  approvable_id    String
  approvable       approvable @relation(fields: [approvable_id], references: [id], onDelete: Cascade)
  approval_flow_id String
  approval_flow    approval_flow @relation(fields: [approval_flow_id], references: [id])
  status           Int      @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz(0)
  updated_at       DateTime @updatedAt @db.Timestamptz(0)
}