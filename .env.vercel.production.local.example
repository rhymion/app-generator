# Vercel deployment configuration for consumer apps generated from this repo
# (app-generator) — used by scripts/vercel-env.sh / vercel-setup.sh /
# vercel-deploy.sh / vercel-teardown.sh.
# Canonical copy — consumer repos reference this file via their app-generator
# submodule (as .env.production.local.example at their own repo root) rather
# than keeping their own duplicate (cmd_711).
# Copy this file to .env.production.local and fill in the actual values.
# Never commit .env.production.local (it is gitignored via .env* in .gitignore).

# ── Vercel project / auth ─────────────────────────────────
# Personal token from vercel.com/account/tokens.
# Used as an env var only — never pass via --token (would leak in process list).
VERCEL_TOKEN=
VERCEL_ORG_ID=team_dV6bZ5phXWZj0nuGdtinMzJQ
VERCEL_PROJECT_NAME=app-generator-sample
# Optional: Vercel project Root Directory (Vercel Projects API field, no
# vercel.json equivalent — see vercel-setup.sh Step 1.5). Defaults to
# "app-generator" if unset.
VERCEL_ROOT_DIRECTORY=app-generator

# ── Prisma Postgres (superseded by cmd_292 — Neon replaces Prisma Postgres) ──
# PRISMA_DATABASE_URL_PROD / PRISMA_DATABASE_URL_STAGING removed. See the Neon
# section below for the replacement variables (DATABASE_URL_PROD/STAGING).

# ── Neon Postgres — two-DB pattern (prod + shared staging), cmd_292 ──
# prod = Neon project "main" branch, staging = "staging" branch (branch-separated,
# see docs/vercel-automation-design.md §6/§7). Pooled endpoint is injected to Vercel
# as DATABASE_URL; unpooled endpoint is injected to Vercel as DIRECT_URL (cmd_657)
# and is also used directly for the one-time `migrate:deploy` calls in vercel-setup.sh.
# Issued via Neon API (https://api-docs.neon.tech) — see docs/vercel-automation-design.md §13.
DATABASE_URL_PROD=
DATABASE_URL_STAGING=
DATABASE_URL_UNPOOLED_PROD=
DATABASE_URL_UNPOOLED_STAGING=
# Neon API token, used by vercel-setup.sh Step A (get-or-create).
NEON_API_KEY=
NEON_PROJECT_NAME=app-generator-sample
# Written by vercel-setup.sh after first provisioning; idempotency anchor for get-or-create.
NEON_PROJECT_ID=

# ── Auth.js ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# generate-once-persist: auto-generated on first run and written back to .env.production.local — keep fixed thereafter
# Changing this invalidates all user sessions — must remain constant across deployments
AUTH_SECRET=
# Do not set AUTH_URL (use AUTH_TRUST_HOST=true instead)

# ── Upstash Redis (rate-limit, shared with GCP) ─────────────
# rediss:// URL issued via Upstash Console (https://console.upstash.com)
REDIS_URL=
# Provisioning identifiers for vercel-setup.sh Step B (get-or-create), shared with
# the same Upstash instance used by gcp-setup.sh. Not injected to Vercel at runtime.
UPSTASH_EMAIL=
UPSTASH_API_KEY=
UPSTASH_PRIMARY_REGION=ap-northeast-1

# ── Google OAuth (optional) ─────────────────────────────────
# Only required if siteConfig enables the Google provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Vercel Blob (uploads — PD-3 app code migration still pending) ──
# Auto-provisioned by vercel-setup.sh Step C (`vercel blob create-store`, see
# docs/vercel-automation-design.md §15). PD-4 "cannot automate" superseded by cmd_292.
BLOB_READ_WRITE_TOKEN=
# Written by vercel-setup.sh after Blob store creation; idempotency anchor for get-or-create.
VERCEL_BLOB_STORE_ID=

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123
