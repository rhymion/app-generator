# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# testing
/coverage
/cypress/videos
/cypress/screenshots

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# Committed: common baseline and environment-specific non-secrets
!.env
!.env.development
!.env.test
!.env.example
# .env.local, .env.*.local, .env.production remain ignored

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# database
/prisma/dev.db
/prisma/dev.db-journal
/prisma/test.db
/prisma/test.db-journal
/prisma/bridge_additions.prisma
*.db
*.db-journal
/prisma/schema.postgres.backup
# Uploaded files
/public/uploads/

# non-technical docs
/docs/slides

# python
__pycache__/
*.pyc
.venv/

# code generator manifest — regenerated on every `generate-code`; cleanup reads
# it but it churns with generated content, so it's kept out of version control.
.generated-manifest.json

# sample data
custom/
memory/
*.log*

# ==========================================
# BEGIN GENERATED FILES — entity-name-independent
# structural patterns + fixed exceptions
# ==========================================

