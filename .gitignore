!lib/setting/password-actions.ts
!lib/audit_log/getters.ts
!lib/audit_log/types.ts
!lib/audit_log/virtual_resolvers.ts

# ── app/[locale]/ ──
app/\[locale\]/*/
!app/\[locale\]/@footer/
!app/\[locale\]/@footer/**
!app/\[locale\]/@header/
!app/\[locale\]/@header/**
!app/\[locale\]/@sidebar/
!app/\[locale\]/@sidebar/**
!app/\[locale\]/_hide/
!app/\[locale\]/_hide/**
!app/\[locale\]/login/
!app/\[locale\]/login/**
!app/\[locale\]/register/
!app/\[locale\]/register/**
!app/\[locale\]/setting/
!app/\[locale\]/setting/**
app/\[locale\]/setting/edit/
app/\[locale\]/setting/view/
!app/\[locale\]/extra/
