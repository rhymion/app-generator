# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/cypress/videos
/cypress/screenshots

# e2e test-harness sentinel for the mock Google OAuth provider (cmd_528) —
# written only by scripts/write-mock-oauth-sentinel.js, never committed.
# See auth.ts's isMockGoogleOAuthTestEnabled().
.mock-oauth-test-sentinel

# Claude Code: personal, machine-specific permission overrides (defaultMode,
# extra allow/deny rules). Never shared — see docs/knowledge/claude-code-settings-consumer-side.md
.claude/settings.local.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# Committed: common baseline and environment-specific non-secrets
!.env
!.env.development
!.env.test
!.env.example
# .env.local, .env.*.local, .env.production remain ignored

# GCP production secrets
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/

# database
/prisma/dev.db
/prisma/dev.db-journal
/prisma/test.db
/prisma/test.db-journal
/prisma/bridge_additions.prisma
*.db
*.db-journal
/prisma/schema.postgres.backup
# Prisma migrations: derived from the generated schema.prisma, so they are build
# artifacts (developer-prepared per build/deploy) rather than tracked source. They
# still reach the Docker build context (.dockerignore does not exclude them) and are
# applied by the app-migrate Job via `prisma migrate deploy`.
/prisma/migrations/
# Uploaded files
/public/uploads/

# non-technical docs
/docs/slides

# python
__pycache__/
*.pyc
.venv/

# code generator manifest — regenerated on every `generate-code`; cleanup reads
# it but it churns with generated content, so it's kept out of version control.
.generated-manifest.json

# intermediate schema (cmd_395 Stage 1) — build_user_schema.py output, rebuilt
# from user_schema.yaml + prisma/schema.prisma on every build. Never hand-edited,
# so it's a build artifact like the rest of the generated code, not a source file.
code_generator/.generated/

# mention-gate fixture check (cmd_535) scratch output — scripts/check_mention_gate_fixture.sh
# regenerates this from code_generator/tests/fixtures/mention_gate/ on every run.
.generated-mention-gate/

# decimal-gate fixture check (cmd_705) scratch output — scripts/check_decimal_gate_fixture.sh
# regenerates this from code_generator/tests/fixtures/decimal_gate/ on every run.
.generated-decimal-gate/

# sample data
custom/
memory/
*.log*

