app/\[locale\]/docs/page.mdx
app/\[locale\]/docs/*/

# ── app/api/ ──
app/api/*/
!app/api/auth/
!app/api/auth/**
!app/api/notifications/
!app/api/notifications/**
!app/api/test-utils/
!app/api/test-utils/**
!app/api/upload/
!app/api/upload/**
!app/api/uploads/
!app/api/uploads/**
!app/api/approval_request/
!app/api/approval_request/**
app/api/approval_request/route.ts
app/api/approval_request/\[id\]/route.ts
app/api/approval_request/bulk/route.ts

# ── components/ ──
components/*/*
