# Database Configuration
# DATABASE_URL: Direct database connection (used for development, migrations, and testing)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# PRISMA_DATABASE_URL: Prisma Accelerate URL (only used in production)
# Leave empty for local development (will use direct connection instead)
PRISMA_DATABASE_URL=""

# For unit testing (SQLite - optional)
DATABASE_URL_SQLITE="file:./test.db"

# NextAuth
# Note: AUTH_SECRET also drives attachment filename encryption (P2-5, lib/compliance/attachment_name_crypto.ts)
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Rate-limit backing store (lib/rate-limit). When set, the proxy's auth-
# endpoint rate limiter shares state across replicas via Redis. Unset to
# fall back to an in-process limiter (single-instance dev / unit tests).
#   - Local Docker:  redis://localhost:6379
#   - Upstash TCP:   rediss://default:<password>@<endpoint>:<port>
#   - Other managed: redis[s]://<user>:<password>@<host>:<port>
REDIS_URL=""

# Node Environment
NODE_ENV="development"

# CORS for mobile API access (middleware.ts). Safe as * because mobile uses
# Bearer-only auth, not cookies. Override with a specific origin in production.
MOBILE_CORS_ORIGIN=*
