# Database Configuration
# DATABASE_URL: Direct database connection (used for development, migrations, and testing)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# PRISMA_DATABASE_URL: Prisma Accelerate URL (only used in production)
# Leave empty for local development (will use direct connection instead)
PRISMA_DATABASE_URL=""

# DIRECT_URL: unpooled connection used only for migrations (prisma.config.ts).
# Needed on platforms where DATABASE_URL is a pooled connection (e.g. Vercel +
# Neon's PgBouncer endpoint) — required there, config loading fails without it.
# Leave empty for local dev/CI/GCP, where DATABASE_URL is already a direct
# connection with no pooler in front of it.
# See docs/knowledge/prisma-direct-vs-pooled-connection.md
DIRECT_URL=""

# USE_NEON_ADAPTER: set to the literal string "true" to make lib/prisma.ts use
# the Neon serverless driver adapter (@prisma/adapter-neon) instead of the
# default PrismaPg adapter. Vercel + Neon only — set this on the Vercel
# project's Production and/or Preview environment (Project Settings →
# Environment Variables), never in this file or committed anywhere. Any other
# value, including "false" or "0", is treated as unset/disabled. Leave unset
# for local dev/CI/GCP Cloud Run — they must keep using PrismaPg.
USE_NEON_ADAPTER=""

# For unit testing (SQLite - optional)
DATABASE_URL_SQLITE="file:./test.db"

# NextAuth
# Note: AUTH_SECRET also drives attachment filename encryption (P2-5, lib/compliance/attachment_name_crypto.ts)
# and the MFA secret encryption. Rotating it: docs/knowledge/authentication.md "Rotating AUTH_SECRET".
AUTH_SECRET="your-secret-here"
# The old AUTH_SECRET while rotating (optional): values encrypted under it still decrypt, and
# `npm run secrets:reencrypt` moves them to the new one. Remove it when rotation is complete.
# AUTH_SECRET_PREVIOUS=""
# bcrypt cost for password hashes, an integer from 10 (default) to 15. A sign-in rehashes a
# password stored at another cost (docs/knowledge/authentication.md "Password hashing cost").
# BCRYPT_COST=10
NEXTAUTH_URL="http://localhost:3000"

# Web session lifetime (lib/session-policy.ts). Both optional; the values below are the defaults.
# SESSION_MAX_AGE_SECONDS: inactivity lifetime, the cookie expires this long after its last refresh.
# SESSION_UPDATE_AGE_SECONDS: how often an active session refreshes the cookie (capped at the max age).
# SESSION_ABSOLUTE_MAX_AGE_SECONDS: optional upper bound on a session counted from sign-in, however active the user is.
#   Unset (the default) means no absolute limit. Setting it signs out every session issued before the setting existed, once.
# SESSION_MAX_AGE_SECONDS=2592000
# SESSION_UPDATE_AGE_SECONDS=86400
# SESSION_ABSOLUTE_MAX_AGE_SECONDS=43200

# Required MFA enrolment (Issue #1281, lib/auth/mfa-required.ts). Unset or empty: MFA stays opt-in (the default).
# "*" requires every user; otherwise a comma-separated list of role names (role.name, exact match).
# A required user who has not enrolled can sign in but can only use /setting/mfa until enrolment completes.
# MFA_REQUIRED_ROLES=Admin

# Domain allow-lists (lib/site-config.ts, docs/knowledge/authentication.md). Comma-separated domains, matched
# case-insensitively, no subdomain wildcard. Unset or empty keeps the list written in lib/site-config.ts (empty = allow all).
# Read at server start: a change needs a restart / redeploy, not a rebuild.
# AUTH_ALLOWED_DOMAINS: OAuth (Google) sign-in, matched on Google's `hd` claim.
# REGISTRATION_ALLOWED_DOMAINS: self-registration (/register), matched on the email address's domain.
# AUTH_ALLOWED_DOMAINS=example.com
# REGISTRATION_ALLOWED_DOMAINS=example.com,example.co.jp

# Password policy (lib/auth/password-policy.ts, docs/knowledge/authentication.md "Password strength"). All optional.
# PASSWORD_DENYLIST_FILE: a file of refused passwords, one per line (# comments), added to the built-in common list.
# PASSWORD_CONTEXT_WORDS: comma-separated words a password must not contain (company or product names).
# PASSWORD_BREACH_CHECK=hibp: refuse passwords found in Have I Been Pwned (k-anonymity range query to
#   api.pwnedpasswords.com; only 5 hex characters of the SHA-1 are sent; skipped if unreachable within 3 s).
# PASSWORD_BREACH_CHECK_URL: a mirror of the range API (default https://api.pwnedpasswords.com/range/).
# PASSWORD_DENYLIST_FILE=/etc/app/password-denylist.txt
# PASSWORD_CONTEXT_WORDS=acme,acmecorp
# PASSWORD_BREACH_CHECK=hibp

# Extra host names the app is served under, besides NEXTAUTH_URL and the Vercel
# deployment hosts (comma-separated, no scheme). proxy.ts believes the
# forwarded host and protocol headers only for these hosts
# (lib/auth/external-url.ts); any other host redirects to NEXTAUTH_URL.
# AUTH_ALLOWED_HOSTS=alias.example.com

# The Auth.js cookies (session, callback-url, PKCE, state, nonce) are named __Host-authjs.* when
# AUTH_URL / NEXTAUTH_URL is https (lib/auth/cookie-policy.ts). Set to false only when a deployment has to
# share these cookies across hosts; the Auth.js __Secure- names are used then.
# AUTH_COOKIE_HOST_PREFIX=false

# Trusted proxy hops in front of the app, for the client address used as the
# rate-limit key (lib/rate-limit/client-ip.ts). Default 1. Set 2 when an extra
# trusted proxy sits in front of the platform edge.
# TRUSTED_PROXY_HOPS=1

# Rate-limit backing store (lib/rate-limit). When set, the proxy's auth-
# endpoint rate limiter shares state across replicas via Redis. Unset to
# fall back to an in-process limiter (single-instance dev / unit tests).
#   - Local Docker:  redis://localhost:6379
#   - Upstash TCP:   rediss://default:<password>@<endpoint>:<port>
#   - Other managed: redis[s]://<user>:<password>@<host>:<port>
REDIS_URL=""

# Mail (lib/mail.ts). Needed in production only when
# x-generator.email-verification.enabled is set in code_generator/json_schema.yaml
# (self-registration mails a sign-up link). See docs/knowledge/authentication.md.
#   SMTP_URL: smtp://user:password@host:587 or smtps://user:password@host:465
#   MAIL_FROM: sender, e.g. "My App <no-reply@example.com>"
#   MAIL_OUTBOX_DIR: outside production, with no SMTP_URL, each message is written
#     as a JSON file here instead (default .mail-outbox/). Ignored in production.
SMTP_URL=""
MAIL_FROM=""
MAIL_OUTBOX_DIR=""

# Stripe Payment (required if x-payment is declared in code_generator/json_schema.yaml)
# See docs/knowledge/stripe-payment-integration.md
STRIPE_SECRET_KEY=      # Server-side only — never expose to client. Test key: sk_test_...
STRIPE_PUBLISHABLE_KEY= # Client-safe — used to redirect to Checkout. Test key: pk_test_...
STRIPE_WEBHOOK_SECRET=  # Endpoint-specific. Local dev: install the Stripe CLI separately (not the `stripe` SDK in package.json) and run
                        #   stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired --forward-to localhost:<port>/api/webhooks/stripe
                        # (all four events are needed; the last one removes an unpaid record), then copy the whsec_... it prints here.
                        # Under NODE_ENV=test put the three keys in the gitignored .env.test.local, not .env.local.

# CRON_SECRET (optional; used if any entity declares x-scheduled-task in
# code_generator/json_schema.yaml). Secures app/api/scheduled-tasks/[task]/
# route.ts against unauthenticated triggering. Vercel automatically sends
# `Authorization: Bearer $CRON_SECRET` on every Cron Job invocation once this
# var is set on the Vercel project — Vercel does NOT generate or set it for
# you (scripts/vercel-env.sh generates and injects one, mirroring
# AUTH_SECRET). Leave empty to fall back to the route's existing dual-auth
# (X-API-Key or session cookie) instead. See
# docs/knowledge/scheduled-task-operations.md.
CRON_SECRET=""

# CSV import limits (app/api/{entity}/import/route.ts, generated from
# code_generator/templates/api_import_route.ts.jinja2). Optional — each
# falls back to the default shown below when unset. Note the word order is
# reversed from the generated code's constant names (MAX_IMPORT_ROWS /
# MAX_IMPORT_BYTES) — that mismatch is intentional and documented at the
# constant declarations; the env var names below are the ones that matter.
IMPORT_MAX_ROWS=5000
IMPORT_MAX_BYTES=10485760 # 10MB

# Upload type allow-lists for POST /api/upload. Optional — comma-separated; a
# file is accepted only when its declared MIME type is on the MIME list AND its
# file extension is on the extension list. Unset or blank = the default shown.
# For a locked-down deployment use images + PDF only, e.g.
#   UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
#   UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf
# UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/jpg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,text/plain,application/zip
# UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf,doc,docx,xls,xlsx,csv,txt,zip

# Node Environment
NODE_ENV="development"

# How often NotificationBell.tsx polls GET /api/notifications (ms). Also
# refetched on mount, on bell open, and on window focus/visibilitychange, so
# this interval is just the backstop between those triggers. NEXT_PUBLIC_ is
# required because it's read in client-side code.
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL_MS=180000

# App branding (lib/site-config.ts). Both are optional — each falls back to a
# generic default when unset. NEXT_PUBLIC_ vars are inlined into the client
# bundle at build time: changing either on Vercel requires a rebuild, not
# just a redeploy or an env var edit.
NEXT_PUBLIC_APP_TITLE=""
NEXT_PUBLIC_APP_COPYRIGHT=""

# SWAGGER_UI_ENABLED: set to the literal string "true" to enable the
# interactive Swagger UI page at /swagger (login required; not listed as a
# public path in proxy.ts). Any other value, including "false" or "0", is
# treated as unset/disabled — unset makes the page 404 rather than show a
# disabled state. Development/staging use only: every API call the page's
# "Try it out" makes runs with the caller's own role permissions, with no
# scope restriction, so enabling this against a production database lets
# Swagger UI write/delete real data. Never set on Vercel's Production
# environment; never wired into vercel-setup.sh/vercel-env.sh for that
# reason — see docs/knowledge/generated-documentation-and-openapi-spec.md
# for the manual steps to enable it on Preview only.
SWAGGER_UI_ENABLED=""

# Content Security Policy (report-only). Space- or comma-separated origins added to the policy that
# proxy.ts sends; see docs/knowledge/content-security-policy.md.
# CSP_EXTRA_SCRIPT_SRC=https://js.example.com           # added to script-src
# CSP_EXTRA_STORAGE_SRC=https://storage.googleapis.com  # added to img-src, media-src and connect-src
