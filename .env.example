# Database Configuration
# DATABASE_URL: Direct database connection (used for development, migrations, and testing)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# PRISMA_DATABASE_URL: Prisma Accelerate URL (only used in production)
# Leave empty for local development (will use direct connection instead)
PRISMA_DATABASE_URL=""

# DIRECT_URL: unpooled connection used only for migrations (prisma.config.ts).
# Needed on platforms where DATABASE_URL is a pooled connection (e.g. Vercel +
# Neon's PgBouncer endpoint) — required there, config loading fails without it.
# Leave empty for local dev/CI/GCP, where DATABASE_URL is already a direct
# connection with no pooler in front of it.
# See docs/knowledge/prisma-direct-vs-pooled-connection.md
DIRECT_URL=""

# USE_NEON_ADAPTER: set to the literal string "true" to make lib/prisma.ts use
# the Neon serverless driver adapter (@prisma/adapter-neon) instead of the
# default PrismaPg adapter. Vercel + Neon only — set this on the Vercel
# project's Production and/or Preview environment (Project Settings →
# Environment Variables), never in this file or committed anywhere. Any other
# value, including "false" or "0", is treated as unset/disabled. Leave unset
# for local dev/CI/GCP Cloud Run — they must keep using PrismaPg.
USE_NEON_ADAPTER=""

# For unit testing (SQLite - optional)
DATABASE_URL_SQLITE="file:./test.db"

# NextAuth
# Note: AUTH_SECRET also drives attachment filename encryption (P2-5, lib/compliance/attachment_name_crypto.ts)
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Rate-limit backing store (lib/rate-limit). When set, the proxy's auth-
# endpoint rate limiter shares state across replicas via Redis. Unset to
# fall back to an in-process limiter (single-instance dev / unit tests).
#   - Local Docker:  redis://localhost:6379
#   - Upstash TCP:   rediss://default:<password>@<endpoint>:<port>
#   - Other managed: redis[s]://<user>:<password>@<host>:<port>
REDIS_URL=""

# Stripe Payment (required if x-payment is declared in code_generator/json_schema.yaml)
# See docs/knowledge/stripe-payment-integration.md
STRIPE_SECRET_KEY=      # Server-side only — never expose to client. Test key: sk_test_...
STRIPE_PUBLISHABLE_KEY= # Client-safe — used to redirect to Checkout. Test key: pk_test_...
STRIPE_WEBHOOK_SECRET=  # Endpoint-specific — generate with: stripe listen

# Node Environment
NODE_ENV="development"

# How often NotificationBell.tsx polls GET /api/notifications (ms). Also
# refetched on mount, on bell open, and on window focus/visibilitychange, so
# this interval is just the backstop between those triggers. NEXT_PUBLIC_ is
# required because it's read in client-side code.
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL_MS=180000
