{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/lib/uri_kind_gate_item/*": ["./lib/uri_kind_gate_item/*"],
      "@/components/uri_kind_gate_item/*": ["./components/uri_kind_gate_item/*"],
      "@/lib/uri_kind_gate_wrapper/*": ["./lib/uri_kind_gate_wrapper/*"],
      "@/components/uri_kind_gate_wrapper/*": ["./components/uri_kind_gate_wrapper/*"],
      "@/app/uri_kind_gate_wrapper/*": ["./app/uri_kind_gate_wrapper/*"],
      "@/lib/prisma": ["./lib/prisma.ts"],
      "@/lib/authz": ["./lib/authz.ts"],
      "@/lib/api-auth": ["./lib/api-auth.ts"],
      "@/app/generated/prisma/client": ["./prisma/.generated-client/client"],
      "@/*": ["../*"]
    }
  },
  "include": [
    "components/uri_kind_gate_wrapper/column_def.tsx",
    "app/uri_kind_gate_wrapper/page.tsx",
    "lib/uri_kind_gate_wrapper/getters.ts"
  ],
  "exclude": ["node_modules"]
}
