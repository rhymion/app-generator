// Fixture models for the version-of-e2e-gate (appended to a COPY of
// prisma/schema.prisma by scripts/check_version_of_e2e_gate_fixture.sh; the
// default schema is never edited). The back-fields the default `user` and
// `approvable` models need are listed in schema_relations.json.
//
// x-version-of reads these columns but does not create them: the identity's
// nullable current_version_id, the version's identity FK, a nullable number and
// the composite unique on (identity FK, number).

enum VoItemVersionStatus {
  draft
  pending
  approved
  rejected
}

model vo_item {
  id                 String            @id @default(cuid())
  name               String            @unique
  current_version_id String?           @unique
  current_version    vo_item_version?  @relation("VoItemCurrent", fields: [current_version_id], references: [id], onDelete: SetNull)
  versions           vo_item_version[] @relation("VoItemVersions")
  created_at         DateTime          @default(now()) @db.Timestamptz(0)
  updated_at         DateTime          @updatedAt @db.Timestamptz(0)
  creator_id         String
  creator            user              @relation("VoItemCreator", fields: [creator_id], references: [id])
  updater_id         String
  updater            user              @relation("VoItemUpdater", fields: [updater_id], references: [id])

  @@index([creator_id])
  @@index([updater_id])
}

model vo_item_version {
  id                   String                @id @default(cuid())
  vo_item_id           String
  vo_item              vo_item               @relation("VoItemVersions", fields: [vo_item_id], references: [id], onDelete: Cascade)
  current_of           vo_item?              @relation("VoItemCurrent")
  title                String
  version_no           Int?
  status               VoItemVersionStatus   @default(draft)
  approvable_id        String                @unique
  approvable           approvable            @relation(fields: [approvable_id], references: [id], onDelete: Cascade)
  vo_item_version_lines vo_item_version_line[]
  created_at           DateTime              @default(now()) @db.Timestamptz(0)
  updated_at           DateTime              @updatedAt @db.Timestamptz(0)
  creator_id           String
  creator              user                  @relation("VoItemVersionCreator", fields: [creator_id], references: [id])
  updater_id           String
  updater              user                  @relation("VoItemVersionUpdater", fields: [updater_id], references: [id])

  @@unique([vo_item_id, version_no])
  @@index([vo_item_id])
  @@index([title])
  @@index([creator_id])
  @@index([updater_id])
}

model vo_item_version_line {
  id                 String          @id @default(cuid())
  vo_item_version_id String
  vo_item_version    vo_item_version @relation(fields: [vo_item_version_id], references: [id], onDelete: Cascade)
  note               String
  created_at         DateTime        @default(now()) @db.Timestamptz(0)
  updated_at         DateTime        @updatedAt @db.Timestamptz(0)

  @@index([vo_item_version_id])
}
