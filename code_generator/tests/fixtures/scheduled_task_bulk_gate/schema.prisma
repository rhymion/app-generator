// Self-contained fixture Prisma schema for the bulk x-scheduled-tasks check
// (cmd_790). NOT the project's real prisma/schema.prisma -- this file
// exists only to run a top-level `x-scheduled-tasks` bulk declaration
// alongside an entity-level `x-scheduled-task` (on `widget`) through the
// real build_user_schema.py -> generate.py pipeline in isolation, proving
// the bulk mechanism actually fires end-to-end and coexists with the
// existing row-scan mechanism.
//
// Modeled on code_generator/tests/fixtures/payment_gate/schema.prisma's
// self-contained-fixture pattern.

generator client {
  provider = "prisma-client"
  output   = "./.generated-client"
}

datasource db {
  provider = "postgresql"
}

model user {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  created_widgets widget[]  @relation("WidgetCreator")
  updated_widgets widget[]  @relation("WidgetUpdater")
}

// x-scheduled-task: widget_timeout -- entity-level, filter-required row scan.
model widget {
  id         String   @id @default(cuid())
  name       String
  status     String
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("WidgetCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("WidgetUpdater", fields: [updater_id], references: [id])
  @@index([creator_id])
  @@index([updater_id])
}
