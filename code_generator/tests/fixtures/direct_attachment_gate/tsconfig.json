{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/lib/direct_attachment_gate_item/*": ["./lib/direct_attachment_gate_item/*"],
      "@/components/direct_attachment_gate_item/*": ["./components/direct_attachment_gate_item/*"],
      "@/lib/attachment/direct_actions": ["./lib/attachment/direct_actions.ts"],
      "@/lib/prisma": ["./lib/prisma.ts"],
      "@/lib/authz": ["./lib/authz.ts"],
      "@/app/generated/prisma/client": ["./prisma/.generated-client/client"],
      "@/*": ["../*"]
    }
  },
  "include": [
    "app/[locale]/direct_attachment_gate_item/new/page.tsx",
    "app/[locale]/direct_attachment_gate_item/edit/[id]/page.tsx",
    "app/[locale]/direct_attachment_gate_item/view/[id]/page.tsx",
    "lib/direct_attachment_gate_item/getters.ts"
  ],
  "exclude": ["node_modules"]
}
