// Self-contained fixture Prisma schema for the x-state-machines opt-in
// byte-identity gate (Issue #696 Stage 1 PR2a-4) -- NOT the project's real
// prisma/schema.prisma. Exists only to run a minimal `widget` entity (a
// real Prisma model with a `status` column that never opts into
// x-state-machines) through the real build_user_schema.py -> generate.py
// pipeline in isolation, to prove opt-out generation is unaffected by this
// feature. Modeled on
// code_generator/tests/fixtures/proxy_stub_gate/schema.prisma's
// self-contained-fixture pattern.

generator client {
  provider = "prisma-client"
  output   = "./.generated-client"
}

datasource db {
  provider = "postgresql"
}

model user {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  created_widgets widget[] @relation("WidgetCreator")
  updated_widgets widget[] @relation("WidgetUpdater")
}

model widget {
  id         String   @id @default(cuid())
  name       String
  status     String
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("WidgetCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("WidgetUpdater", fields: [updater_id], references: [id])
  @@index([creator_id])
  @@index([updater_id])
}
