// Fixture models for scripts/run_mobile_entity_playwright.sh (appended to a COPY of
// prisma/schema.prisma; the default schema is never edited). The relation back-fields the
// default `user` model needs are listed in schema_relations.json.

enum MobileNoteStatus {
  open
  closed
}

model mobile_note {
  id         String           @id @default(cuid())
  title      String
  details    String?
  status     MobileNoteStatus
  priority   Int?
  amount     Decimal?         @db.Decimal(10, 2)
  is_done    Boolean
  due_on     DateTime?
  created_at DateTime         @default(now()) @db.Timestamptz(0)
  updated_at DateTime         @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user             @relation("MobileNoteCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user             @relation("MobileNoteUpdater", fields: [updater_id], references: [id])
  @@index([title])
  @@index([status])
  @@index([priority])
  @@index([creator_id])
  @@index([updater_id])
}

model mobile_log {
  id         String   @id @default(cuid())
  message    String
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("MobileLogCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("MobileLogUpdater", fields: [updater_id], references: [id])
  @@index([message])
  @@index([creator_id])
  @@index([updater_id])
}

model mobile_group {
  id         String   @id @default(cuid())
  name       String
  mobile_tasks mobile_task[]
  mobile_shipments mobile_shipment[]
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("MobileGroupCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("MobileGroupUpdater", fields: [updater_id], references: [id])
  @@index([name])
  @@index([creator_id])
  @@index([updater_id])
}

model mobile_tag {
  id         String   @id @default(cuid())
  name       String
  mobile_tasks mobile_task[] @relation("MobileTaskTags")
  label_tasks  mobile_task[] @relation("MobileTaskLabel")
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("MobileTagCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("MobileTagUpdater", fields: [updater_id], references: [id])
  @@index([name])
  @@index([creator_id])
  @@index([updater_id])
}

model mobile_profile {
  id         String   @id @default(cuid())
  name       String
  mobile_task mobile_task?
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("MobileProfileCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("MobileProfileUpdater", fields: [updater_id], references: [id])
  @@index([name])
  @@index([creator_id])
  @@index([updater_id])
}

model mobile_task {
  id                String          @id @default(cuid())
  title             String
  mobile_group_id   String
  mobile_group      mobile_group    @relation(fields: [mobile_group_id], references: [id])
  mobile_profile_id String?         @unique
  mobile_profile    mobile_profile? @relation(fields: [mobile_profile_id], references: [id])
  mobile_label_id   String?
  mobile_label      mobile_tag?     @relation("MobileTaskLabel", fields: [mobile_label_id], references: [id])
  tags              mobile_tag[]    @relation("MobileTaskTags")
  created_at        DateTime        @default(now()) @db.Timestamptz(0)
  updated_at        DateTime        @updatedAt @db.Timestamptz(0)
  creator_id        String
  creator           user            @relation("MobileTaskCreator", fields: [creator_id], references: [id])
  updater_id        String
  updater           user            @relation("MobileTaskUpdater", fields: [updater_id], references: [id])
  @@index([title])
  @@index([mobile_group_id])
  @@index([mobile_label_id])
  @@index([creator_id])
  @@index([updater_id])
}

model mobile_org_item {
  id              String       @id @default(cuid())
  name            String
  organization_id String
  organization    organization @relation(fields: [organization_id], references: [id])
  created_at      DateTime     @default(now()) @db.Timestamptz(0)
  updated_at      DateTime     @updatedAt @db.Timestamptz(0)
  creator_id      String
  creator         user         @relation("MobileOrgItemCreator", fields: [creator_id], references: [id])
  updater_id      String
  updater         user         @relation("MobileOrgItemUpdater", fields: [updater_id], references: [id])
  @@index([name])
  @@index([organization_id])
  @@index([creator_id])
  @@index([updater_id])
}

enum MobileRequestStatus {
  draft
  submitted
  approved
  rejected
}

model mobile_request {
  id            String              @id @default(cuid())
  title         String
  status        MobileRequestStatus @default(draft)
  approvable_id String              @unique
  approvable    approvable          @relation(fields: [approvable_id], references: [id])
  created_at    DateTime            @default(now()) @db.Timestamptz(0)
  updated_at    DateTime            @updatedAt @db.Timestamptz(0)
  creator_id    String
  creator       user                @relation("MobileRequestCreator", fields: [creator_id], references: [id])
  updater_id    String
  updater       user                @relation("MobileRequestUpdater", fields: [updater_id], references: [id])
  @@index([title])
  @@index([status])
  @@index([creator_id])
  @@index([updater_id])
}

enum MobileShipmentStatus {
  draft
  pending
  approved
  rejected
  split
}

model mobile_shipment {
  id              String                @id @default(cuid())
  title           String
  quantity        Int
  status          MobileShipmentStatus  @default(draft)
  mobile_group_id String
  mobile_group    mobile_group          @relation(fields: [mobile_group_id], references: [id])
  approvable_id   String                @unique
  approvable      approvable            @relation(fields: [approvable_id], references: [id])
  created_at      DateTime              @default(now()) @db.Timestamptz(0)
  updated_at      DateTime              @updatedAt @db.Timestamptz(0)
  creator_id      String
  creator         user                  @relation("MobileShipmentCreator", fields: [creator_id], references: [id])
  updater_id      String
  updater         user                  @relation("MobileShipmentUpdater", fields: [updater_id], references: [id])
  @@index([title])
  @@index([quantity])
  @@index([status])
  @@index([mobile_group_id])
  @@index([creator_id])
  @@index([updater_id])
}
