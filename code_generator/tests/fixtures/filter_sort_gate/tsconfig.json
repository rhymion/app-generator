{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/lib/filter_sort_gate_item/*": ["./lib/filter_sort_gate_item/*"],
      "@/components/filter_sort_gate_item/*": ["./components/filter_sort_gate_item/*"],
      "@/lib/prisma": ["./lib/prisma.ts"],
      "@/lib/authz": ["./lib/authz.ts"],
      "@/lib/api-auth": ["./lib/api-auth.ts"],
      "@/lib/idempotency": ["./lib/idempotency.ts"],
      "@/app/generated/prisma/client": ["./prisma/.generated-client/client"],
      "@/*": ["../*"]
    }
  },
  "include": [
    "lib/filter_sort_gate_item/getters.ts",
    "lib/filter_sort_gate_item/service_validation.ts",
    "components/filter_sort_gate_item/form_validation.ts",
    "components/filter_sort_gate_item/FormUpsert.tsx"
  ],
  "exclude": ["node_modules"]
}
