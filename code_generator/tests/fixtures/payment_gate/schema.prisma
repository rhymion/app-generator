// Self-contained fixture Prisma schema for the payment-gate check.
// NOT the project's
// real prisma/schema.prisma -- this file exists only to run a minimal
// `paid_widget` (x-payment: true) and `plain_widget` (no x-payment) pair
// of standalone entities through the real build_user_schema.py ->
// generate.py pipeline in isolation, proving the x-payment write-once stub
// mechanism actually fires end-to-end.
//
// Modeled on code_generator/tests/fixtures/invalidate_gate/schema.prisma's
// self-contained-fixture pattern.

generator client {
  provider = "prisma-client"
  output   = "./.generated-client"
}

datasource db {
  provider = "postgresql"
}

model user {
  id                  String        @id @default(cuid())
  name                String
  email               String        @unique
  created_paid_widgets  paid_widget[]  @relation("PaidWidgetCreator")
  updated_paid_widgets  paid_widget[]  @relation("PaidWidgetUpdater")
  created_plain_widgets plain_widget[] @relation("PlainWidgetCreator")
  updated_plain_widgets plain_widget[] @relation("PlainWidgetUpdater")
}

// x-payment: true -- must trigger the write-once Stripe stub files.
model paid_widget {
  id         String   @id @default(cuid())
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("PaidWidgetCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("PaidWidgetUpdater", fields: [updater_id], references: [id])
  @@index([creator_id])
  @@index([updater_id])
}

// No x-payment key -- same-run negative control (see json_schema.yaml).
model plain_widget {
  id         String   @id @default(cuid())
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("PlainWidgetCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("PlainWidgetUpdater", fields: [updater_id], references: [id])
  @@index([creator_id])
  @@index([updater_id])
}
