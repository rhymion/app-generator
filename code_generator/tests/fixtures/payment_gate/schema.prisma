// Self-contained fixture Prisma schema for the payment-gate check.
// NOT the project's
// real prisma/schema.prisma -- this file exists only to run a minimal
// `paid_widget` (x-payment: true) and `plain_widget` (no x-payment) pair
// of standalone entities through the real build_user_schema.py ->
// generate.py pipeline in isolation, proving the x-payment write-once stub
// mechanism actually fires end-to-end.
//
// Modeled on code_generator/tests/fixtures/invalidate_gate/schema.prisma's
// self-contained-fixture pattern.

generator client {
  provider = "prisma-client"
  previewFeatures = ["relationJoins"]
  output   = "./.generated-client"
}

datasource db {
  provider = "postgresql"
}

model user {
  id                  String        @id @default(cuid())
  name                String
  email               String        @unique
  created_widget_catalogs widget_catalog[] @relation("WidgetCatalogCreator")
  updated_widget_catalogs widget_catalog[] @relation("WidgetCatalogUpdater")
  created_paid_widgets  paid_widget[]  @relation("PaidWidgetCreator")
  updated_paid_widgets  paid_widget[]  @relation("PaidWidgetUpdater")
  created_paid_gadgets  paid_gadget[]  @relation("PaidGadgetCreator")
  updated_paid_gadgets  paid_gadget[]  @relation("PaidGadgetUpdater")
  created_plain_widgets plain_widget[] @relation("PlainWidgetCreator")
  updated_plain_widgets plain_widget[] @relation("PlainWidgetUpdater")
}

// Carries the Stripe Price that paid_widget is charged at.
model widget_catalog {
  id              String        @id @default(cuid())
  name            String
  stripe_price_id String
  paid_widgets    paid_widget[]
  created_at      DateTime      @default(now()) @db.Timestamptz(0)
  updated_at      DateTime      @updatedAt @db.Timestamptz(0)
  creator_id      String
  creator         user          @relation("WidgetCatalogCreator", fields: [creator_id], references: [id])
  updater_id      String
  updater         user          @relation("WidgetCatalogUpdater", fields: [updater_id], references: [id])
  @@index([name])
  @@index([creator_id])
  @@index([updater_id])
}

// x-payment: true -- must trigger the write-once Stripe stub files. Priced
// through its foreign key to widget_catalog (no price column of its own).
model paid_widget {
  id         String   @id @default(cuid())
  name       String
  widget_catalog_id String
  widget_catalog    widget_catalog @relation(fields: [widget_catalog_id], references: [id])
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("PaidWidgetCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("PaidWidgetUpdater", fields: [updater_id], references: [id])
  @@index([name])
  @@index([creator_id])
  @@index([updater_id])
  @@index([widget_catalog_id])
}

// x-payment: true, priced by its own stripe_price_id (a fixed default) -- the
// second entity.
model paid_gadget {
  id         String   @id @default(cuid())
  name       String
  stripe_price_id String @default("price_gadget_fixed")
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("PaidGadgetCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("PaidGadgetUpdater", fields: [updater_id], references: [id])
  @@index([name])
  @@index([creator_id])
  @@index([updater_id])
}

// No x-payment key -- same-run negative control (see json_schema.yaml).
model plain_widget {
  id         String   @id @default(cuid())
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("PlainWidgetCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("PlainWidgetUpdater", fields: [updater_id], references: [id])
  @@index([name])
  @@index([creator_id])
  @@index([updater_id])
}
