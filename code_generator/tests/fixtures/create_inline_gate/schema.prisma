// Self-contained fixture Prisma schema for the x-create-inline fixture
// (not the project's real prisma/schema.prisma).

generator client {
  provider = "prisma-client"
  previewFeatures = ["relationJoins"]
  output   = "./.generated-client"
}

datasource db {
  provider = "postgresql"
}

model user {
  id                  String        @id @default(cuid())
  name                String
  email               String        @unique
  created_inline_categorys inline_category[] @relation("InlineCategoryCreator")
  updated_inline_categorys inline_category[] @relation("InlineCategoryUpdater")
  created_inline_topics inline_topic[] @relation("InlineTopicCreator")
  updated_inline_topics inline_topic[] @relation("InlineTopicUpdater")
  created_inline_notes inline_note[] @relation("InlineNoteCreator")
  updated_inline_notes inline_note[] @relation("InlineNoteUpdater")
  created_inline_lockeds inline_locked[] @relation("InlineLockedCreator")
  updated_inline_lockeds inline_locked[] @relation("InlineLockedUpdater")
}

model inline_category {
  id         String   @id @default(cuid())
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("InlineCategoryCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("InlineCategoryUpdater", fields: [updater_id], references: [id])
  topics     inline_topic[]
  notes      inline_note[]
  @@index([name])
  @@index([creator_id])
  @@index([updater_id])
}

// The target of inline_note.inline_topic_id (x-create-inline). Its own form has a
// selection field (inline_category_id) the dialog must load the options for.
model inline_topic {
  id                 String           @id @default(cuid())
  name               String
  inline_category_id String?
  inline_category    inline_category? @relation(fields: [inline_category_id], references: [id])
  created_at         DateTime         @default(now()) @db.Timestamptz(0)
  updated_at         DateTime         @updatedAt @db.Timestamptz(0)
  creator_id         String
  creator            user             @relation("InlineTopicCreator", fields: [creator_id], references: [id])
  updater_id         String
  updater            user             @relation("InlineTopicUpdater", fields: [updater_id], references: [id])
  notes              inline_note[]
  lockeds            inline_locked[]
  @@index([name])
  @@index([inline_category_id])
  @@index([creator_id])
  @@index([updater_id])
}

// Declares x-create-inline on inline_topic_id. inline_category_id is a plain FK to a
// target that is not offered for inline creation (the control group).
model inline_note {
  id                 String           @id @default(cuid())
  title              String
  inline_topic_id    String
  inline_topic       inline_topic     @relation(fields: [inline_topic_id], references: [id])
  inline_category_id String?
  inline_category    inline_category? @relation(fields: [inline_category_id], references: [id])
  created_at         DateTime         @default(now()) @db.Timestamptz(0)
  updated_at         DateTime         @updatedAt @db.Timestamptz(0)
  creator_id         String
  creator            user             @relation("InlineNoteCreator", fields: [creator_id], references: [id])
  updater_id         String
  updater            user             @relation("InlineNoteUpdater", fields: [updater_id], references: [id])
  @@index([title])
  @@index([inline_topic_id])
  @@index([inline_category_id])
  @@index([creator_id])
  @@index([updater_id])
}

// Declares x-create-inline on a foreign key that is also read-only: the field is rendered
// as a read-only display, so no control, state or dialog may be generated for it.
model inline_locked {
  id              String       @id @default(cuid())
  title           String
  inline_topic_id String
  inline_topic    inline_topic @relation(fields: [inline_topic_id], references: [id])
  created_at      DateTime     @default(now()) @db.Timestamptz(0)
  updated_at      DateTime     @updatedAt @db.Timestamptz(0)
  creator_id      String
  creator         user         @relation("InlineLockedCreator", fields: [creator_id], references: [id])
  updater_id      String
  updater         user         @relation("InlineLockedUpdater", fields: [updater_id], references: [id])
  @@index([title])
  @@index([inline_topic_id])
  @@index([creator_id])
  @@index([updater_id])
}
