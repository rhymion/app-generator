export default function FormUpsert({{ form_upsert_params }}) {
  const router = useRouter();
  const [isPending, startTransition] = useTransition();
  const tf = useTranslations('Fields');
  const te = useTranslations('EntityLabel');
  const tc = useTranslations('Common');
  const terr = useTranslations('Errors');
{% if enum_ns_hooks %}
{{ enum_ns_hooks }}
{% endif %}
  const [error, setError] = useState<string | null>(null);
  const [validationError, setValidationError] = useState<string | null>(null);
{% if can_delete or can_invalidate %}
  const canDelete = permissions ? permissions.delete : true;
{% endif %}
  const srcSnapshot = useMemo(() => JSON.stringify(src), [src]);
{% if all_states %}

{{ all_states }}
{% endif %}
{% if child_variables %}
{{ child_variables }}
{% endif %}
{% if parent_refs %}
{{ parent_refs }}
{% endif %}
{% if enum_opt_setups %}
{{ enum_opt_setups }}
{% endif %}
{% if rel_opt_setups %}
{{ rel_opt_setups }}
{% endif %}
{% if child_entity_rel_opt %}
{{ child_entity_rel_opt }}
{% endif %}
{% if child_grid_setup %}
{{ child_grid_setup }}
{% endif %}
{{ validation_call }}

  const getErrorMessage = (err: ActionFailure): string => {
    switch (err.errorCode) {
      case 'SESSION_EXPIRED':   return terr('sessionExpired');
      case 'PERMISSION_DENIED': return terr('permissionDenied');
      case 'NOT_FOUND':         return terr('notFound');
      case 'VALIDATION':        return err.field ? terr('fieldRequired', { field: err.field }) : terr('unknown');
      case 'CONFLICT':          return err.field ? terr('fieldAlreadyLinked', { field: err.field }) : terr('staleMutation');
      case 'CAPACITY':          return terr('capacityExhausted');
      default:                  return terr('unknown');
    }
  };

  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault();

    if (isPending) return;
    const validationMessage = getValidationError();
    setValidationError(validationMessage);
    if (validationMessage) {
      return;
    }

{% if child_validation_code %}
{{ child_validation_code }}

{% endif %}
    const formData = new FormData();
    formData.set('id', src.id);
    if (isEdit) {
      formData.set('__src_snapshot', srcSnapshot);
    }
{% if parent_form_data_sets %}
{{ parent_form_data_sets }}
{% endif %}
{% if child_form_data_handling %}
{{ child_form_data_handling }}
{% endif %}

    try {
      startTransition(async () => {
        const result = (await upsert{{ parent_pascal }}(formData)) as ActionFailure | void;
        if (result && !result.ok) {
          setError(getErrorMessage(result));
        }
      });
    } catch (err) {
      setError(err instanceof Error ? err.message : 'An error occurred');
    }
  };
{% if can_delete %}

  const handleDelete = async () => {
    await remove{{ parent_pascal }}([src.id]);
  };
{% endif %}
{% if can_invalidate %}

  const handleInvalidate = async () => {
    await invalidate{{ parent_pascal }}(src.id);
    router.push('/{{ parent }}');
  };
{% endif %}

  const handleBack = () => {
    router.push('/{{ parent }}');
  };
{% if has_comment_children %}

  const handleCreateComment = async (message: string) => {
    await add{{ parent_pascal }}Comment({{ comment_add_id_expr }}, message);
    router.refresh();
  };

  const handleUpdateComment = async (commentId: string, message: string) => {
    await update{{ parent_pascal }}Comment(commentId, message);
    router.refresh();
  };

  const handleDeleteComment = async (commentId: string) => {
    await delete{{ parent_pascal }}Comment(commentId);
    router.refresh();
  };
{% endif %}

  const formFields = (
    <>
{% if all_parent_fields_jsx %}
{{ all_parent_fields_jsx }}
{% endif %}
{% if child_grid_components %}
{{ child_grid_components }}
{% endif %}
{% if bridge_edit_grids %}
{{ bridge_edit_grids }}
{% endif %}
{% if indep_list_readonly_jsx %}
{{ indep_list_readonly_jsx }}
{% endif %}
{% if flatten_edit_sections %}
{{ flatten_edit_sections }}
{% endif %}
      <AppValidationError message={validationError} />
      {isEdit && <AuditInfo src={src} />}
    </>
  );

  return (
    <>
      <FormWithChildGrid
        title={isEdit ? tc('editEntity', { entity: te('{{ parent_camel }}') }) : tc('addEntity', { entity: te('{{ parent_camel }}') })}
        isEdit={isEdit}
        formFields={formFields}
        onSubmit={handleSubmit}
        onDelete={ {{- 'isEdit && canDelete ? handleDelete : undefined' if can_delete else 'undefined' -}} }
{% if can_invalidate %}
        {# TODO: separate 'invalidate' permission from 'delete' in future #}
        onInvalidate={isEdit && canDelete ? handleInvalidate : undefined}
{% endif %}
        onBack={handleBack}
        deleteEntityLabel={te('{{ parent_camel }}')}
        submitButtonLabel={tc('save')}
        error={error}
      />
{% if comment_children_jsx %}
{{ comment_children_jsx }}
{% endif %}
{% for comp in entity_edit_components %}
      <{{ comp.name }} src={src}{% if comp.props_jsx %} {{ comp.props_jsx }}{% endif %} permissions={permissions} currentUserRoleIds={currentUserRoleIds} />
{% endfor %}
    </>
  );
}
