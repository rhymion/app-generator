import { NextRequest, NextResponse } from 'next/server';
import { put } from '@vercel/blob';
import { writeFile, mkdir } from 'fs/promises';
import path from 'path';
import { requireCaller, ApiError } from '@/lib/api-auth';
import { uploadContentMatchesDeclaredType } from '@/lib/upload-content-check';

// The multipart filename is client-controlled: keep only its last path
// segment (either separator style) and drop control characters, so it can be
// shown in the URL but can never act as a path.
function toStoredFilename(raw: string): string {
  const base = (raw.split(/[\\/]/).pop() ?? '').replace(/[\u0000-\u001f\u007f]/g, '').trim();
  return base === '' || base === '.' || base === '..' ? 'file' : base;
}

export async function POST(request: NextRequest) {
  try {
    // Any authenticated caller: the browser session, or a mobile access token / API key.
    // Authorization is unchanged (a signed-in user, no finer-grained permission).
    try {
      await requireCaller(request);
    } catch (authError) {
      if (authError instanceof ApiError) {
        return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
      }
      throw authError;
    }

    const formData = await request.formData();
    const file = formData.get('file') as File;

    if (!file) {
      return NextResponse.json({ error: 'No file uploaded' }, { status: 400 });
    }

    // Validate file type
    const validTypes = [
      'image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp',
      'application/pdf',
      'application/msword',
      'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
      'application/vnd.ms-excel',
      'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
      'text/csv',
      'text/plain',
      'application/zip',
    ];
    if (!validTypes.includes(file.type)) {
      return NextResponse.json({ error: 'Invalid file type.' }, { status: 400 });
    }

    // The declared type is only a claim: the leading bytes must fit it.
    if (!(await uploadContentMatchesDeclaredType(file))) {
      return NextResponse.json({ error: 'File content does not match its declared type.' }, { status: 400 });
    }

    // Validate file size
    const maxSize = Number(process.env.UPLOAD_MAX_BYTES ?? String(10 * 1024 * 1024)); // 10MB
    if (file.size > maxSize) {
      return NextResponse.json({ error: `File size exceeds ${maxSize} byte limit` }, { status: 400 });
    }

    // Generate unique directory path while preserving original filename
    const timestamp = Date.now();
    const randomString = Math.random().toString(36).substring(2, 15);
    const uniqueDir = `${timestamp}-${randomString}`;
    const originalFilename = toStoredFilename(file.name);

    let url: string;

    // Use Vercel Blob Storage if BLOB_READ_WRITE_TOKEN is set (production)
    if (process.env.BLOB_READ_WRITE_TOKEN) {
      const blobPath = `${uniqueDir}/${originalFilename}`;
      const blob = await put(blobPath, file, {
        access: 'public',
        addRandomSuffix: false,
      });
      url = blob.url;
    } else {
      // BLOB_READ_WRITE_TOKEN is unset -- falling back to local disk, which
      // is not writable/persistent on Vercel's serverless runtime outside
      // /tmp. Warn loudly so a deployment missing the storage integration
      // sees this in its logs, instead of only the unrelated downstream
      // error the fallback eventually produces (app-generator#562).
      console.warn('BLOB_READ_WRITE_TOKEN is not set -- falling back to local filesystem storage, which will not persist on Vercel. Connect the Blob storage integration to fix this.');

      // Fallback to local filesystem (development)
      const bytes = await file.arrayBuffer();
      const buffer = Buffer.from(bytes);

      // Create unique directory under uploads
      const uploadsRoot = path.resolve(process.cwd(), 'public', 'uploads');
      const uploadsDir = path.resolve(uploadsRoot, uniqueDir);
      try {
        await mkdir(uploadsDir, { recursive: true });
      } catch (mkdirError) {
        // EEXIST (directory already exists) is safe to ignore. Anything
        // else (e.g. a read-only-filesystem/permission error on a
        // serverless runtime) must not be discarded -- swallowing it here
        // lets execution fall through to writeFile, which then fails with
        // an unrelated "no such file or directory" error that masks the
        // real cause (app-generator#562).
        if ((mkdirError as NodeJS.ErrnoException)?.code !== 'EEXIST') {
          throw mkdirError;
        }
      }

      // Save file with original filename
      // Confine the final path inside the uploads directory (the read route
      // applies the same check to what it serves).
      const filepath = path.resolve(uploadsDir, originalFilename);
      if (!filepath.startsWith(uploadsDir + path.sep)) {
        return NextResponse.json({ error: 'Invalid file name' }, { status: 400 });
      }
      await writeFile(filepath, buffer);

      // Return the public URL
      url = `/uploads/${uniqueDir}/${originalFilename}`;
    }

    return NextResponse.json({ url }, { status: 200 });
  } catch (error) {
    console.error('Upload error:', error);
    return NextResponse.json({ error: 'Upload failed' }, { status: 500 });
  }
}
