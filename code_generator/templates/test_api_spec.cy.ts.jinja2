// {{ round_trip_unimportable_columns | join(', ') }}: present in export (read-only
// diagnostic column(s)) but rejected by the import route if present in the CSV
// header (UNIMPORTABLE_COLUMN). The N11-N13 round-trip tests below prove the
// *importable* columns survive a re-import, not that literally every exported
// column does — so they strip these columns from the exported CSV first.
function _stripRoundTripUnimportableCsvColumns(csv: string): string {
  const strip: string[] = {{ round_trip_unimportable_columns | tojson }};
  const noBom = csv.charCodeAt(0) === 0xfeff ? csv.slice(1) : csv;
  const lines = noBom.split('\r\n').filter((l) => l.length > 0);
  const headers = lines[0].split(',');
  const keepIdx = headers.reduce<number[]>((acc, h, i) => (strip.includes(h) ? acc : [...acc, i]), []);
  const rebuild = (line: string) => keepIdx.map((i) => line.split(',')[i]).join(',');
  return lines.map(rebuild).join('\r\n');
}
