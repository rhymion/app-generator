  describe('Approval order enforcement', () => {
    it('15.1 cannot approve when preceding request is not approved (400)', () => {
      cy.task<any>('db:setup{{ pascal }}OrderedApprovalFlow').then((setup) => {
        cy.task<any>('db:populate{{ pascal }}WithApproval', {
          creatorId: setup.approverUser1.id,
          approvalFlowIds: [setup.flow1.id, setup.flow2.id],
        }).then((data) => {
          const ar2 = data.approvalRequests.find((r: any) => r.approval_flow_id === setup.flow2.id);
          Cypress.session.clearAllSavedSessions();
          cy.clearCookies();
          cy.login(setup.approverUser2.email, 'test-password');
          cy.request({
            method: 'POST',
            url: `/api/approval_request/${ar2.id}/approve`,
            failOnStatusCode: false,
          }).then((res) => {
            expect(res.status).to.eq(400);
          });
        });
      });
    });

    it('15.2 can approve flow2 after flow1 is approved', () => {
      cy.task<any>('db:setup{{ pascal }}OrderedApprovalFlow').then((setup) => {
        cy.task<any>('db:populate{{ pascal }}WithApproval', {
          creatorId: setup.approverUser1.id,
          approvalFlowIds: [setup.flow1.id, setup.flow2.id],
        }).then((data) => {
          const ar1 = data.approvalRequests.find((r: any) => r.approval_flow_id === setup.flow1.id);
          const ar2 = data.approvalRequests.find((r: any) => r.approval_flow_id === setup.flow2.id);
          Cypress.session.clearAllSavedSessions();
          cy.clearCookies();
          cy.login(setup.approverUser1.email, 'test-password');
          cy.request({
            method: 'POST',
            url: `/api/approval_request/${ar1.id}/approve`,
          }).then((res) => {
            expect(res.status).to.eq(200);
            Cypress.session.clearAllSavedSessions();
            cy.clearCookies();
            cy.login(setup.approverUser2.email, 'test-password');
            cy.request({
              method: 'POST',
              url: `/api/approval_request/${ar2.id}/approve`,
            }).then((res2) => {
              expect(res2.status).to.eq(200);
              expect(res2.body.status).to.eq(1);
            });
          });
        });
      });
    });
  });

