{% if has_approvable %}

  describe('Approval', () => {
    it('7.1 creates approval requests for user in requestor role', () => {
      cy.task<any>('db:setup{{ pascal }}ApprovalFlow').then((setup) => {
        cy.task<any>('db:populate{{ pascal }}Dependencies').then((deps) => {
          Cypress.session.clearAllSavedSessions();
          cy.clearCookies();
          cy.login(setup.requestorUser.email, 'test-password');
          cy.visit('/en/{{ parent }}/new');
{% for cmd in required_fill_cmds %}
          {{ cmd | trim }}
{% endfor %}
          cy.clickButton('Save');
          cy.url().should('include', '/{{ parent }}');
{% if after_create_id_is_expr %}
          cy.contains(deps.{{ primary_dep_var_for_list }}.name).click();
{% else %}
          cy.contains('{{ after_create_id }}').click();
{% endif %}
          cy.url().should('include', '/{{ parent }}/view');
          // Requestor is in requestorRole → both flows apply → 2 approval_requests
          cy.get('table').find('tr').should('have.length', 3);
        });
      });
    });

    it('7.2 does not create approval request for role-gated flow when user lacks requestor role', () => {
      cy.task<any>('db:setup{{ pascal }}ApprovalFlow').then((setup) => {
        cy.task<any>('db:populate{{ pascal }}Dependencies').then((deps) => {
          Cypress.session.clearAllSavedSessions();
          cy.clearCookies();
          cy.login(setup.noRoleUser.email, 'test-password');
          cy.visit('/en/{{ parent }}/new');
{% for cmd in required_fill_cmds %}
          {{ cmd | trim }}
{% endfor %}
          cy.clickButton('Save');
          cy.url().should('include', '/{{ parent }}');
{% if after_create_id_is_expr %}
          cy.contains(deps.{{ primary_dep_var_for_list }}.name).click();
{% else %}
          cy.contains('{{ after_create_id }}').click();
{% endif %}
          cy.url().should('include', '/{{ parent }}/view');
          // noRoleUser not in requestorRole → only flowWithoutRole applies → 1 approval_request
          cy.get('table').find('tr').should('have.length', 2);
        });
      });
    });

    it('7.4 shows Approve/Reject buttons for user in approver role', () => {
      cy.task<any>('db:setup{{ pascal }}ApprovalFlow').then((setup) => {
        cy.task<any>('db:populate{{ pascal }}WithApproval', {
          creatorId: setup.requestorUser.id,
          approvalFlowIds: [setup.flowWithRole.id],
        }).then((data) => {
          Cypress.session.clearAllSavedSessions();
          cy.clearCookies();
          cy.login(setup.approverUser.email, 'test-password');
          cy.visit(`/en/{{ parent }}/view/${data.record.id}`);
          cy.get('[aria-label="Approve"]').should('be.visible');
          cy.get('[aria-label="Reject"]').should('be.visible');
        });
      });
    });

    it('7.5 does not show Approve/Reject buttons for non-approver', () => {
      cy.task<any>('db:setup{{ pascal }}ApprovalFlow').then((setup) => {
        cy.task<any>('db:populate{{ pascal }}WithApproval', {
          creatorId: setup.requestorUser.id,
          approvalFlowIds: [setup.flowWithRole.id],
        }).then((data) => {
          Cypress.session.clearAllSavedSessions();
          cy.clearCookies();
          cy.login(setup.requestorUser.email, 'test-password');
          cy.visit(`/en/{{ parent }}/view/${data.record.id}`);
          cy.get('[aria-label="Approve"]').should('not.exist');
          cy.get('[aria-label="Reject"]').should('not.exist');
        });
      });
    });

    it('7.6 approver can approve a pending request', () => {
      cy.task<any>('db:setup{{ pascal }}ApprovalFlow').then((setup) => {
        cy.task<any>('db:populate{{ pascal }}WithApproval', {
          creatorId: setup.requestorUser.id,
          approvalFlowIds: [setup.flowWithRole.id],
        }).then((data) => {
          Cypress.session.clearAllSavedSessions();
          cy.clearCookies();
          cy.login(setup.approverUser.email, 'test-password');
          cy.visit(`/en/{{ parent }}/view/${data.record.id}`);
          cy.get('[aria-label="Approve"]').click();
          cy.get('[role="dialog"]').find('button').contains('Approve').click();
          cy.contains('Approved').should('be.visible');
          cy.get('[aria-label="Approve"]').should('not.exist');
          // History expand button should appear after approval
          cy.get('[aria-label="Expand history"]').should('be.visible');
        });
      });
    });

    it('7.7 approver can reject a pending request', () => {
      cy.task<any>('db:setup{{ pascal }}ApprovalFlow').then((setup) => {
        cy.task<any>('db:populate{{ pascal }}WithApproval', {
          creatorId: setup.requestorUser.id,
          approvalFlowIds: [setup.flowWithRole.id],
        }).then((data) => {
          Cypress.session.clearAllSavedSessions();
          cy.clearCookies();
          cy.login(setup.approverUser.email, 'test-password');
          cy.visit(`/en/{{ parent }}/view/${data.record.id}`);
          cy.get('[aria-label="Reject"]').click();
          cy.get('[role="dialog"]').find('button').contains('Reject').click();
          cy.contains('Rejected').should('be.visible');
          cy.get('[aria-label="Reject"]').should('not.exist');
        });
      });
    });

    it('7.9 Approve/Reject buttons disabled when preceding approval not done', () => {
      cy.task<any>('db:setup{{ pascal }}OrderedApprovalFlow').then((setup) => {
        cy.task<any>('db:populate{{ pascal }}WithApproval', {
          creatorId: setup.approverUser1.id,
          approvalFlowIds: [setup.flow1.id, setup.flow2.id],
        }).then((data) => {
          Cypress.session.clearAllSavedSessions();
          cy.clearCookies();
          cy.login(setup.approverUser2.email, 'test-password');
          cy.visit(`/en/{{ parent }}/view/${data.record.id}`);
          // flow2 requires flow1 approved first — buttons should not exist
          cy.get('[aria-label="Approve"]').should('not.exist');
          cy.get('[aria-label="Reject"]').should('not.exist');
        });
      });
    });

    it('7.8 requestor can re-submit a rejected request', () => {
      cy.task<any>('db:setup{{ pascal }}ApprovalFlow').then((setup) => {
        cy.task<any>('db:populate{{ pascal }}WithRejectedApproval', {
          creatorId: setup.requestorUser.id,
          approvalFlowIds: [setup.flowWithRole.id],
        }).then((data) => {
          Cypress.session.clearAllSavedSessions();
          cy.clearCookies();
          cy.login(setup.requestorUser.email, 'test-password');
          cy.visit(`/en/{{ parent }}/view/${data.record.id}`);
          cy.get('[aria-label="Re-submit"]').should('be.visible');
          cy.get('[aria-label="Re-submit"]').click();
          cy.get('[role="dialog"]').find('button').contains('Re-submit').click();
          cy.contains('Pending').should('be.visible');
          cy.get('[aria-label="Re-submit"]').should('not.exist');
          // History expand button should appear after re-submission
          cy.get('[aria-label="Expand history"]').should('be.visible');
        });
      });
    });
  });
{% endif %}
