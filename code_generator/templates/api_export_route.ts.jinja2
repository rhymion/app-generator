import { NextRequest, NextResponse } from 'next/server';
import { authenticateApiKey, requireApiPermission, handleApiError } from '@/lib/api-auth';
import { get{{ parent_pascal }}AllForExport } from '@/lib/{{ parent }}/getters';

export async function GET(request: NextRequest) {
  try {
    const { userId: actorId } = await authenticateApiKey(request);
    await requireApiPermission(actorId, '{{ parent }}', 'read');
    const rows = await get{{ parent_pascal }}AllForExport(actorId);
    const csv = rowsToCSV(rows);
    const date = new Date().toISOString().slice(0, 10);
    return new NextResponse(csv, {
      headers: {
        'Content-Type': 'text/csv; charset=utf-8',
        'Content-Disposition': `attachment; filename="{{ parent }}_export_${date}.csv"`,
      },
    });
  } catch (error) {
    return handleApiError(error);
  }
}

const BOM = '﻿';

function rowsToCSV(rows: Record<string, unknown>[]): string {
  if (rows.length === 0) return BOM;
  const headers = Object.keys(rows[0]); // id already excluded by getter
  const escape = (v: unknown): string => {
    if (v === null || v === undefined) return '';
    const s = v instanceof Date ? v.toISOString() : String(v);
    return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  };
  const lines = [
    headers.join(','),
    ...rows.map((r) => headers.map((h) => escape(r[h])).join(',')),
  ];
  return BOM + lines.join('\n');
}
