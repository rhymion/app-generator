{% endif %}
  criteria: Record<string, unknown> = {}
): Promise<{ success: boolean; {{ reservation_config.allocatedField }}: string }> => {
  return await prisma.$transaction(
    (tx) => reserve{{ parent_pascal }}Core(tx, requestId, {% if reservation_config.dateRange %}dateRange, {% endif %}criteria),
