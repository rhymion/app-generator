): Promise<{ success: boolean; {{ reservation_config.allocatedField }}: string }> {
{% if reservation_config.usesOverlapAvailability %}
    const _startMs = new Date(dateRange.{{ reservation_config.dateRange.startField }} as unknown as string).getTime();
    const _endMs = new Date(dateRange.{{ reservation_config.dateRange.endField }} as unknown as string).getTime();
    if (_startMs >= _endMs) {
      throw new Error('Start date must be before end date');
    }
    const candidates = await (tx as unknown as typeof prisma).{{ reservation_config.pool.entity }}.findMany({
      where: {
        ...criteria,
{% if reservation_config.excludePoolStatuses %}
        {{ reservation_config.statusField }}: { notIn: {{ reservation_config.excludePoolStatuses | tojson }} },
{% endif %}
      },
{% if reservation_config.policy.orderBy %}
      orderBy: [
{% for order_item in reservation_config.policy.orderBy %}
{% for field_name, direction in order_item.items() %}
{% if '_nulls_' in direction %}
        { {{ field_name }}: { sort: '{{ direction.split('_nulls_')[0] }}', nulls: '{{ direction.split('_nulls_')[1] }}' } },
{% else %}
        { {{ field_name }}: '{{ direction }}' },
{% endif %}
{% endfor %}
{% endfor %}
      ],
{% endif %}
    });
    for (const candidate of candidates) {
      try {
        await assertNoDuplicateReservation(
          tx as unknown as Pick<typeof prisma, '{{ model }}'>,
          candidate.id,
          dateRange,
          requestId
        );
      } catch {
        continue;
      }
      await tx.{{ model }}.update({
        where: { id: requestId },
        data: { {{ reservation_config.allocatedField }}: candidate.id },
      });
      return { success: true, {{ reservation_config.allocatedField }}: candidate.id };
    }
    throw new InsufficientPoolCapacityError('No available {{ reservation_config.pool.entity }} for reservation');
{% else %}
    const candidate = await (tx as unknown as typeof prisma).{{ reservation_config.pool.entity }}.findFirst({
      where: {
        {{ reservation_config.statusField }}: {{ reservation_config.available_status_ts }},
        ...criteria,
      },
{% if reservation_config.policy.orderBy %}
      orderBy: [
{% for order_item in reservation_config.policy.orderBy %}
{% for field_name, direction in order_item.items() %}
{% if '_nulls_' in direction %}
        { {{ field_name }}: { sort: '{{ direction.split('_nulls_')[0] }}', nulls: '{{ direction.split('_nulls_')[1] }}' } },
{% else %}
        { {{ field_name }}: '{{ direction }}' },
{% endif %}
{% endfor %}
{% endfor %}
      ],
{% endif %}
    });
    if (!candidate) {
      throw new InsufficientPoolCapacityError('No available {{ reservation_config.pool.entity }} for reservation');
    }
{% if reservation_config.dateRange %}
    await assertNoDuplicateReservation(
      tx as unknown as Pick<typeof prisma, '{{ model }}'>,
      candidate.id,
      dateRange,
      requestId
    );
{% endif %}
{% if reservation_config.updatesPoolStatusOnReserve %}
    await (tx as unknown as typeof prisma).{{ reservation_config.pool.entity }}.update({
