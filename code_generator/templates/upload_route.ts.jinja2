import { NextRequest, NextResponse } from 'next/server';
import { getRateLimiter } from '@/lib/rate-limit';
import { requireCaller, ApiError } from '@/lib/api-auth';
import {
  UPLOAD_MULTIPART_OVERHEAD_BYTES,
  UPLOAD_SIGNATURE_BYTES,
  checkUpload,
  loadUploadPolicy,
  matchesFileSignature,
  readBodyWithLimit,
  uploadMaxBytes,
} from '@/lib/_upload_validation';
import { storeUploadedFile } from '@/lib/attachment/upload_core';

// POST /api/upload
// Body: multipart form data with a `file` part.  ->  200 { id, name }
//
// The file is stored under a random key and an attachment record is created for it. The response is the
// record's id (and the file name for display), never a path or URL: the id is what the attach actions
// take, and the file is delivered only by GET /api/attachments/<id>. Only the uploader can attach it.
export async function POST(request: NextRequest) {
  try {
    // Any authenticated caller: the browser session, or a mobile access token / API key.
    // Authorization is unchanged (a signed-in user, no finer-grained permission).
    let userId: string;
    try {
      ({ userId } = await requireCaller(request));
    } catch (authError) {
      if (authError instanceof ApiError) {
        return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
      }
      throw authError;
    }

    // Per-user ceiling on file posts, checked before the body is parsed.
    const _rl = await getRateLimiter().check('upload:file', userId);
    if (!_rl.allowed) {
      return NextResponse.json(
        { error: 'rate_limited', retryAfter: _rl.retryAfterSeconds },
        { status: 429, headers: { 'Retry-After': String(_rl.retryAfterSeconds), 'X-RateLimit-Bucket': 'upload:file' } },
      );
    }

    // The size limit applies before the body is parsed: a declared Content-Length over the limit is refused
    // without reading it, and a body without one is counted while it streams, so an oversized upload is never
    // buffered whole.
    const maxSize = uploadMaxBytes();
    const body = await readBodyWithLimit(request, maxSize + UPLOAD_MULTIPART_OVERHEAD_BYTES);
    if (body === null) {
      return NextResponse.json({ error: `File size exceeds ${maxSize} byte limit` }, { status: 413 });
    }
    let formData: FormData;
    try {
      formData = await new Response(body as BodyInit, {
        headers: { 'content-type': request.headers.get('content-type') ?? '' },
      }).formData();
    } catch {
      return NextResponse.json({ error: 'No file uploaded' }, { status: 400 });
    }
    const file = formData.get('file') as File;

    if (!file) {
      return NextResponse.json({ error: 'No file uploaded' }, { status: 400 });
    }

    // The declared Content-Type and the file name's extension must both be on
    // the allow-lists (UPLOAD_ALLOWED_MIME_TYPES / UPLOAD_ALLOWED_EXTENSIONS);
    // the Content-Type stored with the object is derived from the extension, not the request.
    const uploadCheck = checkUpload(file, loadUploadPolicy());
    if (!uploadCheck.ok) {
      return NextResponse.json({ error: 'Invalid file type.' }, { status: 400 });
    }

    if (file.size > maxSize) {
      return NextResponse.json({ error: `File size exceeds ${maxSize} byte limit` }, { status: 413 });
    }

    // The leading bytes must be those of the format the extension names (the declared type and the extension
    // are both caller-chosen).
    const head = new Uint8Array(await file.slice(0, UPLOAD_SIGNATURE_BYTES).arrayBuffer());
    if (!matchesFileSignature(head, uploadCheck.extension)) {
      return NextResponse.json({ error: 'Invalid file type.' }, { status: 400 });
    }

    const stored = await storeUploadedFile(file, uploadCheck.contentType, userId);
    return NextResponse.json(stored, { status: 200 });
  } catch (error) {
    console.error('Upload error:', error);
    return NextResponse.json({ error: 'Upload failed' }, { status: 500 });
  }
}
