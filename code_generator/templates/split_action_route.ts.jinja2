import { NextRequest, NextResponse } from 'next/server';
import { requireSession, handleApiError, ApiError } from '@/lib/api-auth';
import prisma from '@/lib/prisma';

const SPLIT_STATUS = {{ status_split_value }};
const REJECTED_STATUS = {{ status_rejected_value }};

type SplitPart = {
{% for field in inherited_fields %}
  {{ field }}?: unknown;
{% endfor %}
{% if quantity_field %}
  {{ quantity_field }}: number;
{% endif %}
{% for f in per_part_required %}
  {{ f }}?: string;
{% endfor %}
};

export async function POST(req: NextRequest, { params }: { params: Promise<{ id: string }> }) {
  try {
    const { userId } = await requireSession();
    {% if not has_approvable %}
    void userId;
    {% endif %}
    const { id } = await params;

    let body: { parts?: SplitPart[] };
    try {
      body = await req.json();
    } catch {
      throw new ApiError(400, 'Invalid JSON body');
    }
    const { parts } = body;
    if (!Array.isArray(parts) || parts.length < 2) {
      throw new ApiError(400, 'parts must be an array with at least 2 items');
    }

    const parent = await prisma.{{ entity_name }}.findUnique({
      where: { id },
      {% if has_approvable %}
      include: { approvable: true },
      {% endif %}
    });
    if (!parent) throw new ApiError(404, 'Not found');

    // R6: only pending entities may be split
    if (parent.status === SPLIT_STATUS || parent.status === REJECTED_STATUS) {
      throw new ApiError(400, `Cannot split an entity with status: ${parent.status}`);
    }
    {% if has_approvable %}
    if (parent.approvable?.approved_at != null) {
      throw new ApiError(400, 'Cannot split an already-approved entity');
    }
    {% endif %}
    {% for f in per_part_required %}
    // Each part must specify {{ f }}
    for (const part of parts) {
      if (!part.{{ f }}) {
        throw new ApiError(400, 'Each part must specify {{ f }}');
      }
    }
    {% endfor %}
    {% if has_quantity_check %}
    // Quantity invariant: each part's {{ quantity_field }} must be positive, and
    // Σ(parts.{{ quantity_field }}) must equal parent.{{ quantity_field }} — split
    // is a full re-distribution of the parent quantity, not a partial one.
    for (const part of parts) {
      if (!((part.{{ quantity_field }} as number) > 0)) {
        throw new ApiError(400, 'Each part {{ quantity_field }} must be a positive number');
      }
    }
    const _totalQty = parts.reduce((s, p) => s + ((p.{{ quantity_field }} as number) ?? 0), 0);
    const _parentQty = (parent as Record<string, unknown>).{{ quantity_field }} as number;
    if (_totalQty !== _parentQty) {
      throw new ApiError(400, `Split parts must sum to ${_parentQty} (got ${_totalQty})`);
    }
    {% endif %}

    await prisma.$transaction(async (tx) => {
      // 1. Set parent status = split. approvable_id is mandatory (殿裁定B) — it is
      // never null'd and the approvable record is never deleted (history/audit
      // trail preserved). Only the still-pending approval_requests are removed
      // so the invalidated parent no longer shows as awaiting approval.
      {% if has_approvable %}
      if (parent.approvable_id) {
        await tx.approval_request.deleteMany({ where: { approvable_id: parent.approvable_id } });
      }
      {% endif %}
      await tx.{{ entity_name }}.update({
        where: { id },
        data: { status: SPLIT_STATUS },
      });

      // 2. Create child records — inherit parent fields, override with part-specific values
      {% if has_approvable %}
      // Pre-fetch approval metadata once (shared inner block with cmd_295's
      // x-approval-lines — see generators.py:_build_approval_create_block_for_entity).
      const _splitCreator = await tx.user.findUnique({
        where: { id: userId },
        select: { roles: { select: { id: true } } },
      });
      const _splitCreatorRoleIds = _splitCreator?.roles.map((r) => r.id) ?? [];
      const _splitApprovalFlows = await tx.approval_flow.findMany({
        where: { entity_name: '{{ entity_name }}' },
      });
      {% endif %}
      for (const part of parts) {
        {% if has_approvable %}
        const childApprovable = await tx.approvable.create({ data: {} });
{{ approval_create_block }}
        {% endif %}
        await tx.{{ entity_name }}.create({
          data: {
            {% for field in inherited_fields %}
            {{ field }}: (part.{{ field }} ?? parent.{{ field }}) as never,
            {% endfor %}
            {% if quantity_field %}
            {{ quantity_field }}: part.{{ quantity_field }},
            {% endif %}
            {% for f in per_part_required %}
            {{ f }}: part.{{ f }} ?? parent.{{ f }},
            {% endfor %}
            {% if parent_field %}
            {{ parent_field }}: parent.id,
            {% endif %}
            {% if split_result_field %}
            {{ split_result_field }}: true,
            {% endif %}
            status: 0, // pending
            {% if has_approvable %}
            approvable_id: childApprovable.id,
            {% endif %}
          },
        });
      }
    });

    return NextResponse.json({ ok: true });
  } catch (error) {
    return handleApiError(error);
  }
}
