import { NextRequest, NextResponse } from 'next/server';
import { requireDualAuth, handleApiError, ApiError } from '@/lib/api-auth';
import prisma from '@/lib/prisma';
{% if has_approvable %}
import { notifyApprovalRequestCreated } from '@/lib/_notifyApprovalRequest';
import { createId } from '@paralleldrive/cuid2';
{% endif %}

const SPLIT_STATUS = '{{ status_split_value }}';
const REJECTED_STATUS = '{{ status_rejected_value }}';

type SplitPart = {
{% for field in inherited_fields %}
  {{ field }}?: unknown;
{% endfor %}
{% if quantity_field %}
  {{ quantity_field }}: number;
{% endif %}
{% for f in per_part_required %}
  {{ f }}?: string;
{% endfor %}
};

export async function POST(req: NextRequest, { params }: { params: Promise<{ id: string }> }) {
  try {
    // cmd_648: dual-auth — X-API-Key/Authorization header when present,
    // session cookie otherwise (see app/api/search/route.ts).
    const { userId } = await requireDualAuth(req);
    {% if not has_approvable %}
    void userId;
    {% endif %}
    const { id } = await params;

    let body: { parts?: SplitPart[] };
    try {
      body = await req.json();
    } catch {
      throw new ApiError(400, 'Invalid JSON body');
    }
    const { parts } = body;
    if (!Array.isArray(parts) || parts.length < 2) {
      throw new ApiError(400, 'parts must be an array with at least 2 items');
    }

    const parent = await prisma.{{ entity_name }}.findUnique({
      where: { id },
      {% if has_approvable %}
      // cmd_439 F1: approval_requests included so split children can inherit
      // the parent's flow IDs (Option A — see _parentARFlowIds below).
      include: { approvable: { include: { approval_requests: true } } },
      {% endif %}
    });
    if (!parent) throw new ApiError(404, 'Not found');

    // R6: only pending entities may be split
    if (parent.status === SPLIT_STATUS || parent.status === REJECTED_STATUS) {
      throw new ApiError(400, `Cannot split an entity with status: ${parent.status}`);
    }
    {% if has_approvable %}
    if (parent.approvable?.approved_at != null) {
      throw new ApiError(400, 'Cannot split an already-approved entity');
    }
    {% endif %}
    {% for f in per_part_required_mandatory %}
    // Each part must specify {{ f }}
    for (const part of parts) {
      if (!part.{{ f }}) {
        throw new ApiError(400, 'Each part must specify {{ f }}');
      }
    }
    {% endfor %}
    {% if has_quantity_check %}
    // Quantity invariant: each part's {{ quantity_field }} must be positive, and
    // Σ(parts.{{ quantity_field }}) must equal parent.{{ quantity_field }} — split
    // is a full re-distribution of the parent quantity, not a partial one.
    for (const part of parts) {
      if (!((part.{{ quantity_field }} as number) > 0)) {
        throw new ApiError(400, 'Each part {{ quantity_field }} must be a positive number');
      }
    }
    const _totalQty = parts.reduce((s, p) => s + ((p.{{ quantity_field }} as number) ?? 0), 0);
    const _parentQty = (parent as Record<string, unknown>).{{ quantity_field }} as number;
    if (_totalQty !== _parentQty) {
      throw new ApiError(400, `Split parts must sum to ${_parentQty} (got ${_totalQty})`);
    }
    {% endif %}

    await prisma.$transaction(async (tx) => {
      // 1. Set parent status = split. approvable_id is mandatory (per cmd_296 ruling) — it is
      // never null'd and the approvable record is never deleted (history/audit
      // trail preserved). Only the still-pending approval_requests are removed
      // so the invalidated parent no longer shows as awaiting approval.
      {% if has_approvable %}
      if (parent.approvable_id) {
        await tx.approval_request.deleteMany({ where: { approvable_id: parent.approvable_id } });
      }
      {% endif %}
      await tx.{{ entity_name }}.update({
        where: { id },
        data: { status: SPLIT_STATUS },
      });

      {% if has_inventory_bridge and split_reserves_inventory %}
      // 2. Release parent's reserved inventory BEFORE creating the child
      // reservations below (cmd_307 FIX-α): re-splitting into the same lot
      // must free the parent's reserved_quantity first, or the child
      // availability check double-counts against it and trips a false
      // 'Concurrent reservation conflict'. Same $transaction, so isolation
      // is preserved regardless of ordering.
      if ((parent as Record<string, unknown>).{{ bridge_fk_field }}) {
        const _parentBridgeId = (parent as Record<string, unknown>)
          .{{ bridge_fk_field }} as string;
        const _parentReserveRows = await tx.{{ ledger_entity }}.findMany({
          where: { {{ bridge_fk_field }}: _parentBridgeId, event_type: 'reserve' },
        });
        for (const _row of _parentReserveRows) {
          // cmd_562: {{ pool_location_field }} is an id on the ledger row
          // itself — no reverse label lookup needed to re-identify the
          // parent's reserved inventory row.
          await tx.{{ pool_entity }}.updateMany({
            where: {
              {{ pool_item_field }}: _row.{{ pool_item_field }},
              {{ pool_location_field }}: _row.{{ pool_location_field }},
              ...(_row.{{ pool_lot_field }} != null ? { {{ pool_lot_field }}: _row.{{ pool_lot_field }} } : {}),
              ...(_row.{{ pool_expiration_field }} != null ? { {{ pool_expiration_field }}: _row.{{ pool_expiration_field }} } : {}),
            },
            data: { reserved_quantity: { decrement: _row.reserved_delta } },
          });
          await tx.{{ ledger_entity }}.create({
            data: {
              {{ bridge_fk_field }}: _parentBridgeId,
              event_type: 'cancel',
              quantity_delta: 0,
              reserved_delta: -_row.reserved_delta,
              {{ pool_item_field }}: _row.{{ pool_item_field }},
              {{ pool_location_field }}: _row.{{ pool_location_field }},
              {{ pool_lot_field }}: _row.{{ pool_lot_field }},
              {{ pool_expiration_field }}: _row.{{ pool_expiration_field }},
              creator_id: userId, updater_id: userId, created_by_id: userId,
            },
          });
        }
      }
      {% endif %}

      // 3. Create child records — inherit parent fields, override with part-specific values
      {% if has_approvable %}
      // cmd_439 F1 (Option A): split children inherit the parent's existing
      // approval_request flow IDs unconditionally — the split actor's role
      // is irrelevant, the child continues whatever approval flow the
      // parent was already subject to.
      const _parentARFlowIds = (parent.approvable?.approval_requests ?? []).map(
        (r: { approval_flow_id: string }) => r.approval_flow_id
      );
      {% endif %}
      for (const part of parts) {
        {% if has_approvable %}
        const childApprovable = await tx.approvable.create({ data: {} });
        {% endif %}
        {% if has_inventory_bridge %}
        // Bridge allocation per child (cmd_305 FIX-B, design B-3): each split
        // child gets its own inventory_transactionable bridge instead of
        // inheriting the parent's, so afterApprove/afterReject fire on it.
        // cmd_307 FIX-γ: '' is the UI's "no lot selected" sentinel for an
        // unspecified part — normalize it to undefined so it doesn't slip
        // past a nullish (`??`) check downstream and get written as an
        // invalid inventory_id FK.
        const _childInventoryIdRaw = (part as Record<string, unknown>).{{ pool_fk_field }} as string | undefined;
        const _childInventoryId: string | undefined = _childInventoryIdRaw === '' ? undefined : _childInventoryIdRaw;

        {% if split_reserves_inventory %}
        let _childBridgeId: string;

        if (_childInventoryId) {
          // Specified lot: validate availability and reserve exactly that lot
          const _childInv = await tx.{{ pool_entity }}.findUnique({
            where: { id: _childInventoryId },
            select: { id: true, quantity: true, reserved_quantity: true,
                      {{ pool_item_field }}: true, {{ pool_location_field }}: true,
                      {{ pool_lot_field }}: true, {{ pool_expiration_field }}: true },
          });
          if (!_childInv) throw new ApiError(400, `Inventory not found: ${_childInventoryId}`);
          {% if split_item_field %}
          // item3: hard-fail a specified lot that doesn't belong to this part's
          // product — the pre-fix code only checked existence, so a lot from an
          // unrelated product could be reserved against this line.
          const _childEffectiveProductId = (part.{{ split_item_field }} ?? parent.{{ split_item_field }}) as string;
          if (_childInv.{{ pool_item_field }} !== _childEffectiveProductId) {
            throw new ApiError(400, `Inventory ${_childInventoryId} belongs to a different product than this split part`);
          }
          {% endif %}
          const _childQty = part.{{ quantity_field }} as number;
          const _claimResult = await tx.{{ pool_entity }}.updateMany({
            where: { id: _childInventoryId,
                     reserved_quantity: { lte: _childInv.quantity - _childQty } },
            data: { reserved_quantity: { increment: _childQty } },
          });
          if (_claimResult.count === 0)
            throw new ApiError(409, 'Concurrent reservation conflict; please retry');
          const _childBridge = await tx.{{ transactionable_entity }}.create({ data: {} });
          _childBridgeId = _childBridge.id;
          await tx.{{ ledger_entity }}.create({
            data: {
              {{ bridge_fk_field }}: _childBridgeId,
              event_type: 'reserve',
              quantity_delta: 0,
              reserved_delta: _childQty,
              {{ pool_item_field }}: _childInv.{{ pool_item_field }},
              {{ pool_location_field }}: _childInv.{{ pool_location_field }},
              {{ pool_lot_field }}: _childInv.{{ pool_lot_field }},
              {{ pool_expiration_field }}: _childInv.{{ pool_expiration_field }},
              creator_id: userId, updater_id: userId, created_by_id: userId,
            },
          });
        } else {
          // Auto-allocate: greedy scan by expiration_date asc, lot_number asc (same as PO creation)
          const _childQty = part.{{ quantity_field }} as number;
          const _parentForProduct = parent as Record<string, unknown>;
          const _candidates = await tx.{{ pool_entity }}.findMany({
            where: { {{ pool_item_field }}: _parentForProduct.{{ split_item_field }} as string, quantity: { gt: 0 } },
            orderBy: [{ {{ pool_expiration_field }}: { sort: 'asc', nulls: 'last' } }, { {{ pool_lot_field }}: 'asc' }, { id: 'asc' }],
          });
          const _childBridge = await tx.{{ transactionable_entity }}.create({ data: {} });
          _childBridgeId = _childBridge.id;
          let _remaining = _childQty;
          for (const _cand of _candidates) {
            if (_remaining <= 0) break;
            const _avail = _cand.quantity - _cand.reserved_quantity;
            if (_avail <= 0) continue;
            const _claim = Math.min(_remaining, _avail);
            const _claimResult = await tx.{{ pool_entity }}.updateMany({
              where: { id: _cand.id, reserved_quantity: { lte: _cand.quantity - _claim } },
              data: { reserved_quantity: { increment: _claim } },
            });
            if (_claimResult.count > 0) {
              _remaining -= _claim;
              await tx.{{ ledger_entity }}.create({
                data: {
                  {{ bridge_fk_field }}: _childBridgeId,
                  event_type: 'reserve',
                  quantity_delta: 0,
                  reserved_delta: _claim,
                  {{ pool_item_field }}: _cand.{{ pool_item_field }},
                  {{ pool_location_field }}: _cand.{{ pool_location_field }},
                  {{ pool_lot_field }}: _cand.{{ pool_lot_field }},
                  {{ pool_expiration_field }}: _cand.{{ pool_expiration_field }},
                  creator_id: userId, updater_id: userId, created_by_id: userId,
                },
              });
            }
          }
          if (_remaining > 0)
            throw new ApiError(400, `Insufficient inventory for split part (shortfall: ${_remaining})`);
        }
        {% else %}
        // cmd_307 FIX-β: receive-type entity (x-ledger-source event_type
        // 'receive') — split does not reserve existing inventory; afterApprove
        // writes the receive ledger row at approval time. The child still
        // gets its own empty bridge so that hook has something to attach to.
        {% if split_item_field %}
        if (_childInventoryId) {
          // item3: hard-fail a specified lot that doesn't belong to this part's
          // product here too — otherwise the mismatch would only surface later,
          // silently, when afterApprove writes the receive ledger.
          const _childInv = await tx.{{ pool_entity }}.findUnique({
            where: { id: _childInventoryId },
            select: { {{ pool_item_field }}: true },
          });
          if (!_childInv) throw new ApiError(400, `Inventory not found: ${_childInventoryId}`);
          const _childEffectiveProductId = (part.{{ split_item_field }} ?? parent.{{ split_item_field }}) as string;
          if (_childInv.{{ pool_item_field }} !== _childEffectiveProductId) {
            throw new ApiError(400, `Inventory ${_childInventoryId} belongs to a different product than this split part`);
          }
        }
        {% endif %}
        const _childBridge = await tx.{{ transactionable_entity }}.create({ data: {} });
        const _childBridgeId = _childBridge.id;
        {% endif %}
        {% endif %}
        {% if has_approvable %}const _splitChild = {% endif %}await tx.{{ entity_name }}.create({
          data: {
            {% for field in inherited_fields %}
            {{ field }}: (part.{{ field }} ?? parent.{{ field }}) as never,
            {% endfor %}
            {% if quantity_field %}
            {{ quantity_field }}: part.{{ quantity_field }},
            {% endif %}
            {% for f in per_part_required %}
            {% if has_inventory_bridge and f == pool_fk_field %}
            // cmd_307 FIX-γ: use the normalized child lot id, not
            // `part.inventory_id ?? parent.inventory_id` — the child must
            // never inherit the parent's inventory_id (auto-allocate can
            // span multiple lots, so a single inherited id would be wrong).
            {% if f in per_part_required_mandatory %}
            // cmd_734: {{ f }} is schema-required (non-nullable column) —
            // the per_part_required_mandatory check above already threw a
            // 400 for any part missing it, before this transaction started,
            // so `_childInventoryId` is guaranteed defined here. TypeScript
            // can't see across that earlier loop, so this cast documents
            // (not creates) the guarantee — `?? null` would violate the
            // column's NOT NULL type instead.
            {{ f }}: _childInventoryId as string,
            {% else %}
            {{ f }}: _childInventoryId ?? null,
            {% endif %}
            {% else %}
            {{ f }}: part.{{ f }} ?? parent.{{ f }},
            {% endif %}
            {% endfor %}
            {% if parent_field %}
            {{ parent_field }}: parent.id,
            {% endif %}
            {% if split_result_field %}
            {{ split_result_field }}: true,
            {% endif %}
            status: 'pending', // pending
            {% if has_approvable %}
            approvable_id: childApprovable.id,
            {% endif %}
            {% if has_inventory_bridge %}
            {{ bridge_fk_field }}: _childBridgeId,
            {% endif %}
          },
        });
        {% if has_approvable %}
        // cmd_479: the notify call inside approval_create_block links to
        // this row's own detail page, so it must run after the row exists.
{{ approval_create_block }}
        {% endif %}
      }
    });

    return NextResponse.json({ ok: true });
  } catch (error) {
    return handleApiError(error);
  }
}
