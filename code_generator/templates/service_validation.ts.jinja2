import prisma from '@/lib/prisma';
import { validateCustomRules } from '@/lib/{{ model }}/service_validation_custom';
import { AppError } from '@/lib/_errors';

type TransactionClient = Pick<typeof prisma, '{{ model }}'{% for check in one_to_one_checks %} | '{{ check.target }}'{% endfor %}>;
type RequiredField = { key: string; label: string };
type OneToOneRelation = { key: string; label: string; target: string; required: boolean };

const REQUIRED_FIELDS: RequiredField[] = [
{% for field in required_fields %}
  { key: '{{ field.key }}', label: '{{ field.label }}' },
{% endfor %}
] ;

const DECIMAL_FIELDS: RequiredField[] = [
{% for field in decimal_fields %}
  { key: '{{ field.key }}', label: '{{ field.label }}' },
{% endfor %}
] ;

// Optional sign, digits, optional fractional part -- matches what a Prisma
// Decimal column accepts. This is the authoritative guard for the REST
// API / server-action write path (CSV import bypasses validateOnAdd/
// validateOnUpdate entirely -- see api_import_route.ts.jinja2's own
// DECIMAL_CELL_RE check).
const DECIMAL_PATTERN = /^-?\d+(\.\d+)?$/;

function isInvalidDecimal(value: unknown): boolean {
  if (typeof value !== 'string' || value.trim() === '') return false;
  return !DECIMAL_PATTERN.test(value.trim());
}

const ONE_TO_ONE_RELATIONS: OneToOneRelation[] = [
{% for check in one_to_one_checks %}
  { key: '{{ check.key }}', label: '{{ check.label }}', target: '{{ check.target }}', required: {{ 'true' if check.required else 'false' }} },
{% endfor %}
] ;
{% if approval_locked_fields %}

// Approval-locked values: values a field may only receive through the
// approval/rejection workflow (derived from that entity's x-approval
// on_approved/on_rejected set_fields). A plain create/update attempting to
// write one of these values is rejected here -- the workflow itself never
// reaches this check, since it writes via a direct transaction call, not
// this service layer.
type ApprovalLockedField = { key: string; values: unknown[] };

const APPROVAL_LOCKED_FIELDS: ApprovalLockedField[] = [
{% for field in approval_locked_fields %}
  { key: '{{ field }}', values: {{ approval_locked_values[field] | tojson }} },
{% endfor %}
] ;
{% endif %}

function isMissingValue(value: unknown): boolean {
  if (value === null || value === undefined) return true;
  if (typeof value === 'string') return value.trim() === '';
  if (typeof value === 'boolean') return false;
  if (typeof value === 'number') return Number.isNaN(value);
  if (value instanceof Date) return Number.isNaN(value.getTime());
  if (typeof value === 'object' && value !== null && 'isValid' in value) {
    const maybeDayjs = value as { isValid?: () => boolean };
    if (typeof maybeDayjs.isValid === 'function') {
      return !maybeDayjs.isValid();
    }
  }
  return false;
}

// cmd_834: validateCustomRules's declared arity varies by entity -- newly
// generated stubs accept the pre-edit row as a 4th parameter, but every
// already-generated (GENERATED-ONCE, never rewritten in place)
// service_validation_custom.ts across every existing consumer entity still
// declares the pre-cmd_834 3-parameter signature. A function type with
// fewer parameters is always structurally assignable to one with more (the
// same rule that lets `(x) => x` satisfy an Array.prototype.map callback
// typed to take (item, index, array)), so casting the import through
// CustomRulesFn below compiles against BOTH shapes with no back-compat
// branch: an old 3-param implementation simply never binds the extra
// argument (JavaScript silently discards a call's trailing arguments a
// function doesn't declare); a new 4-param one receives it.
type CustomRulesFn = (
  tx: TransactionClient,
  data: Record<string, unknown>,
  currentId: string | null,
  prevRow: Record<string, unknown> | null,
) => Promise<void>;

async function validateSchemaRules(tx: TransactionClient, data: Record<string, unknown>, currentId: string | null, prevRow: Record<string, unknown> | null): Promise<void> {
  for (const field of REQUIRED_FIELDS) {
    if (isMissingValue(data[field.key])) {
      throw new AppError('VALIDATION', `${field.label} is required`, field.key, 'missing');
    }
  }

  for (const field of DECIMAL_FIELDS) {
    if (isInvalidDecimal(data[field.key])) {
      throw new AppError('VALIDATION', `${field.label} must be a valid decimal number`, field.key, 'invalid');
    }
  }

  for (const relation of ONE_TO_ONE_RELATIONS) {
    const value = data[relation.key];
    if (isMissingValue(value)) {
      if (relation.required) {
        throw new AppError('VALIDATION', `${relation.label} is required`, relation.key, 'missing');
      }
      continue;
    }

    const relationId = String(value);
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const targetExists = await (tx as any)[relation.target].findUnique({
      where: { id: relationId },
      select: { id: true },
    });
    if (!targetExists) {
      throw new AppError('VALIDATION', `${relation.label} does not exist`, relation.key, 'invalid');
    }

    const conflict = await tx.{{ model }}.findFirst({
      where: currentId
        ? { [relation.key]: relationId, NOT: { id: currentId } }
        : { [relation.key]: relationId },
      select: { id: true },
    });
    if (conflict) {
      throw new AppError('CONFLICT', `${relation.label} is already linked`, relation.key);
    }
  }
{% if approval_locked_fields %}

  {
    let currentRow: Record<string, unknown> | null = null;
    for (const field of APPROVAL_LOCKED_FIELDS) {
      if (!(field.key in data)) continue;
      const submitted = data[field.key];
      if (!field.values.includes(submitted)) continue;
      if (currentId !== null) {
        if (currentRow === null) {
          currentRow = (await tx.{{ model }}.findUnique({
            where: { id: currentId },
            select: {{ approval_locked_values_select }},
          })) as Record<string, unknown> | null;
        }
        // No-op resubmission of the value the row already holds is not a
        // lockdown violation -- it's the same value the approval/rejection
        // workflow already wrote.
        if (currentRow && currentRow[field.key] === submitted) continue;
      }
      throw new AppError(
        'VALIDATION',
        `${field.key} cannot be set to this value directly -- it is set by the approval/rejection workflow`,
        field.key,
        'invalid',
      );
    }
  }
{% endif %}

  // cmd_652: hand-written entity-specific business rules (e.g. a
  // self-referential relation that must only link same-"chain" rows) live
  // entirely in lib/{{ model }}/service_validation_custom.ts, a
  // GENERATED-ONCE stub — see that file for the socket contract. This call
  // is unconditional and identical for every entity; the generator carries
  // no knowledge of what (if anything) the hook checks.
  //
  // cmd_830: a hand-written rule rejects a value that IS present (e.g. "X
  // is not a party on the claimed policy") -- never a missing one, since
  // the REQUIRED_FIELDS loop above already owns that case for any field it
  // covers. service_validation_custom.ts predates the 'reason' discriminator
  // and always constructs AppError('VALIDATION', ...) with no 4th argument,
  // so re-tag it here rather than requiring every hand-written file across
  // every consumer project to be edited.
  try {
    await (validateCustomRules as CustomRulesFn)(tx, data, currentId, prevRow);
  } catch (e) {
    if (e instanceof AppError && e.code === 'VALIDATION' && !e.reason) {
      throw new AppError('VALIDATION', e.message, e.field, 'invalid');
    }
    throw e;
  }
}

export async function validateOnAdd(tx: TransactionClient, data: Record<string, unknown>): Promise<void> {
  await validateSchemaRules(tx, data, null, null);
}

export async function validateOnUpdate(tx: TransactionClient, id: string, data: Record<string, unknown>, prevRow: Record<string, unknown> | null): Promise<void> {
  await validateSchemaRules(tx, data, id, prevRow);
}
{% if reservation_config and reservation_config.mode == 'item' and reservation_config.dateRange %}

// --- reservation overlap validation (generated, cmd_139 Phase 2) ---
interface DateRange {
  {{ reservation_config.dateRange.startField }}: Date | string;
  {{ reservation_config.dateRange.endField }}: Date | string;
}

function hasOverlap(a: DateRange, b: DateRange): boolean {
  const aStart = new Date(a.{{ reservation_config.dateRange.startField }} as string).getTime();
  const aEnd   = new Date(a.{{ reservation_config.dateRange.endField }} as string).getTime();
  const bStart = new Date(b.{{ reservation_config.dateRange.startField }} as string).getTime();
  const bEnd   = new Date(b.{{ reservation_config.dateRange.endField }} as string).getTime();
  return aStart < bEnd && bStart < aEnd;
}

async function checkDateRangeOverlap(
  tx: TransactionClient,
  allocatedItemId: string,
  {{ reservation_config.dateRange.startField }}: Date | string,
  {{ reservation_config.dateRange.endField }}: Date | string,
  excludeId?: string
): Promise<boolean> {
  const existing = await tx.{{ model }}.findMany({
    where: {
      {{ reservation_config.allocatedField }}: allocatedItemId,
      ...(excludeId ? { NOT: { id: excludeId } } : {}),
    },
    select: {
      {{ reservation_config.dateRange.startField }}: true,
      {{ reservation_config.dateRange.endField }}: true,
    },
  });
  const target: DateRange = {
    {{ reservation_config.dateRange.startField }},
    {{ reservation_config.dateRange.endField }},
  };
  return existing.some((e) => hasOverlap(e as unknown as DateRange, target));
}

export async function assertNoDuplicateReservation(
  tx: TransactionClient,
  allocatedItemId: string,
  dateRange: DateRange,
  excludeId?: string
): Promise<void> {
  const overlaps = await checkDateRangeOverlap(
    tx,
    allocatedItemId,
    dateRange.{{ reservation_config.dateRange.startField }},
    dateRange.{{ reservation_config.dateRange.endField }},
    excludeId
  );
  if (overlaps) {
    throw new Error('Reservation overlaps with an existing booking');
  }
}
{% endif %}
