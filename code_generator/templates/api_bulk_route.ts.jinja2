type BulkResult<T> = BulkSuccess<T> | BulkFailure;

interface BulkResponse<T> {
  results: BulkResult<T>[];
  summary: { total: number; succeeded: number; failed: number };
}

// Per-item failure text. The app's own typed errors carry caller-facing text;
// anything else (a driver, SDK or database error) is logged here and answered
// with a generic message so internal wording never reaches the client.
function bulkErrorText(err: unknown): string {
  if (err instanceof AppError || err instanceof ApiError) return err.message;
  console.error('[bulk] item failed', err instanceof Error ? err.name : typeof err);
  return 'Internal error';
}

function makeBulkResponse<T>(results: BulkResult<T>[]): BulkResponse<T> {
