import { NextRequest, NextResponse } from 'next/server';
import { Storage } from '@google-cloud/storage';
import { requireCaller, ApiError } from '@/lib/api-auth';
import { checkUpload, loadUploadPolicy } from '@/lib/_upload_validation';

const storage = new Storage();
const bucketName = process.env.GCS_BUCKET_NAME!;

// The multipart filename is client-controlled: keep only its last path
// segment (either separator style) and drop control characters, so it can be
// shown in the URL but can never act as a path.
function toStoredFilename(raw: string): string {
  const base = (raw.split(/[\\/]/).pop() ?? '').replace(/[\u0000-\u001f\u007f]/g, '').trim();
  return base === '' || base === '.' || base === '..' ? 'file' : base;
}

export async function POST(request: NextRequest) {
  try {
    // Any authenticated caller: the browser session, or a mobile access token / API key.
    // Authorization is unchanged (a signed-in user, no finer-grained permission).
    try {
      await requireCaller(request);
    } catch (authError) {
      if (authError instanceof ApiError) {
        return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
      }
      throw authError;
    }

    const formData = await request.formData();
    const file = formData.get('file') as File;

    if (!file) {
      return NextResponse.json({ error: 'No file uploaded' }, { status: 400 });
    }

    // The declared Content-Type and the file name's extension must both be on
    // the allow-lists (UPLOAD_ALLOWED_MIME_TYPES / UPLOAD_ALLOWED_EXTENSIONS);
    // the stored Content-Type is derived from the extension, not the request.
    const uploadCheck = checkUpload(file, loadUploadPolicy());
    if (!uploadCheck.ok) {
      return NextResponse.json({ error: 'Invalid file type.' }, { status: 400 });
    }

    const maxSize = Number(process.env.UPLOAD_MAX_BYTES ?? String(10 * 1024 * 1024)); // 10MB
    if (file.size > maxSize) {
      return NextResponse.json({ error: `File size exceeds ${maxSize} byte limit` }, { status: 400 });
    }

    const timestamp = Date.now();
    const randomString = Math.random().toString(36).substring(2, 15);
    const uniqueDir = `${timestamp}-${randomString}`;
    const originalFilename = toStoredFilename(file.name);
    const gcsPath = `${uniqueDir}/${originalFilename}`;

    const bytes = await file.arrayBuffer();
    const buffer = Buffer.from(bytes);

    const bucket = storage.bucket(bucketName);
    const gcsFile = bucket.file(gcsPath);
    // UBLA: save without ACL; object remains private
    await gcsFile.save(buffer, {
      metadata: { contentType: uploadCheck.contentType },
    });

    // Return internal proxy URL; /api/gcs route generates a fresh V4 signed URL per request
    const url = `/api/gcs/${gcsPath}`;

    return NextResponse.json({ url }, { status: 200 });
  } catch (error) {
    console.error('Upload error:', error);
    return NextResponse.json({ error: 'Upload failed' }, { status: 500 });
  }
}
