import { NextRequest, NextResponse } from 'next/server';
import { authenticate, withActor, handleApiError } from '@/lib/api-auth';
import { getRateLimiter } from '@/lib/rate-limit';
import { searchMentionUserOptions } from '@/lib/mention/search';

// GET /api/mention/users?q=<text>&entity=<entity>&id=<record id>
//   ->  200 { options: [{ id, name, email }], permissionDenied }
//
// The REST side of the @-mention picker in the comment box. It runs the same
// searchMentionUserOptions the web picker calls, as the authenticated caller (mobile access token
// or API key), so the candidates are the web's own: at most 20, ordered by name. `entity` and `id`
// name the record the mention is for; the server reads that record again and, when it has an
// organization, offers only that organization's members (a record without one does not scope the
// list). A record the caller cannot read, or that does not exist, yields an empty list. Without
// `entity` and `id` nothing is scoped by a record. A caller who may not read users gets an empty list with
// permissionDenied: true, exactly as the picker does, instead of an error.

const MAX_QUERY_LENGTH = 200;

export async function GET(request: NextRequest) {
  try {
    const { userId: actorId } = await authenticate(request);
    const _rl = await getRateLimiter().check('api:read', actorId);
    if (!_rl.allowed) {
      return NextResponse.json(
        { error: 'rate_limited', retryAfter: _rl.retryAfterSeconds },
        { status: 429, headers: { 'Retry-After': String(_rl.retryAfterSeconds), 'X-RateLimit-Bucket': 'api:read' } },
      );
    }
    const query = request.nextUrl.searchParams.get('q') ?? '';
    if (query.length > MAX_QUERY_LENGTH) {
      return NextResponse.json({ error: `q exceeds maximum length of ${MAX_QUERY_LENGTH}` }, { status: 400 });
    }
    const entity = request.nextUrl.searchParams.get('entity');
    const recordId = request.nextUrl.searchParams.get('id');
    if ((entity === null) !== (recordId === null)) {
      return NextResponse.json({ error: 'entity and id must be given together' }, { status: 400 });
    }
    if ((entity?.length ?? 0) > MAX_QUERY_LENGTH || (recordId?.length ?? 0) > MAX_QUERY_LENGTH) {
      return NextResponse.json({ error: `entity and id exceed the maximum length of ${MAX_QUERY_LENGTH}` }, { status: 400 });
    }
    const record = entity !== null && recordId !== null ? { entity, id: recordId } : null;
    const result = await withActor(actorId, () => searchMentionUserOptions(query, record));
    return NextResponse.json(result);
  } catch (error) {
    return handleApiError(error);
  }
}
