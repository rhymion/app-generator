'use client';
import { useState } from 'react';

interface InventoryRow {
  id: string;
  product_id?: string | null;
  {{ receiving_inventory_qty_field }}: number;
  reserved_quantity?: number;
  location?: string | null;
  lot_number?: string | null;
  product?: { name?: string } | null;
}

export default function ReceivingConfirmForm({
  src,
}: {
  src: Record<string, unknown>;
  permissions?: unknown;
  currentUserRoleIds?: unknown;
  currentUserId?: unknown;
}) {
  const receiptId = src.id as string;
  const lines = (src.lines as Array<Record<string, unknown>>) ?? [];
  const productIds: string[] = [...new Set(
    lines.map((l) => l.product_id as string).filter(Boolean)
  )];

  const [inventoryRows, setInventoryRows] = useState<InventoryRow[]>([]);
  const [selections, setSelections] = useState<Record<string, number>>({});
  const [loading, setLoading] = useState(false);
  const [fetching, setFetching] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [fetched, setFetched] = useState(false);
  const [confirmed, setConfirmed] = useState(false);

  async function fetchInventory() {
    setFetching(true);
    setError(null);
    try {
      const url = productIds.length === 1
        ? `/api/{{ receiving_inventory_entity }}?f.product_id=${encodeURIComponent(productIds[0])}`
        : `/api/{{ receiving_inventory_entity }}`;
      const res = await fetch(url);
      if (!res.ok) throw new Error(await res.text());
      const data: unknown = await res.json();
      const allRows: InventoryRow[] = Array.isArray(data) ? data as InventoryRow[] : ((data as Record<string, unknown>).items as InventoryRow[]) ?? [];
      const rows = productIds.length > 0 ? allRows.filter((r) => productIds.includes(r.product_id ?? '')) : allRows;
      setInventoryRows(rows);
      setFetched(true);
    } catch (e) {
      setError(String(e));
    } finally {
      setFetching(false);
    }
  }

  async function handleConfirm() {
    const inventory_selections = Object.entries(selections)
      .filter(([, qty]) => qty > 0)
      .map(([inventory_id, quantity]) => ({ inventory_id, quantity }));
    if (inventory_selections.length === 0) {
      setError('加算数量を入力してください');
      return;
    }
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(`/api/{{ receiving_receipt_entity }}/${receiptId}/actions/confirm`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ inventory_selections }),
      });
      if (!res.ok) throw new Error(await res.text());
      setConfirmed(true);
    } catch (e) {
      setError(String(e));
    } finally {
      setLoading(false);
    }
  }

  if (confirmed) {
    return <p>確認済み (Confirmed)</p>;
  }

  return (
    <div>
      {error && <p style={%- raw -%}{{ color: 'red' }}{%- endraw -%}>{error}</p>}
      {!fetched ? (
        <button onClick={fetchInventory} disabled={fetching}>
          {fetching ? '読み込み中...' : 'Inventory 選択して確認 (Confirm Receipt)'}
        </button>
      ) : inventoryRows.length === 0 ? (
        <p>対象在庫が見つかりません</p>
      ) : (
        <div>
          <table>
            <thead>
              <tr>
                <th>商品</th>
                <th>ロケーション</th>
                <th>ロット番号</th>
                <th>現在数量</th>
                <th>加算数量</th>
              </tr>
            </thead>
            <tbody>
              {inventoryRows.map((row) => (
                <tr key={row.id}>
                  <td>{row.product?.name ?? row.id}</td>
                  <td>{row.location ?? '-'}</td>
                  <td>{row.lot_number ?? '-'}</td>
                  <td>{row.{{ receiving_inventory_qty_field }}}</td>
                  <td>
                    <input
                      type="number"
                      min={0}
                      value={selections[row.id] ?? 0}
                      onChange={(e) =>
                        setSelections((prev) => ({ ...prev, [row.id]: Number(e.target.value) }))
                      }
                    />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <button onClick={handleConfirm} disabled={loading}>
            {loading ? '処理中...' : '確認 (Confirm)'}
          </button>
        </div>
      )}
    </div>
  );
}
