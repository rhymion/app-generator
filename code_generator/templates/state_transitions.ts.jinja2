// State-transition gatekeeper (Issue #696 Stage 1 PR2b/PR2c). Model-scoped,
// not per-entity -- one table and one judgment function for every
// x-state-machines-governed field across the whole schema, mirroring
// lib/dashboard/catalog.ts's shape. Each entity's own
// service_validation.ts imports assertTransitionAllowed()/
// assertInitialStateAllowed() from here and calls them at the
// update{Entity}/add{Entity} convergence point (the same place
// x-approval's own guard runs) -- never a dedicated per-field entry point.
import { AppError } from '@/lib/_errors';

type TransitionEdge = [string, string];

type TransitionConfig = {
  edges: TransitionEdge[];
  approvalEdges: TransitionEdge[] | null;
  initialStates: string[];
};

const TRANSITIONS: Record<string, TransitionConfig> = {
{% for e in entries %}
  '{{ e.model }}.{{ e.field }}': {
    edges: {{ e.edges_json }},
    approvalEdges: {{ e.approval_edges_json if e.approval_edges_json else 'null' }},
    initialStates: {{ e.initial_states_json }},
  },
{% endfor %}
};

// Throws when (fromState, toState) is not a legal transition for
// `model.field`. A (model, field) pair absent from TRANSITIONS is not
// state-transition-governed at all -- callers only ever invoke this for a
// field they already know is governed (state_machine_transitions is
// non-empty), so that case is unreachable in generated code, not silently
// permitted.
//
// cmd_1145: a same-state "transition" (fromState === toState) is always
// permitted unconditionally, ahead of the diagram edge / x-approval checks
// below. Treated as an obvious baseline a diagram is not required to spell
// out with an explicit self-edge ("X --> X"). One consequence: an explicit
// self-edge in a diagram is always redundant -- this rule already permits
// it regardless of whether the diagram declares it -- so it is accepted
// as harmless dead content rather than rejected as an error, EXCEPT when
// it is the only outgoing edge a given state has; validate.py does not
// count a self-edge as a real way out, so that state still surfaces as a
// dead end.
export function assertTransitionAllowed(model: string, field: string, fromState: string, toState: string): void {
  const config = TRANSITIONS[`${model}.${field}`];
  if (!config) {
    throw new AppError('VALIDATION', 'no such transition', field, 'invalid');
  }
  if (fromState === toState) return;
  const diagramPermits = config.edges.some(([from, to]) => from === fromState && to === toState);
  if (!diagramPermits) {
    throw new AppError('VALIDATION', 'no such transition', field, 'invalid');
  }
  if (config.approvalEdges) {
    const approvalPermits = config.approvalEdges.some(([from, to]) => from === fromState && to === toState);
    if (!approvalPermits) {
      throw new AppError('VALIDATION', 'transition not permitted by x-approval', field, 'invalid');
    }
  }
}

// Throws when `state` is not one of `model.field`'s declared diagram
// initial states (a `[*] --> state` node). Sister check to
// assertTransitionAllowed() for the create path: a new row has no
// prevRow/fromState to evaluate an edge against, so this validates the
// value against the diagram's initial-state set directly instead.
export function assertInitialStateAllowed(model: string, field: string, state: string): void {
  const config = TRANSITIONS[`${model}.${field}`];
  if (!config) {
    throw new AppError('VALIDATION', 'no such transition', field, 'invalid');
  }
  if (!config.initialStates.includes(state)) {
    throw new AppError('VALIDATION', 'not a valid initial state', field, 'invalid');
  }
}
