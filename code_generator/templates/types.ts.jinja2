import type { ModelPermissions } from '@/lib/authz';
{% for target in import_targets %}
import type { {{ target | pascal_case }} } from '@/lib/{{ target }}/types';
{% endfor %}
{% for type_name, module in flatten_detail_imports %}
import type { {{ type_name | pascal_case }} } from '@/lib/{{ module }}/types';
{% endfor %}

{% for t in inline_flatten_types %}
export type {{ t.name | pascal_case }} = {
{% for field in t.fields %}
  {{ field.name }}: {{ field.ts_type }};
{% endfor %}
};

{% endfor %}
export type {{ parent | pascal_case }} = {
{% for field in parent_fields %}
  {{ field.name }}{% if field.optional %}?{% endif %}: {{ field.ts_type }};
{% endfor %}
{% for rel in parent_rels %}
  {{ rel.relation_name }}?: {{ rel.target | pascal_case }} | null;
{% endfor %}
{% for dar in direct_attachment_rels %}
  {{ dar.relation_name }}?: { id: string; name: string; path: string; type: {{ attachment_type_ts }} } | null;
{% endfor %}
{% for oto in one_to_one_rels %}
  {{ oto.relation_name }}?: {
    id: string;
{% for child in oto.children %}
    {{ child.property_name }}: {
{% for field in child.fields %}
      {{ field.name }}: {{ field.ts_type }};
{% endfor %}
{% if child.child_name == 'approval_request' %}
{% for rel in child.relationships %}
{% if rel.relation_name == 'approval_flow' %}
      {{ rel.relation_name }}?: ({{ rel.target | pascal_case }} & { preceded_by?: { id: string }[] }) | null;
{% else %}
      {{ rel.relation_name }}?: {{ rel.target | pascal_case }} | null;
{% endif %}
{% endfor %}
      approval_histories?: {
        id: string;
        pre_status: number;
        post_status: number;
        message?: string | null;
        created_at: Date | string;
        creator?: { id: string; name: string } | null;
      }[];
{% elif child.child_name == 'comment' %}
      created_at?: string | Date | null;
      updated_at?: string | Date | null;
      creator?: { id: string; name: string; image?: { path: string } | string | null } | null;
      reactionCounts: Array<{ type: {{ reaction_value_type }}; count: number }>;
      myReactionTypes: ({{ reaction_value_type }})[];
{% else %}
{% for rel in child.relationships %}
      {{ rel.relation_name }}?: {{ rel.target | pascal_case }} | null;
{% endfor %}
{% endif %}
    }[];
{% endfor %}
  } | null;
{% endfor %}
  creator?: { id: string; name: string } | null;
  updater?: { id: string; name: string } | null;
};

{% for rel in option_types %}
export type {{ rel.target | pascal_case }}Option = {
  id: string;
  label: string;
};

{% endfor %}
{% if children or reverse_oto_rels or flatten_rels %}
export type {{ parent | pascal_case }}Detail = {{ parent | pascal_case }} & {
{% for child in children %}
  {{ child.property_name }}: {{ child.name | pascal_case }}[];
{% endfor %}
{% for rel in reverse_oto_rels %}
  {{ rel.prop_name }}?: {{ rel.target | pascal_case }} | null;
{% endfor %}
{% for rel in flatten_rels %}
{% if not rel.is_m2o %}
  {{ rel.prop_name }}?: {{ rel.target | pascal_case }} | null;
{% endif %}
{% endfor %}
};

{% for child in children %}
{% if child.declare_type %}
export type {{ child.name | pascal_case }} = {
{% for field in child.fields %}
  {{ field.name }}: {{ field.ts_type }};
{% endfor %}
{% for rel in child.relationships %}
  {{ rel.relation_name }}?: {{ rel.target | pascal_case }} | null;
{% endfor %}
{% if child.output_type == 'comments' %}
  created_at?: string | Date | null;
  updated_at?: string | Date | null;
  creator?: { id: string; name: string; image?: { path: string } | string | null } | null;
  reactionCounts: Array<{ type: {{ reaction_value_type }}; count: number }>;
  myReactionTypes: ({{ reaction_value_type }})[];
{% endif %}
};

{% endif %}
{% endfor %}
{% else %}
export type {{ parent | pascal_case }}Detail = {{ parent | pascal_case }};

{% endif %}
{% set _ns = namespace(has_comments=false) %}
{% for _oto in one_to_one_rels %}
{% for _ch in _oto.children %}
{% if _ch.child_name == 'comment' %}{% set _ns.has_comments = true %}{% endif %}
{% endfor %}
{% endfor %}
{% for _ch in children %}
{% if _ch.output_type == 'comments' %}{% set _ns.has_comments = true %}{% endif %}
{% endfor %}
{% if _ns.has_comments %}
export type CommentReactionSummary = {
  commentId: string;
  type: {{ reaction_value_type }};
  active: boolean;
  counts: Array<{ type: {{ reaction_value_type }}; count: number }>;
  myTypes: ({{ reaction_value_type }})[];
};

{% endif %}
export type {{ parent | pascal_case }}DetailPageProps = Readonly<{
  params: Promise<{
    id: string;
  }>
}>;

export type FormViewProps = Readonly<{
  src: {
{% for field in form_view_fields %}
    {{ field.name }}{% if field.optional %}?{% endif %}: {{ field.ts_type }};
{% endfor %}
{% for rel in parent_rels %}
    {{ rel.relation_name }}?: {{ rel.target | pascal_case }} | null;
{% endfor %}
{% for child in children %}
    {{ child.property_name }}: {{ child.name | pascal_case }}[];
{% endfor %}
{% for oto in one_to_one_rels %}
    {{ oto.relation_name }}?: {
      id: string;
{% for child in oto.children %}
      {{ child.property_name }}: {
{% for field in child.fields %}
        {{ field.name }}: {{ field.ts_type }};
{% endfor %}
{% if child.child_name == 'approval_request' %}
{% for rel in child.relationships %}
{% if rel.relation_name == 'approval_flow' %}
        {{ rel.relation_name }}?: ({{ rel.target | pascal_case }} & { preceded_by?: { id: string }[] }) | null;
{% else %}
        {{ rel.relation_name }}?: {{ rel.target | pascal_case }} | null;
{% endif %}
{% endfor %}
        approval_histories?: {
          id: string;
          pre_status: number;
          post_status: number;
          message?: string | null;
          created_at: Date | string;
          creator?: { id: string; name: string } | null;
        }[];
{% elif child.child_name == 'comment' %}
        created_at?: string | Date | null;
        updated_at?: string | Date | null;
        creator?: { id: string; name: string; image?: { path: string } | string | null } | null;
        reactionCounts: Array<{ type: {{ reaction_value_type }}; count: number }>;
        myReactionTypes: ({{ reaction_value_type }})[];
{% else %}
{% for rel in child.relationships %}
        {{ rel.relation_name }}?: {{ rel.target | pascal_case }} | null;
{% endfor %}
{% endif %}
      }[];
{% endfor %}
    } | null;
{% endfor %}
{% for rel in reverse_oto_rels %}
    {{ rel.prop_name }}?: {{ rel.target | pascal_case }} | null;
{% endfor %}
{% for rel in flatten_rels %}
{% if not rel.is_m2o %}
    {{ rel.prop_name }}?: {{ rel.target | pascal_case }} | null;
{% endif %}
{% endfor %}
{% for dar in direct_attachment_rels %}
    {{ dar.relation_name }}?: { id: string; name: string; path: string; type: {{ attachment_type_ts }} } | null;
{% endfor %}
    created_at?: string | Date;
    updated_at?: string | Date;
    creator?: { id: string; name: string } | null;
    updater?: { id: string; name: string } | null;
  };
  permissions?: ModelPermissions;
{% if comment_has_mention %}
  /** Whether the viewer may link mentioned users' names to their profile page (cmd_522). */
  canViewUserProfile?: boolean;
  /** Maps mentioned user id → display name, for MentionText (cmd_522). */
  mentionUserContext?: Record<string, string>;
{% endif %}
{% if entity_view_components or entity_edit_components %}
  currentUserRoleIds?: string[];
  currentUserId?: string | null;
{% endif %}
}>;

export type FormUpsertProps = Readonly<FormViewProps & {
  isEdit: boolean;
{% for target in all_option_targets %}
  {# permissionDenied: set when the current user lacks read on {{ target }} —
     the FK field renders disabled-but-clearable instead of the page
     crashing. Passed as its own boolean prop (not read off the array below)
     because a non-index property attached to an array does not survive
     the Server-to-Client Component serialization boundary — the page
     computes it server-side, before the array crosses that boundary, and
     passes it down alongside the array. See
     docs/knowledge/fk-read-permission-graceful-degradation.md. #}
  initial{{ target | pascal_case }}s?: {{ target | pascal_case }}[] & { permissionDenied?: boolean };
  initial{{ target | pascal_case }}sPermissionDenied?: boolean;
  search{{ target | pascal_case }}Options?: (query: string, includeIds: string[], limit?: number, context?: { callerEntity?: string; formValues?: Record<string, unknown> }) => Promise<{{ target | pascal_case }}[] & { permissionDenied?: boolean }>;
{% endfor %}
  currentUserId?: string | null;
{% if is_bridge_child %}
  /** Parent context for create, supplied by the parent-embedded grid (/new?parentType=&parentId=). */
  initialParentType?: string;
  initialParentId?: string;
{% endif %}
}>;
