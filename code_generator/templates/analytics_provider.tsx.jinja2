    posthog.identify(userId);
{% if analytics_identity_attach_tenant %}    if (tenantId) posthog.group('tenant', tenantId);
{% endif %}  }, [userId{% if analytics_identity_attach_tenant %}, tenantId{% endif %}]);
}
