// generated — do not edit
{% if analytics_enabled %}
'use client';
import posthog from 'posthog-js';
import { PostHogProvider } from 'posthog-js/react';
import { usePathname } from 'next/navigation';
import { useEffect } from 'react';

if (typeof window !== 'undefined') {
  posthog.init(process.env.NEXT_PUBLIC_POSTHOG_KEY!, {
    api_host: process.env.NEXT_PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com',
    autocapture: false,
    capture_pageview: false,
    disable_session_recording: true,
    heatmaps: false,
    surveys: false,
    loaded: (ph) => {
      if (process.env.NODE_ENV === 'development') ph.debug();
    },
  });
}

function PageViewTracker() {
  const pathname = usePathname();
  useEffect(() => {
    if (pathname) {
      posthog.capture('page_view', {
        route: pathname,
        timestamp: new Date().toISOString(),
      });
    }
  }, [pathname]);
  return null;
}

function ClickTracker() {
  useEffect(() => {
    function handleClick(event: MouseEvent) {
      const target = event.target as HTMLElement;
      if (!target) return;

      const safeProps: Record<string, string | null> = {
        element_id: target.id || null,
        role: target.getAttribute('role') || target.tagName.toLowerCase(),
        aria_label: target.getAttribute('aria-label') || null,
        route: window.location.pathname,
      };

      const props = Object.fromEntries(
        Object.entries(safeProps).filter(([, v]) => v !== null)
      ) as Record<string, string>;

      posthog.capture('click', props);
    }

    document.body.addEventListener('click', handleClick);
    return () => document.body.removeEventListener('click', handleClick);
  }, []);

  return null;
}

export function AnalyticsProvider({ children }: { children: React.ReactNode }) {
  return (
    <PostHogProvider client={posthog}>
      <PageViewTracker />
      <ClickTracker />
      {children}
    </PostHogProvider>
  );
}

const _ALLOWED_CLICK_PROPS = ['element_id', 'role', 'aria_label', 'route'] as const;

export const analytics = {
  capture: (event: string, props?: Record<string, unknown>) => {
    const safeProps = props
      ? Object.fromEntries(
          Object.entries(props).filter(([k]) => (_ALLOWED_CLICK_PROPS as readonly string[]).includes(k))
        )
      : {};
    posthog.capture(event, safeProps);
  },
};
{% else %}
// analytics disabled
export function AnalyticsProvider({ children }: { children: React.ReactNode }) {
  return <>{children}</>;
}

export const analytics = {
  capture: (_event: string, _props?: Record<string, unknown>) => {},
};
{% endif %}
