{% endif %}

{% if analytics_consent_scope %}
export function ConsentBanner() {
  const t = useTranslations('Analytics');
  const [decided, setDecided] = useState(
    () => typeof localStorage !== 'undefined' && localStorage.getItem(CONSENT_KEY) !== null,
  );
  if (decided) return null;
  return (
    <div
      style={%raw%}{{
        position: 'fixed', bottom: 0, left: 0, right: 0, zIndex: 9999,
        padding: '1rem', background: '#1e1e1e', color: '#fff',
        display: 'flex', gap: '1rem', alignItems: 'center',
      }}{%endraw%}
    >
      <span>{t('consentDescription')}</span>
      <button
        onClick={%raw%}{() => { setConsent(true); posthog.opt_in_capturing(); setDecided(true); }}{%endraw%}
      >
        {t('consentAccept')}
      </button>
      <button
        onClick={%raw%}{() => { setConsent(false); setDecided(true); }}{%endraw%}
      >
        {t('consentDecline')}
      </button>
    </div>
  );
}
{% else %}
export function ConsentBanner(): null { return null; }
{% endif %}

export function AnalyticsProvider({ children }: { children: React.ReactNode }) {
  return (
    <PostHogProvider client={posthog}>
      <PageViewTracker />
      <ClickTracker />
      {% if analytics_event_key_special %}<KeySpecialTracker />{% endif %}
      {% if analytics_event_key_count %}<KeyCountTracker />{% endif %}
      {% if analytics_event_form_submit or analytics_event_form_field_blur or analytics_event_validation_error %}<FormLifecycleTracker />{% endif %}
      {children}
      {% if analytics_consent_scope %}<ConsentBanner />{% endif %}
    </PostHogProvider>
  );
}

