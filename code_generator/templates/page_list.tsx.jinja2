import { Suspense } from 'react';
import TableSkeleton from '@/components/_standard/TableSkeleton';
import { getTranslations } from 'next-intl/server';
{% if list_component == 'CardListClient' %}
import CardListClient from '@/components/_standard/CardListClient';
{% else %}
import ResponsiveListClient from '@/components/_standard/ResponsiveListClient';
{% endif %}
import { get{{ parent_pascal }}PagedData, fetch{{ parent_pascal }}Page } from '@/lib/{{ parent }}/getters';
{% if can_delete %}
import { remove{{ parent_pascal }} } from '@/lib/{{ parent }}/actions';
{% endif %}
import { DEFAULT_PAGE_SIZE{% if needs_formatting %}, type PageOpts{% endif %} } from '@/lib/_pagination';
{% if list_uses_format_label_value %}
import { formatLabelValue } from '@/lib/_format';
{% endif %}
import AppListToolbar from '@/components/ui/layout/AppListToolbar';
{% for comp in entity_custom_components %}
import {{ comp.name }} from '{{ comp.path if comp.path else "@/components/" + parent + "/" + comp.name }}';
{% endfor %}

type SearchParamsRecord = Record<string, string | string[] | undefined>;

export default function {{ parent_pascal }}ListPage({
  searchParams,
}: {
  searchParams: Promise<SearchParamsRecord>;
}) {
  return (
    <Suspense fallback={<TableSkeleton />}>
      <{{ parent_pascal }}ListContent searchParams={searchParams} />
    </Suspense>
  );
}

async function {{ parent_pascal }}ListContent({
  searchParams,
}: {
  searchParams: Promise<SearchParamsRecord>;
}) {
  const sp = await searchParams;
  const rawPage = Array.isArray(sp.page) ? sp.page[0] : sp.page;
  const rawPageSize = Array.isArray(sp.pageSize) ? sp.pageSize[0] : sp.pageSize;
  const pageNum = Number(rawPage ?? 0);
  const pageSizeNum = Number(rawPageSize ?? DEFAULT_PAGE_SIZE);

  const [t{% if xdisplay_table %}, tf{% endif %}{% if has_chart %}, tc{% endif %}{% for ns in enum_ns_list %}, {{ ns.var_name }}T{% endfor %}] = await Promise.all([
    getTranslations('EntityLabel'),
{% if xdisplay_table %}
    getTranslations('Fields'),
{% endif %}
{% if has_chart %}
    getTranslations('Common'),
{% endif %}
{% for ns in enum_ns_list %}
    getTranslations('{{ ns.ns }}'),
{% endfor %}
  ]);
{% for ns in enum_ns_list %}
  const {{ ns.var_name }} = {
{% for key in ns.keys %}
    {{ key }}: {{ ns.var_name }}T('{{ key }}'),
{% endfor %}
  } as Record<number, string>;
{% endfor %}
  const { {{ parent_camel }}Page, userPermissions } = await get{{ parent_pascal }}PagedData({
    page: Number.isFinite(pageNum) ? pageNum : 0,
    pageSize: Number.isFinite(pageSizeNum) ? pageSizeNum : DEFAULT_PAGE_SIZE,
  });
{% if needs_formatting %}
  const formatted{{ parent_pascal }}s = {{ parent_camel }}Page.rows.map(item => ({
    ...item,
{{ formatting_entries }}
  }));

  // Wrap the raw fetcher so client refetches (next page / sort / filter) return
  // rows in the same formatted shape as the initial render.
  async function fetchFormatted{{ parent_pascal }}Page(opts: PageOpts) {
    'use server';
    const raw = await fetch{{ parent_pascal }}Page(opts);
{% for ns in enum_ns_list %}
    const {{ ns.var_name }}T = await getTranslations('{{ ns.ns }}');
    const {{ ns.var_name }} = {
{% for key in ns.keys %}
      {{ key }}: {{ ns.var_name }}T('{{ key }}'),
{% endfor %}
    } as Record<number, string>;
{% endfor %}
    return {
      ...raw,
      rows: raw.rows.map(item => ({
        ...item,
{{ formatting_entries }}
      })),
    };
  }
{% endif %}
  return (
    <>
      <AppListToolbar
        title={t('{{ parent_camel }}')}
{% if has_chart %}
        chartHref="/{{ parent }}/chart"
        chartLabel={tc('chart')}
{% endif %}
      >
{% for comp in entity_custom_components %}
        <{{ comp.name }} permissions={userPermissions} />
{% endfor %}
      </AppListToolbar>
      <{{ list_component }}
        entityLabel={t('{{ parent_camel }}')}
        initialRows={{ '{' }}{% if needs_formatting %}formatted{{ parent_pascal }}s{% else %}{{ parent_camel }}Page.rows{% endif %}{{ '}' }}
        initialRowCount={ {{ parent_camel }}Page.total }
        initialPage={ {{ parent_camel }}Page.page }
        initialPageSize={ {{ parent_camel }}Page.pageSize }
        fetchPage={ {% if needs_formatting %}fetchFormatted{{ parent_pascal }}Page{% else %}fetch{{ parent_pascal }}Page{% endif %} }
        permissions={userPermissions}
        basePath="/{{ parent }}"
{% if can_delete %}
        removeAction={remove{{ parent_pascal }}}
{% endif %}
{% if display_fields_code %}
        displayFields={[
{{ display_fields_code }}
        ]}
{% endif %}
{% if primary_field %}
        primaryField="{{ primary_field }}"
{% endif %}
      />
    </>
  );
}
