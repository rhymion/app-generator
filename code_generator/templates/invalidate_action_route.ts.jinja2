import { NextRequest, NextResponse } from 'next/server';
import { authenticate, requireApiPermission, handleApiError{% if not is_self_only %}, ApiError{% endif %} } from '@/lib/api-auth';
{% if not is_self_only %}
import { resolvePermissions } from '@/lib/authz';
{% endif %}
import prisma from '@/lib/prisma';
{% if should_filter_by_org %}
import { getAssociatedOrganizations } from '@/lib/organization/getters_associated';
{% endif %}
{% if has_invalidate_guard %}
import { assertInvalidateAllowed } from '@/lib/{{ parent }}/invalidate_guard';
{% endif %}
{% if invalidate_module %}
import { {{ invalidate_handler }} } from '@/{{ invalidate_module }}';
{% else %}
import { invalidate{{ parent_pascal }} } from '@/lib/{{ parent }}/invalidate_handler';
{% endif %}

// POST /api/{{ parent }}/[id]/actions/invalidate
// Invalidates the given {{ parent }} record via the configured handler.
// TODO: separate 'invalidate' permission from 'delete' in future
export async function POST(
  request: NextRequest,
  { params }: { params: Promise<{ id: string }> }
) {
  try {
    const { id } = await params;
    const { userId } = await authenticate(request);

    // Coarse, item-independent gate first (a caller with no possible access
    // path is rejected before the record is looked up), then the same
    // record-level resolution the DELETE route uses: Creator/Assignee grants
    // only apply to records the caller created / is assigned to, and the
    // record must be inside the caller's organizations.
{% if is_self_only %}
    await requireApiPermission(userId, '{{ parent }}', 'delete');
{% else %}
    const basePerms = await requireApiPermission(userId, '{{ parent }}', 'delete');
{% endif %}
{% if should_filter_by_org %}
    const _assocOrgs = await getAssociatedOrganizations(userId);
    const _assocOrgIds = _assocOrgs.map((o) => o.id);
{% if org_relationship_optional %}
    const existing = await prisma.{{ model }}.findFirst({ where: { id, OR: [{ organization_id: { in: _assocOrgIds } }, { organization_id: null }] }, select: {{ item_context_select }} });
{% else %}
    const existing = await prisma.{{ model }}.findFirst({ where: { id, organization_id: { in: _assocOrgIds } }, select: {{ item_context_select }} });
{% endif %}
{% else %}
    const existing = await prisma.{{ model }}.findUnique({ where: { id }, select: {{ item_context_select }} });
{% endif %}
    if (!existing) {
      return NextResponse.json({ error: 'Not found' }, { status: 404 });
    }
{% if is_self_only %}
    // x-self-only: ownership is the sole gate, with no general.delete override.
    if (existing.creator_id !== userId) {
      return NextResponse.json({ error: 'Not found' }, { status: 404 });
    }
{% else %}
    const resolved = await resolvePermissions(basePerms, existing, userId);
    if (!resolved.delete) {
      throw new ApiError(403, `Access denied: {{ parent }}.delete`);
    }
{% endif %}

    {% if has_invalidate_guard %}
    const _invalidateGuardRow = await prisma.{{ model }}.findUnique({ where: { id }, select: { {{ lockdown_field }}: true } });
    assertInvalidateAllowed(_invalidateGuardRow);
    {% endif %}

    {% if invalidate_module %}
    const result = await {{ invalidate_handler }}(id);
    {% else %}
    const result = await invalidate{{ parent_pascal }}(id);
    {% endif %}

    return NextResponse.json(result ?? { success: true });
  } catch (error) {
    return handleApiError(error);
  }
}
