  // text typed yet" popper state would show every {{ parent }} row
  // regardless of any hand-written filter (lib/{{ parent }}/autocomplete_filter.ts),
  // since a call with no context always resolves to that filter's
  // no-context branch.
  const initial{{ parent_pascal }}s = await search{{ parent_pascal }}Options('', [], 50, { callerEntity: '{{ parent }}', formValues: detail.{{ parent_camel }} as unknown as Record<string, unknown> });
{% endif %}
  return <FormUpsert src={detail.{{ parent_camel }}} isEdit={true} permissions={detail.userPermissions}{% if comment_has_mention %} canViewUserProfile={detail.canViewUserProfile} mentionUserContext={detail.mentionUserContext}{% endif %}{% if entity_edit_components %} currentUserRoleIds={currentUserRoleIds}{% endif %}{% for target in selection_targets %} initial{{ target | pascal_case }}s={ initial{{ target | pascal_case }}s } initial{{ target | pascal_case }}sPermissionDenied={Boolean((initial{{ target | pascal_case }}s as { permissionDenied?: boolean } | undefined)?.permissionDenied)} search{{ target | pascal_case }}Options={ {% if target == 'organization' %}searchAssociatedOrganizationOptions{% else %}search{{ target | pascal_case }}Options{% endif %} }{% endfor %}{% for oto in selector_oto_rels %} initial{{ oto.target | pascal_case }}s={ initialAvailable{{ oto.target | pascal_case }}s } initial{{ oto.target | pascal_case }}sPermissionDenied={Boolean((initialAvailable{{ oto.target | pascal_case }}s as { permissionDenied?: boolean } | undefined)?.permissionDenied)} search{{ oto.target | pascal_case }}Options={ {% if oto.target == 'organization' %}searchAssociatedOrganizationOptions{% else %}search{{ oto.target | pascal_case }}Options{% endif %} }{% endfor %}{% if comment_children %} currentUserId={currentUserId}{% endif %} />;
}
