import { Suspense } from 'react';
import FormSkeleton from '@/components/_standard/FormSkeleton';
import FormUpsert from '@/components/{{ parent }}/FormUpsert';
import { get{{ parent_pascal }}DetailPageData } from '@/lib/{{ parent }}/getters';
{% for target in selection_targets %}
{% if target == 'organization' %}
import { searchAssociatedOrganizationOptions } from '@/lib/organization/getters_associated';
{% else %}
import { search{{ target | pascal_case }}Options } from '@/lib/{{ target }}/getters';
{% endif %}
{% endfor %}
{% for oto in selector_oto_rels %}
import { getAvailable{{ oto.target | pascal_case }}sFor{{ parent_pascal }} } from '@/lib/{{ parent }}/getters';
{% if oto.target == 'organization' %}
import { searchAssociatedOrganizationOptions } from '@/lib/organization/getters_associated';
{% else %}
import { search{{ oto.target | pascal_case }}Options } from '@/lib/{{ oto.target }}/getters';
{% endif %}
{% endfor %}
{% if comment_children or entity_edit_components %}
import { {% if comment_children %}getSessionUserId{% endif %}{% if comment_children and entity_edit_components %}, {% endif %}{% if entity_edit_components %}getUserRoleIds{% endif %} } from '@/lib/authz';
{% endif %}
import { {{ parent_pascal }}DetailPageProps } from '@/lib/{{ parent }}/types';
import { notFound } from 'next/navigation';

export default async function Edit{{ parent_pascal }}Page({ params }: {{ parent_pascal }}DetailPageProps) {
  const { id } = await params;
  return (
    <Suspense fallback={<FormSkeleton />}>
      <{{ parent_pascal }}EditContent id={id} />
    </Suspense>
  );
}

{% set _other_selection_targets = selection_targets | reject('equalto', parent) | list %}
async function {{ parent_pascal }}EditContent({ id }: { id: string }) {
{% if _other_selection_targets or selector_oto_rels %}
  const [detail, {% for target in _other_selection_targets %}initial{{ target | pascal_case }}s{% if not loop.last or selector_oto_rels or entity_edit_components %}, {% endif %}{% endfor %}{% for oto in selector_oto_rels %}initialAvailable{{ oto.target | pascal_case }}s{% if not loop.last or entity_edit_components %}, {% endif %}{% endfor %}{% if entity_edit_components %}currentUserRoleIds{% endif %}] = await Promise.all([
    get{{ parent_pascal }}DetailPageData(id, 'update'),
{% for target in _other_selection_targets %}
{% if target == 'organization' %}
    searchAssociatedOrganizationOptions('', [], 50),
{% else %}
    search{{ target | pascal_case }}Options('', [], 50),
{% endif %}
{% endfor %}
{% for oto in selector_oto_rels %}
    getAvailable{{ oto.target | pascal_case }}sFor{{ parent_pascal }}(id),
{% endfor %}
{% if entity_edit_components %}
    getUserRoleIds(),
{% endif %}
  ]);
{% else %}
{% if entity_edit_components %}
  const [detail, currentUserRoleIds] = await Promise.all([
    get{{ parent_pascal }}DetailPageData(id, 'update'),
    getUserRoleIds(),
  ]);
{% else %}
  const detail = await get{{ parent_pascal }}DetailPageData(id, 'update');
{% endif %}
{% endif %}
{% if comment_children %}
  const currentUserId = await getSessionUserId();
{% endif %}
  if (!detail.{{ parent_camel }}) {
    notFound();
  }
{% if parent in selection_targets %}
  // cmd_652: self-referential candidate list — fetched AFTER detail resolves
  // (unlike the other selection targets above, which run in the initial
  // Promise.all before any record data is available) so the record's OWN
  // current field values can be forwarded as context.formValues, the same
