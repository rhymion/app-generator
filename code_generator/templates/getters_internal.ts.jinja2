{% if trigram_search_fields %}
/**
 * Columns declared `x-trigram-filter: true`. A text filter on one of them and the search box
 * (which matches any of them) select matching ids with the COALESCE expression the
 * `idx_{{ model }}_<column>_gin_trgm_v2` index is built on; Prisma's own `contains` renders the bare
 * column, which that index does not serve. The SQL is literal text fixed at generation time and
 * the user's text is bound as a parameter.
 */
const TRIGRAM_PREDICATES: Record<string, (pattern: string) => Prisma.Sql> = {
{% for f in trigram_search_fields %}
  '{{ f }}': (pattern) => Prisma.sql`COALESCE("{{ f }}", '') ILIKE ${pattern}`,
{% endfor %}
};
const TRIGRAM_FIELDS: readonly string[] = Object.keys(TRIGRAM_PREDICATES);

/**
 * The rows where any of `columns` contains `term`, as a where clause. A selective term selects the
 * matching ids with the indexed COALESCE expression and narrows the Prisma query by `id IN (...)`.
 * A term matching more than TRIGRAM_ID_LIMIT rows (a 1-2 character term, a very common word) is not
 * served by the index either, and a longer id list exceeds the bind-parameter limit, so it is
 * matched with Prisma's own case-insensitive `contains` instead. The caller applies its own access
 * scope to the rows this clause selects.
 */
async function trigramWhere(columns: readonly string[], term: string) {
  const pattern = trigramPattern(term);
  const predicate = Prisma.join(columns.map((column) => TRIGRAM_PREDICATES[column](pattern)), ' OR ');
  const ids = await selectTrigramIds(
    Prisma.sql`SELECT "id" FROM "{{ model }}" WHERE ${predicate} LIMIT ${TRIGRAM_ID_LIMIT + 1}`,
  );
  if (ids.length <= TRIGRAM_ID_LIMIT) return { id: { in: ids } };
  return { OR: columns.map((column) => ({ [column]: { contains: term, mode: 'insensitive' as const } })) };
}

{% endif %}
/**
 * Paginated query for {{ parent }} — pushes Creator/Assignee/org filters into the
 * where clause so the DB never has to scan the full table for restricted users.
 * `perms` and `userId` must already be loaded by the caller (so server actions
 * and route handlers can reuse the permission lookup they already did).
 */
export async function get{{ parent_pascal }}Page(
  opts: PageOpts,
  perms: RichPermissions,
  userId: string | null,
): Promise<PageResult<{{ parent_pascal }}>> {
  const { page, pageSize, skip, take } = clampPage(opts);
{% if should_filter_by_org %}
  const associatedOrganizations = userId ? await getAssociatedOrganizations(userId) : [];
  const associatedOrganizationIds = associatedOrganizations.map((organization) => organization.id);
{% endif %}
  const accessAnd = await build{{ parent_pascal }}AccessWhere(perms, userId{% if should_filter_by_org %}, associatedOrganizationIds{% endif %});
{% if trigram_search_fields %}
  const plainFilter: NonNullable<PageOpts['filter']> = {};
  const trigramAnd: object[] = [];
  for (const [field, value] of Object.entries(opts.filter ?? {})) {
    if (TRIGRAM_FIELDS.includes(field) && typeof value === 'string' && value !== '') {
      trigramAnd.push(await trigramWhere([field], value));
    } else {
      plainFilter[field] = value;
    }
  }
  if (opts.search) {
    trigramAnd.push(await trigramWhere(TRIGRAM_FIELDS, opts.search));
  }
  const filterAnd = buildFilter(plainFilter, FILTERABLE_FIELDS, FIELD_KINDS, RELATION_FILTER_FIELDS, ENUM_MEMBERS, DECIMAL_SCALES);
{% else %}
  const filterAnd = buildFilter(opts.filter, FILTERABLE_FIELDS, FIELD_KINDS, RELATION_FILTER_FIELDS, ENUM_MEMBERS, DECIMAL_SCALES);
{% endif %}
  const customWhere = filterListQuery(opts.filter ?? {});
  const where = {
    AND: [
      ...accessAnd,
      ...filterAnd,
{% if trigram_search_fields %}
      ...trigramAnd,
{% endif %}
      ...(customWhere && Object.keys(customWhere).length > 0 ? [customWhere] : []),
    ],
  };
  const orderBy = buildOrderBy(opts.sort, SORTABLE_FIELDS, RELATION_FILTER_FIELDS);

  // findMany and count run as two independent queries (Promise.all), NOT
  // bundled into a single prisma.$transaction([...]). A batch $transaction
  // needs to grab both its member queries' connections up front from the
  // same pool that hands out every other connection in the process — under
  // concurrent load (e.g. PRISMA_POOL_MAX=5 with other endpoints' queries
  // also competing for connections) that can exceed Prisma's default 2000ms
  // maxWait for a batch transaction, producing P2028 ("Unable to start a
  // transaction in the given time") even though each query alone would have
  // completed fine (PRISMA_POOL_MAX=5 load test, 2026-09-24).
  // Dropping the wrapper lets each query independently acquire whichever
  // pooled connection frees up first, instead of both needing to be grabbed
  // atomically before either can start.
  //
  // This trades exact count/rows consistency under a concurrent write
  // landing between the two queries (e.g. a row inserted or deleted mid-page
  // load could make `total` off by one relative to `rowsRaw`) for that
  // removed connection-acquisition bottleneck. That trade is the same one
  // already made, unavoidably, by every list/detail read path that doesn't
  // wrap its query in a transaction at all (a plain findMany already reads a
  // snapshot that can be stale by the time it reaches the client) — and
  // real-scale load testing found non-transactional endpoints error-free
  // while this transactional pair alone produced P2028 (see
  // docs/knowledge/performance-improvements.md, "List Pagination" section).
  const [rowsRaw, total] = await Promise.all([
    prisma.{{ model }}.findMany({
      where,
      orderBy,
      skip,
      take,
{% if include_props_list %}
      include: { {{ include_props_list }} },
      // See the detail getter's relationLoadStrategy comment above.
      relationLoadStrategy: 'join',
{% endif %}
    }),
    prisma.{{ model }}.count({ where }),
  ]);

{% if non_creator_virtual_columns %}
  let virtualData: Map<string, Record<string, string>>;
  try {
    virtualData = await resolveVirtualColumns(rowsRaw as unknown as ReadonlyArray<Record<string, unknown>>);
  } catch (e) {
    console.warn('virtual resolver error:', e);
    virtualData = new Map();
  }
{% endif %}
  const rows = rowsRaw.map(({{ parent_camel }}) => ({
{{ parent_mapping }}
{% if relationship_mapping %}
{{ relationship_mapping }}
{% endif %}
{% if virtual_mapping %}
{{ virtual_mapping }}
{% endif %}
  }));
  return { rows, total, page, pageSize };
}

