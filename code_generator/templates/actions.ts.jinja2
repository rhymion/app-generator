export async function invalidate{{ parent_pascal }}(id: string): Promise<void> {
  const userId = await getSessionUserIdOrThrow();
  // TODO: separate 'invalidate' permission from 'delete' in future
  // Coarse gate first, then the record-level resolution the delete path uses:
  // Creator/Assignee grants only apply to records the caller created / is
  // assigned to, and the record must be inside the caller's organizations.
  {% if is_self_only %}
  await requireEntityPermission('{{ parent }}', 'delete', userId);
  {% else %}
  const _invalidateBasePerms = await requireEntityPermission('{{ parent }}', 'delete', userId);
  {% endif %}
  {% if should_filter_by_org %}
  const _assocOrgs = await getAssociatedOrganizations(userId);
  const _assocOrgIds = _assocOrgs.map((o) => o.id);
  {% if org_relationship_optional %}
  const _invalidateItem = await prisma.{{ model }}.findFirst({ where: { id, OR: [{ organization_id: { in: _assocOrgIds } }, { organization_id: null }] }, select: {{ item_context_select }} });
  {% else %}
  const _invalidateItem = await prisma.{{ model }}.findFirst({ where: { id, organization_id: { in: _assocOrgIds } }, select: {{ item_context_select }} });
  {% endif %}
  {% else %}
  const _invalidateItem = await prisma.{{ model }}.findUnique({ where: { id }, select: {{ item_context_select }} });
  {% endif %}
  if (!_invalidateItem) throw new AppError('NOT_FOUND', 'Not found');
  {% if is_self_only %}
  // x-self-only: ownership is the sole gate, with no general.delete override.
  if (_invalidateItem.creator_id !== userId) throw new AppError('NOT_FOUND', 'Not found');
  {% else %}
  const _invalidateResolved = await resolveRecordPermissions(_invalidateBasePerms, _invalidateItem, userId);
  if (!_invalidateResolved.delete) {
    throw new AppError('PERMISSION_DENIED', 'Access denied: {{ parent }}.delete');
  }
  {% endif %}
  {% if has_invalidate_guard %}
  const _invalidateGuardRow = await prisma.{{ model }}.findUnique({ where: { id }, select: { {{ lockdown_field }}: true } });
  assertInvalidateAllowed(_invalidateGuardRow);
  {% endif %}
  // A handler may report a failure as a { success: false, errors } result
  // instead of throwing (anonymizeUser does); a void handler is unaffected.
  {% if invalidate_module %}
  const _invalidateResult: unknown = await {{ invalidate_handler }}(id);
  {% else %}
  const _invalidateResult: unknown = await _invalidate{{ parent_pascal }}Stub(id);
  {% endif %}
  if (typeof _invalidateResult === 'object' && _invalidateResult !== null && (_invalidateResult as { success?: unknown }).success === false) {
    throw new AppError('UNKNOWN', `invalidate {{ parent }} failed: ${((_invalidateResult as { errors?: unknown }).errors as string[] | undefined)?.join('; ') ?? 'no error reported'}`);
  }
  revalidatePath('/[locale]/{{ parent }}', 'page');
}
{% endif %}
{% if has_commentable %}

export async function toggle{{ parent_pascal }}CommentReaction(
  commentId: string,
  type: {{ reaction_value_type }}
): Promise<CommentReactionSummary> {
  const userId = await getSessionUserIdOrThrow();
  const validTypes: ({{ reaction_value_type }})[] = COMMENT_REACTION_TYPES.map((t) => t.value);
  if (!validTypes.includes(type)) {
    throw new Error(`Invalid reaction type: ${type}`);
  }
  // D7=B: require read permission on the parent entity that owns the comment.
  // Issue #750: coarse, item-independent gate BEFORE the comment/parent row
  // fetch below -- a caller with no possible access path at all (no general
  // grant, no Creator/Assignee role) is rejected before this action ever
  // queries the comment/parent tables. `basePerms` is reused (not
  // re-fetched) for the item-level resolution once parentRow is fetched --
  // same two-stage pattern PR #749 applied to the REST routes, closing the
  // Server-Action-specific leak shape here (which error is thrown, not a
  // 404-vs-403 status code).
  const basePerms = await requireEntityPermission('{{ parent }}', 'read', userId);
  const comment = await prisma.comment.findUnique({
    where: { id: commentId },
    select: { commentable_id: true },
  });
  if (!comment) throw new Error('Comment not found');
  const parentRow = await prisma.{{ model }}.findFirst({
    where: { commentable_id: comment.commentable_id },
    select: { id: true, creator_id: true{% if has_assignee_id %}, assignee_id: true{% endif %} },
  });
  const resolved = parentRow ? await resolveRecordPermissions(basePerms, parentRow, userId) : basePerms;
  if (!resolved.read) {
    throw new AppError('PERMISSION_DENIED', `Access denied: {{ parent }}.read`);
  }

  const existing = await prisma.reaction.findUnique({
    where: { comment_id_user_id_type: { comment_id: commentId, user_id: userId, type } },
  });
  let active: boolean;
  if (existing) {
    await deleteReaction(existing.id);
    active = false;
  } else {
    await createReaction({ comment_id: commentId, user_id: userId, type });
    active = true;
  }

  const rawCounts = await prisma.reaction.groupBy({
    by: ['type'],
    where: { comment_id: commentId },
    _count: { type: true },
  });
  const counts = rawCounts.map((r) => ({ type: r.type, count: r._count.type }));
  const myReactions = await prisma.reaction.findMany({
    where: { comment_id: commentId, user_id: userId },
    select: { type: true },
  });
  const myTypes = myReactions.map((r) => r.type);

  return { commentId, type, active, counts, myTypes };
}
