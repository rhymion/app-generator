export async function remove{{ parent_pascal }}(ids: string[]) {
  try {
{% if should_filter_by_org %}
    const {% if is_self_only %}{ userId }{% else %}{ permissions: userPermissions, userId }{% endif %} = await getModelPermissions('{{ parent }}');
    if (!userId) throw new AppError('PERMISSION_DENIED', 'No permission to delete');
    const _assocOrgs = await getAssociatedOrganizations(userId);
    const _assocOrgIds = _assocOrgs.map((o) => o.id);
{% if org_relationship_optional %}
    const {{ parent_camel }}s = await prisma.{{ model }}.findMany({
      where: { id: { in: ids }, OR: [{ organization_id: { in: _assocOrgIds } }, { organization_id: null }] },
      select: { id: true, creator_id: true{% for field in filter_values %}, {{ field }}: true{% endfor %} },
    });
{% else %}
    const {{ parent_camel }}s = await prisma.{{ model }}.findMany({
      where: { id: { in: ids }, organization_id: { in: _assocOrgIds } },
      select: { id: true, creator_id: true{% for field in filter_values %}, {{ field }}: true{% endfor %} },
    });
{% endif %}
{% else %}
    const [{% if is_self_only %}{ userId }{% else %}{ permissions: userPermissions, userId }{% endif %}, {{ parent_camel }}s] = await Promise.all([
      getModelPermissions('{{ parent }}'),
      await prisma.{{ model }}.findMany({ where: { id: { in: ids } }, select: { id: true, creator_id: true{% for field in filter_values %}, {{ field }}: true{% endfor %} } }),
    ]);
{% endif %}
{% if is_self_only %}
    // x-self-only: no general.delete/Creator-role override — ownership is
    // the sole gate, unconditionally (no admin bypass on delete).
    const _filteredByRole{{ parent_pascal }}s = {{ parent_camel }}s.filter(item => item.creator_id === userId);
{% else %}
    const _filteredByRole{{ parent_pascal }}s = userPermissions.general.delete
      ? {{ parent_camel }}s
      : {{ parent_camel }}s.filter(item =>
          (userPermissions.creator?.delete && item.creator_id === userId) ||
          // eslint-disable-next-line @typescript-eslint/no-explicit-any
          (userPermissions.assignee?.delete && (item as any).assignee_id === userId)
        );
{% endif %}
{% if filter_values %}
    // x-filter-values: ANDed on top of role-based scope above — a row
    // outside the filtered view is never deletable via this action, even
    // by a caller who otherwise has delete permission (cmd_874/subtask_874f).
    const filtered{{ parent_pascal }}s = _filteredByRole{{ parent_pascal }}s.filter(item => (
{% for field, values in filter_values.items() %}
      ({{ values | tojson }} as unknown[]).includes((item as Record<string, unknown>).{{ field }}){% if not loop.last %} &&{% endif %}

{% endfor %}
    ));
{% else %}
    const filtered{{ parent_pascal }}s = _filteredByRole{{ parent_pascal }}s;
{% endif %}
    if (filtered{{ parent_pascal }}s.length === 0) {
      throw new AppError('PERMISSION_DENIED', 'No permission to delete');
    }
{% if fk_write_checks %}
    if (!userId) throw new AppError('PERMISSION_DENIED', 'No permission to delete');
    await assertDeleteReferencesReachable{{ parent_pascal }}(userId, filtered{{ parent_pascal }}s.map(item => item.id));
{% endif %}
    await delete{{ parent_pascal }}({% if is_audited %}userId, {% endif %}filtered{{ parent_pascal }}s.map(item => item.id));
  } catch (e) {
    if (e instanceof AppError) {
      return { ok: false, errorCode: e.code } satisfies ActionFailure;
    }
    throw e;
  }
{% if can_list %}
  revalidatePath('/[locale]/{{ parent }}', 'page');
{% endif %}
  redirect('/{{ parent }}');
}
{% endif %}
