export async function upsert{{ parent_pascal }}(data: FormData) {
{{ upsert_body }}
{% if is_payment and can_create %}

  // x-payment: send the buyer to Stripe's hosted Checkout page.
  if (_checkoutUrl) {
    redirect(_checkoutUrl);
  }
{% endif %}
{% if inline_create_target %}

  // x-create-inline: a dialog on another entity's form saves through this same
  // action, so the permission, validation and organisation checks above ran
  // unchanged. It needs the new id back to select it, so the id is returned
  // instead of redirecting. A failed save returned above.
  if (_returnId) {
    return { ok: true as const, id: _createdId as string };
  }
{% endif %}
{% if can_continue %}

  // "Save and continue editing": stay on the record instead of going back to
  // the list. After a create this lands on /edit/[id]; after an update it
  // reloads the same screen. The changing `saved` value remounts the form so
  // its state (including embedded child grids) is rebuilt from the saved
  // record. A failed save returned above, so it never reaches this point.
  if (_continueEditing) {
{% if can_create %}
    const _continueId = id || _createdId;
{% else %}
    const _continueId = id;
{% endif %}
    if (_continueId) {
      redirect(id ? `/{{ parent }}/edit/${_continueId}?saved=${Date.now()}` : `/{{ parent }}/edit/${_continueId}`);
    }
  }
{% endif %}

  redirect('/{{ parent }}');
}
{% endif %}
