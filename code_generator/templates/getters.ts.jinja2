/**
 * Lightweight search for autocomplete pickers. Returns up to `limit` rows
 * matching `query`{% if searchable_fields_display %} (substring on {{ searchable_fields_display | join(' / ') }}){% endif %} plus any rows in `includeIds` so the
 * currently-selected option is always present even when it doesn't match the
 * query. Applies the same access scope as the list page.
 */
export async function search{{ parent_pascal }}Options(
  query: string,
  includeIds: string[] = [],
  limit: number = 50,
  context: AutocompleteFilterContext = {},
): Promise<{{ parent_pascal }}[]> {
{% if should_filter_by_org %}
  const userId = await getSessionUserIdOrThrow();
  const { permissions } = await getModelPermissions('{{ parent }}', userId);
{% else %}
  const { permissions, userId } = await getModelPermissions('{{ parent }}');
{% endif %}
  await assertPermission(permissions, 'read', '{{ parent }}');
{% if should_filter_by_org %}
  const associatedOrganizations = await getAssociatedOrganizations(userId);
  const associatedOrganizationIds = associatedOrganizations.map((organization) => organization.id);
{% endif %}
  const accessAnd = build{{ parent_pascal }}AccessWhere(permissions, userId{% if should_filter_by_org %}, associatedOrganizationIds{% endif %});

  const trimmed = query.trim();
  // Token-split AND search: each whitespace-separated token must match at
  // least one searchable field (OR), and every token must match (AND) —
  // so "Test Location" (product-name-word + location-word) narrows instead
  // of requiring one field to contain the whole combined string.
  // filter(Boolean) drops empty tokens from leading/trailing/double spaces
  // (e.g. a null optional labelField segment) so `contains: ''` never
  // silently wildcard-matches every row.
  const tokens = trimmed.split(/\s+/).filter(Boolean);
  const matchOr: Record<string, unknown>[] = [];
  if (tokens.length > 0) {
    const searchAnd = tokens.map((token) => {
      const orClauses: Record<string, unknown>[] = [];
{% for f in searchable_text_fields %}
      orClauses.push({ {{ f }}: { contains: token, mode: 'insensitive' } });
{% endfor %}
{% for rf in searchable_relation_fields %}
      orClauses.push({ {{ rf.relation }}: { {{ rf.field }}: { contains: token, mode: 'insensitive' } } });
{% endfor %}
      return { OR: orClauses };
    });
    matchOr.push({ AND: searchAnd });
  }
  if (includeIds.length > 0) {
    // Always include currently-selected rows regardless of token search —
    // an OR sibling of the token-AND block, not ANDed with it, so a
    // selected option outside the search results still resolves by id.
    matchOr.push({ id: { in: includeIds } });
  }
  const customWhere = filterAutocompleteOptions(context);
  const where = {
    AND: [
      ...accessAnd,
      ...(matchOr.length > 0 ? [{ OR: matchOr }] : []),
      ...(customWhere && Object.keys(customWhere).length > 0 ? [customWhere] : []),
    ],
  };
  const safeLimit = Math.min(Math.max(Math.floor(limit) || 50, 1), 200);
  const rowsRaw = await prisma.{{ model }}.findMany({
    where,
    orderBy: [{ {{ default_search_order_field }}: '{{ default_search_order_dir }}' }],
    take: safeLimit + includeIds.length,
{% if search_include_props_list %}
    include: { {{ search_include_props_list }} },
{% elif include_props_list %}
    include: { {{ include_props_list }} },
{% endif %}
  });
{% if non_creator_virtual_columns %}
  let virtualData: Map<string, Record<string, string>>;
  try {
    virtualData = await resolveVirtualColumns(rowsRaw as unknown as ReadonlyArray<Record<string, unknown>>);
  } catch (e) {
    console.warn('virtual resolver error:', e);
    virtualData = new Map();
  }
{% endif %}
  return rowsRaw.map(({{ parent_camel }}) => ({
{{ parent_mapping }}
{% if relationship_mapping %}
{{ relationship_mapping }}
{% endif %}
{% if virtual_mapping %}
{{ virtual_mapping }}
{% endif %}
  }));
}
{% for oto in selector_oto_rels %}

/**
 * Returns up to `limit` {{ oto.target }} records not already linked to another {{ parent }}.
 * `current{{ parent_pascal }}Id` keeps the {{ oto.target }} attached to the {{ parent }} currently being
 * edited available. The query runs in a single Prisma round-trip (notIn against
 * the set of already-taken target ids) — no full-table scan via getAll.
 */
export async function getAvailable{{ oto.target | pascal_case }}sFor{{ parent_pascal }}(
  current{{ parent_pascal }}Id?: string | null,
  limit: number = 50,
) {
  const takenTargets = await prisma.{{ model }}.findMany({
    where: {
{% if oto.nullable %}
      {{ oto.prop_name }}: { not: null },
{% endif %}
      ...(current{{ parent_pascal }}Id ? { id: { not: current{{ parent_pascal }}Id } } : {}),
    },
    select: { {{ oto.prop_name }}: true },
  });
  const takenIds = takenTargets
    .map(r => r.{{ oto.prop_name }})
    .filter((id): id is string => id !== null);
  const safeLimit = Math.min(Math.max(Math.floor(limit) || 50, 1), 200);
  return prisma.{{ oto.target }}.findMany({
    where: takenIds.length > 0 ? { id: { notIn: takenIds } } : {},
    take: safeLimit,
    // Order by id — the target's "natural" label column varies per entity, and
    // we don't want to pull target-specific schema knowledge into the parent's
    // generated getter. id sort is stable and always present.
    orderBy: [{ id: 'asc' }],
{% if oto.available_include %}
    // Mirror the labelField path so the form's initial-options data carries
    // every relation the autocomplete label expression dereferences.
    include: { {{ oto.available_include }} },
{% endif %}
  });
}
