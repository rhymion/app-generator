/** Every visible version of one {{ version_of.identity }}, drafts included, newest first. */
export async function get{{ parent_pascal }}VersionHistory(identityId: string) {
  const accessAnd = await readable{{ parent_pascal }}Where();
  const rows = await prisma.{{ model }}.findMany({
    where: { AND: [{ {{ version_of.identity_fk }}: identityId }, ...accessAnd] },
    orderBy: [{ {{ version_of.number }}: 'desc' }, { created_at: 'desc' }],
{% if detail_select %}
    select: {
      {{ detail_select }}
    },
{% elif include_props_detail %}
    include: {
      {{ include_props_detail }}
    },
{% endif %}
  });
  const current = await prisma.{{ version_of.identity }}.findUnique({
    where: { id: identityId },
    select: { current_version_id: true },
  });
  const currentVersionId = rows.some((r) => r.id === current?.current_version_id) ? current?.current_version_id ?? null : null;
  // Whether the caller may create a {{ parent }}: the "New version" link on the identity's detail screen is shown only then.
  const { permissions } = await getModelPermissions('{{ parent }}');
  return {
    rows: toPlain(rows) as unknown as Array<Record<string, unknown>>,
    currentVersionId,
    canCreateVersion: permissions.general.create,
  };
}

/** Two versions of the same {{ version_of.identity }} in full. Throws NOT_FOUND unless both are visible to the caller. */
export async function get{{ parent_pascal }}VersionDiff(identityId: string, leftId: string, rightId: string) {
  const accessAnd = await readable{{ parent_pascal }}Where();
  const rows = await prisma.{{ model }}.findMany({
    where: { AND: [{ {{ version_of.identity_fk }}: identityId, id: { in: [leftId, rightId] } }, ...accessAnd] },
{% if detail_select %}
    select: {
      {{ detail_select }}
    },
{% elif include_props_detail %}
    include: {
      {{ include_props_detail }}
    },
{% endif %}
  });
  const left = rows.find((r) => r.id === leftId);
  const right = rows.find((r) => r.id === rightId);
  if (!left || !right) {
    throw new AppError('NOT_FOUND', 'Version not found');
  }
  return { left: toPlain(left) as unknown as Record<string, unknown>, right: toPlain(right) as unknown as Record<string, unknown> };
}
