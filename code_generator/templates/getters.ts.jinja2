 * `current{{ parent_pascal }}Id` keeps the {{ oto.target }} attached to the {{ parent }} currently being
 * edited available. The query runs in a single Prisma round-trip (notIn against
 * the set of already-taken target ids) — no full-table scan via getAll.
 *
 * Checks read permission on {{ oto.target }} before listing (cmd_516 case g) —
 * this previously ran with NO permission check at all (an unconditional
 * listing of {{ oto.target }} regardless of the caller's read access). Mirrors
 * search{{ parent_pascal }}Options' graceful-degradation contract: returns an
 * empty, flagged result rather than throwing, so the {{ parent }} create/edit
 * page doesn't crash either — see
 * docs/knowledge/fk-read-permission-graceful-degradation.md.
 */
export async function getAvailable{{ oto.target | pascal_case }}sFor{{ parent_pascal }}(
  current{{ parent_pascal }}Id?: string | null,
  limit: number = 50,
) {
  const { permissions } = await getModelPermissions('{{ oto.target }}');
  if (!permissions.read) {
    return [] as unknown as {% if oto.available_needs_decimal %}DeepStringifyDecimals<Awaited<ReturnType<typeof prisma.{{ oto.target }}.findMany>>>{% else %}Awaited<ReturnType<typeof prisma.{{ oto.target }}.findMany>>{% endif %} & { permissionDenied: true };
  }
  const takenTargets = await prisma.{{ model }}.findMany({
    where: {
{% if oto.nullable %}
      {{ oto.prop_name }}: { not: null },
{% endif %}
      ...(current{{ parent_pascal }}Id ? { id: { not: current{{ parent_pascal }}Id } } : {}),
    },
    select: { {{ oto.prop_name }}: true },
  });
  const takenIds = takenTargets
    .map(r => r.{{ oto.prop_name }})
    .filter((id): id is string => id !== null);
  const safeLimit = Math.min(Math.max(Math.floor(limit) || 50, 1), 200);
  const rows = await prisma.{{ oto.target }}.findMany({
    where: takenIds.length > 0 ? { id: { notIn: takenIds } } : {},
    take: safeLimit,
    // Order by id — the target's "natural" label column varies per entity, and
    // we don't want to pull target-specific schema knowledge into the parent's
    // generated getter. id sort is stable and always present.
    orderBy: [{ id: 'asc' }],
{% if oto.available_include %}
    // Mirror the labelField path so the form's initial-options data carries
    // every relation the autocomplete label expression dereferences.
    include: { {{ oto.available_include }} },
    relationLoadStrategy: 'join',
{% endif %}
  });
{% if oto.available_needs_decimal %}
  // {{ oto.target }} carries a Decimal column (own or embedded), and these
  // rows are handed straight to a Client Component prop typed against the
  // generated interface (Decimal as string) — mirrors the relation_mapping
  // stringify done for {{ oto.target }} embeds elsewhere in this file.
  return deepStringifyDecimals(rows);
{% else %}
  return rows;
{% endif %}
}
