export async function get{{ parent_pascal }}ListPageData(isAssertPermission: boolean = true) {
{% if should_filter_by_org %}
  const userId = await getSessionUserIdOrThrow();
  const [{ permissions: userPermissions }, {{ parent_camel }}s] = await Promise.all([
    getModelPermissions('{{ parent }}', userId),
    getAll{{ parent_pascal }}s(userId),
  ]);
{% else %}
  const [{ permissions: userPermissions, userId }, {{ parent_camel }}s] = await Promise.all([
    getModelPermissions('{{ parent }}'),
    getAll{{ parent_pascal }}s(),
  ]);
{% endif %}
  if (isAssertPermission) {
    await assertPermission(userPermissions, 'read', '{{ parent }}');
  }
  // If the user lacks general read but has Creator/Assignee read, filter to their own items.
  const filtered{{ parent_pascal }}s = userPermissions.general.read
    ? {{ parent_camel }}s
    : {{ parent_camel }}s.filter(item =>
        (userPermissions.creator?.read && item.creator_id === userId) ||
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (userPermissions.assignee?.read && (item as any).assignee_id === userId)
      );
  return { {{ parent_camel }}s: filtered{{ parent_pascal }}s, userPermissions: await toPermissions(userPermissions) };
}

