// ---------------------------------------------------------------
// CSV Export (Phase 1) — returns one chunk of rows visible to this
// user (caller loops with increasing `skip` until an empty chunk),
// restricted to the same access scope as the list page (org / Creator /
// Assignee) and to an explicit export-column allowlist (system fields,
// FK id columns, and non-scalar columns are never included), with FK
// relations flattened to display values.
// ---------------------------------------------------------------
const EXPORT_CHUNK_SIZE = Number(process.env.EXPORT_CHUNK_SIZE ?? '200');

export async function get{{ parent_pascal }}ChunkForExport(
  userId: string,
  skip: number,
): Promise<Record<string, unknown>[]> {
{% if should_filter_by_org %}
  const { permissions } = await getModelPermissions('{{ parent }}', userId);
  const associatedOrganizations = await getAssociatedOrganizations(userId);
  const associatedOrganizationIds = associatedOrganizations.map((o) => o.id);
{% else %}
  // cmd_658: this branch used to omit userId, so getModelPermissions() fell
  // back to getSessionUserId() — silently reading the caller's browser
  // session cookie instead of the actor this function was called with. Every
  // export API test always authenticated via cy.login (a real session), so
  // this was invisible; switching those tests to X-API-Key (cmd_658, no
  // session cookie) exposed it as a real bug: an API-key-only caller with
  // genuine 'read' permission (already asserted by the route) got back
  // permissions: EMPTY_FLAGS here and silently exported zero rows.
  const { permissions } = await getModelPermissions('{{ parent }}', userId);
{% endif %}
  const accessAnd = await build{{ parent_pascal }}AccessWhere(permissions, userId{% if should_filter_by_org %}, associatedOrganizationIds{% endif %});
  const rows = await prisma.{{ model }}.findMany({
    where: { AND: accessAnd },
    orderBy: { created_at: 'asc' },
    skip,
    take: EXPORT_CHUNK_SIZE,
{% if include_props_list %}
    include: { {{ include_props_list }} },
{% endif %}
  });
  return rows.map((row) => {
    const result: Record<string, unknown> = {
{% for field in export_scalar_fields %}
{% if field in decimal_field_names %}
      // Decimal → string (precision-preserving; not Number()) so the CSV
      // cell holds the exact stored value, not a float-rounded one.
      '{{ field }}': (row as Record<string, unknown>)['{{ field }}'] != null ? String((row as Record<string, unknown>)['{{ field }}']) : (row as Record<string, unknown>)['{{ field }}'],
{% else %}
      '{{ field }}': (row as Record<string, unknown>)['{{ field }}'],
{% endif %}
{% endfor %}
    };
{% if is_self_only %}
    // x-self-only: creator_id is exported as a read-only diagnostic column —
    // it is never accepted back on import (see import_unimportable_columns).
    result['creator_id'] = (row as Record<string, unknown>)['creator_id'];
{% endif %}
{% for rel in x_relationships_list %}
    // Flatten {{ rel.field }}_id → display value (joined across all labelField
    // segments when composite/dotted). Always set so the CSV header stays
    // stable across chunks regardless of which row happens to come first.
    result['{{ rel.display_col }}'] = {{ rel.label_expr }};
{% endfor %}
    return result;
  });
}
{% endif %}
