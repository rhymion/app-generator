/**
 * Returns {{ oto.target }} records not already linked to another {{ parent }}.
 * Pass current{{ parent_pascal }}Id when editing so the current {{ parent }}'s {{ oto.target }} stays available.
 */
export async function getAvailable{{ oto.target | pascal_case }}sFor{{ parent_pascal }}(current{{ parent_pascal }}Id?: string | null) {
  const takenTargets = await prisma.{{ model }}.findMany({
    where: {
{% if oto.nullable %}
      {{ oto.prop_name }}: { not: null },
{% endif %}
      ...(current{{ parent_pascal }}Id ? { id: { not: current{{ parent_pascal }}Id } } : {}),
    },
    select: { {{ oto.prop_name }}: true },
  });
  const takenIds = new Set(
    takenTargets.map(r => r.{{ oto.prop_name }}).filter((id): id is string => id !== null),
  );
  const all{{ oto.target | pascal_case }}s = await getAll{{ oto.target | pascal_case }}s();
  return all{{ oto.target | pascal_case }}s.filter(item => !takenIds.has(item.id));
}
