const FILTERABLE_FIELDS = new Set<string>([{{ filterable_fields_quoted }}]);

/** Build the where clauses that enforce read scope (org + Creator/Assignee{% if is_self_only %} / self-only{% endif %}). */
async function build{{ parent_pascal }}AccessWhere(
  perms: RichPermissions,
  userId: string | null,
{% if should_filter_by_org %}
  associatedOrganizationIds: string[],
{% endif %}
): Promise<Record<string, unknown>[]> {
  const and: Record<string, unknown>[] = [];
{% if should_filter_by_org %}
{% if org_relationship_optional %}
  and.push({ OR: [{ organization_id: { in: associatedOrganizationIds } }, { organization_id: null }] });
{% else %}
  and.push({ organization_id: { in: associatedOrganizationIds } });
{% endif %}
{% endif %}
{% if is_self_only %}
  // x-self-only: creator_id is unconditional — no permission setting
  // (general.read, Creator/Assignee role) can widen or bypass it.
  if (!userId) {
    and.push({ id: '__no_access__' });
{% if self_only_admin_bypass %}
  } else if (await trySelfOnlyAdminBypass('{{ parent }}', userId)) {
    // Bypass granted (and audited) — no creator_id restriction.
{% endif %}
  } else {
    and.push({ creator_id: userId });
  }
{% else %}
  if (!perms.general.read) {
    const or: Record<string, unknown>[] = [];
    if (perms.creator?.read && userId) or.push({ creator_id: userId });
{% if has_assignee_id %}
    if (perms.assignee?.read && userId) or.push({ assignee_id: userId });
{% endif %}
    if (or.length === 0) {
      // No read scope at all — force empty result without throwing here.
      and.push({ id: '__no_access__' });
    } else {
      and.push({ OR: or });
    }
  }
{% endif %}
  return and;
}

export async function get{{ parent_pascal }}Detail(id: string{% if should_filter_by_org or is_self_only %}, userId: string{% endif %}): Promise<{{ parent_pascal }}Detail | null> {
{% if should_filter_by_org %}
  const associatedOrganizations = await getAssociatedOrganizations(userId);
  const associatedOrganizationIds = associatedOrganizations.map((organization) => organization.id);
{% endif %}
{% if is_self_only and self_only_admin_bypass %}
  const _selfOnlyBypass = await trySelfOnlyAdminBypass('{{ parent }}', userId);
{% endif %}
  const {{ parent_camel }} = await prisma.{{ model }}.{% if should_filter_by_org or is_self_only %}findFirst{% else %}findUnique{% endif %}({
    where: {
      id,
{% if should_filter_by_org %}
{% if org_relationship_optional %}
      OR: [{ organization_id: { in: associatedOrganizationIds } }, { organization_id: null }],
{% else %}
      organization_id: { in: associatedOrganizationIds },
{% endif %}
{% endif %}
{% if is_self_only %}
{% if self_only_admin_bypass %}
      ...(!_selfOnlyBypass ? { creator_id: userId } : {}),
{% else %}
      creator_id: userId,
{% endif %}
{% endif %}
    },
{% if include_props_detail %}
    include: {
      {{ include_props_detail }}
    },
{% endif %}
  });

  if (!{{ parent_camel }}) {
    return null;
  }

{% if named_constants and has_commentable %}
  // NOTE (cmd_522c): `message` here is the RAW stored string — @[user_id:<id>]
  // markers intact, never decoded to plain names server-side in this shared
  // getter. get{{ parent_pascal }}Detail() is consumed both by the REST API
  // route (which decodes to plain text for its JSON contract — see
  // api_detail_route.ts.jinja2) and by get{{ parent_pascal }}DetailPageData()
  // (which exposes the raw text + a mentionUserContext id→name map to
  // FormView, so <MentionText> can render per-mention links). Decoding here
  // would destroy the ids MentionText needs and force the two consumers to
  // diverge some other way.
  const _commentable = {{ parent_camel }}.{{ commentable_rel_name }} ? {
    ...{{ parent_camel }}.{{ commentable_rel_name }},
    comments: {{ parent_camel }}.{{ commentable_rel_name }}.comments.map((c) => {
      const { reactions, ...rest } = c;
      const reactionCounts = reactions.reduce<Array<{ type: {{ reaction_value_type }}; count: number }>>(
        (acc, r) => {
          const entry = acc.find((e) => e.type === r.type);
          if (entry) entry.count += 1;
          else acc.push({ type: r.type, count: 1 });
          return acc;
        },
        [],
      );
      return { ...rest, reactionCounts, myReactionTypes: [] as ({{ reaction_value_type }})[] };
    }),
  } : {{ parent_camel }}.{{ commentable_rel_name }};
{% endif %}
{% if has_attachable %}
  // encrypted_original_name/name_iv are Prisma-only columns pulled in by the
  // generic `{{ attachable_attachments_prop }}: true` include — decrypt to the
  // display name and strip both fields here so the ciphertext/IV never cross
  // into FormView/FormUpsert (client components) via the `src` prop (cmd_356).
  const _{{ attachable_rel_name }} = {{ parent_camel }}.{{ attachable_rel_name }} ? {
    ...{{ parent_camel }}.{{ attachable_rel_name }},
    {{ attachable_attachments_prop }}: (
      {{ parent_camel }}.{{ attachable_rel_name }}.{{ attachable_attachments_prop }} as unknown as Array<
        { id: string; type: {{ attachment_type_ts }}; order: number; name: string; path: string; attachable_id: string; encrypted_original_name?: string | null; name_iv?: string | null }
      >
    ).map((raw) => {
      const { encrypted_original_name, name_iv, ...rest } = raw;
      let displayName = rest.name;
      if (encrypted_original_name) {
        try {
          displayName = decryptFileName(encrypted_original_name);
        } catch (e) {
          // Legacy/rotated-key records: fall back to the stored (UUID) name
          // rather than throwing and breaking the whole detail page.
          console.warn('attachment name decrypt failed:', e instanceof Error ? e.message : e);
        }
      }
      return { ...rest, name: displayName };
    }),
  } : {{ parent_camel }}.{{ attachable_rel_name }};
{% endif %}
  return {
    ...{{ parent_camel }},
{% for rel in reverse_oto_rels if rel.relation_name != rel.prop_name %}
    {{ rel.prop_name }}: {{ parent_camel }}.{{ rel.relation_name }},
{% endfor %}
{% for rel in flatten_rels if rel.relation_name != rel.prop_name %}
    {{ rel.prop_name }}: {{ parent_camel }}.{{ rel.relation_name }},
{% endfor %}
{% if named_constants and has_commentable %}
    {{ commentable_rel_name }}: _commentable,
{% endif %}
{% if has_attachable %}
    {{ attachable_rel_name }}: _{{ attachable_rel_name }},
{% endif %}
{% for dtcol in datetime_display_columns %}
    {{ dtcol }}: {{ parent_camel }}.{{ dtcol }}
      ? {{ parent_camel }}.{{ dtcol }}.toISOString().replace('T', ' ').slice(0, 19)
      : '',
{% endfor %}
{% for dcol in decimal_display_columns %}
    // Decimal columns arrive from Prisma as decimal.js instances, not a
    // plain value the Server-to-Client Component boundary can serialize —
    // stringify here (precision-preserving; no JS float conversion) rather
    // than passing the raw instance through the `...{{ parent_camel }}` spread.
    {{ dcol }}: {{ parent_camel }}.{{ dcol }} !== null && {{ parent_camel }}.{{ dcol }} !== undefined ? {{ parent_camel }}.{{ dcol }}.toString() : {{ parent_camel }}.{{ dcol }},
{% endfor %}
{% if bridge_child_ir and bridge_parent_options %}
    parent_type: (() => {
{% for bpo in bridge_parent_options %}
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      if ((({{ parent_camel }} as any).{{ bridge_child_ir.name }})?.{{ bpo.target }}) return '{{ bpo.target }}';
{% endfor %}
      return null;
    })(),
    parent_label: (() => {
{% for bpo in bridge_parent_options %}
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      if ((({{ parent_camel }} as any).{{ bridge_child_ir.name }})?.{{ bpo.target }}) return String((({{ parent_camel }} as any).{{ bridge_child_ir.name }})?.{{ bpo.target }}.{{ bpo.label_field }} ?? '');
{% endfor %}
      return null;
    })(),
{% endif %}
  };
}

export async function get{{ parent_pascal }}DetailPageData(id: string, operation: Operation = 'read') {
{% if should_filter_by_org or is_self_only %}
  const userId = await getSessionUserIdOrThrow();
  const [{{ parent_camel }}, { permissions: basePermissions }] = await Promise.all([
    get{{ parent_pascal }}Detail(id, userId),
    getModelPermissions('{{ parent }}', userId),
  ]);
{% else %}
  const [{{ parent_camel }}, { permissions: basePermissions, userId }] = await Promise.all([
    get{{ parent_pascal }}Detail(id),
    getModelPermissions('{{ parent }}'),
  ]);
{% endif %}
  const resolved = await resolvePermissions(basePermissions, {{ parent_camel }}, userId ?? '');
  await assertPermission(resolved, operation, '{{ parent }}');
{% if comment_has_mention %}
  // canViewUserProfile (cmd_522): whether the viewer may link mentioned users'
  // names to their profile page — passed to the comment display component
  // rather than baked into the row itself, since it reflects the *viewer's*
  // permissions on the `user` model, not any property of {{ parent }}.
  const { permissions: _mentionUserPerms } = await getModelPermissions('user', userId ?? null);
  // mentionUserContext (cmd_522c): id → display name map for every user
  // referenced (as creator or @mention) in this row's comment thread(s) —
  // built here (not inside get{{ parent_pascal }}Detail()) so it stays out of
  // the REST API's JSON contract and only reaches the page/FormView path.
  const _mentionUserIds = new Set<string>();
{% if named_constants and has_commentable %}
  for (const c of {{ parent_camel }}?.{{ commentable_rel_name }}?.comments ?? []) {
    if (c.creator?.id) _mentionUserIds.add(c.creator.id);
    for (const uid of extractMentionedUserIds(c.message)) _mentionUserIds.add(uid);
  }
{% endif %}
{% for child in children_raw %}
{% if child.output_type == 'comments' %}
  for (const c of {{ parent_camel }}?.{{ child.property_name }} ?? []) {
    if (c.creator?.id) _mentionUserIds.add(c.creator.id);
    for (const uid of extractMentionedUserIds(c.message)) _mentionUserIds.add(uid);
  }
{% endif %}
{% endfor %}
  const _mentionUsersForPage = _mentionUserIds.size
    ? await prisma.user.findMany({ where: { id: { in: [..._mentionUserIds] } }, select: { id: true, name: true } })
    : [];
  const mentionUserContext: UserContext = Object.fromEntries(_mentionUsersForPage.map((u) => [u.id, u.name]));
  return {
    {{ parent_camel }},
    userPermissions: await toPermissions(resolved),
    canViewUserProfile: _mentionUserPerms.read,
    mentionUserContext,
  };
{% else %}
  return { {{ parent_camel }}, userPermissions: await toPermissions(resolved) };
{% endif %}
}

