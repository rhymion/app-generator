// Mobile data access for {{ pascal }}: the same function names the Web
// getters / Server Actions have, implemented as REST calls against the routes
// under /api/{{ name }}. Those routes call the same service functions the Web
// Server Actions call, so no business logic lives here.
import { apiFetch, ApiError } from '@/lib/api-base';
import type { ActionCreated, ActionFailure } from '@/lib/_errors';
import type { ModelPermissions } from '@/lib/authz';
import {
{% if has_approval %}
  fetchApprovalState,
{% endif %}
  buildQuery,
  bulkDelete,
  fetchPermissions,
  formDataToBody,
{% if split %}
  postSplit,
{% endif %}
  toActionFailure,
  type BulkDeleteResult,
{% if has_approval %}
  type ApprovalState,
{% endif %}
  type FieldSpec,
  type PageOpts,
  type PageResult,
{% if split %}
  type SplitConfig,
  type SplitFailure,
{% endif %}
} from '@/lib/entity-http';

export type {{ pascal }} = { id: string } & Record<string, unknown>;
{% if is_payment %}

/** A created record, with the hosted checkout URL the buyer is sent to. */
export type CheckoutCreated = ActionCreated & { checkoutUrl?: string };
{% endif %}

export const {{ const_name }}_FIELDS: FieldSpec[] = {{ fields_json }};

/**
 * What the list's sort and filter panel can name: the fields plus the relation display columns
 * (a foreign key sorts and filters by the related record's label), which the form does not draw.
 */
export const {{ const_name }}_QUERY_FIELDS: FieldSpec[] = [...{{ const_name }}_FIELDS, ...({{ relation_columns_json }} as FieldSpec[])];

/** Keys of the columns shown on a list row; the first is the row's title. */
export const {{ const_name }}_LIST_KEYS: string[] = {{ list_keys_json }};

/** Keys the REST list can sort on, filter on, and the one the search box matches. */
export const {{ const_name }}_SORT_KEYS: string[] = {{ sort_keys_json }};
export const {{ const_name }}_FILTER_KEYS: string[] = {{ filter_keys_json }};
export const {{ const_name }}_SEARCH_KEY: string | null = {{ search_key_json }};

export async function fetch{{ pascal }}Page(opts: PageOpts = {}): Promise<PageResult<{{ pascal }}>> {
  return apiFetch<PageResult<{{ pascal }}>>(`/api/{{ name }}${buildQuery(opts)}`);
}

{% if can_view or can_edit %}
export async function get{{ pascal }}Detail(id: string): Promise<{{ pascal }} | null> {
  try {
    return await apiFetch<{{ pascal }}>(`/api/{{ name }}/${id}`);
  } catch (err) {
    if (err instanceof ApiError && err.status === 404) return null;
    throw err;
  }
}

{% endif %}
{% if can_new or can_edit %}
/**
 * Creates the record, or updates it when `formData` carries an `id`. Resolves
 * to `{ ok: true, id }` on success and to an ActionFailure otherwise; it never
 * rejects.
 */
export async function upsert{{ pascal }}(formData: FormData): Promise<ActionFailure | {{ 'CheckoutCreated' if is_payment else 'ActionCreated' }}> {
  const body = formDataToBody(formData, {{ const_name }}_FIELDS);
  const id = formData.get('id');
  try {
{% if can_edit %}
    if (id) {
      await apiFetch(`/api/{{ name }}/${id}`, { method: 'PUT', body: JSON.stringify(body) });
      return { ok: true, id: String(id) };
    }
{% endif %}
{% if can_new %}
{% if is_payment %}
    // x-payment: the create route answers { record, checkoutUrl }.
    const created = await apiFetch<{ record: { id: string }; checkoutUrl?: string }>('/api/{{ name }}', { method: 'POST', body: JSON.stringify(body) });
    return { ok: true, id: created.record.id, checkoutUrl: created.checkoutUrl };
{% else %}
    const created = await apiFetch<{ id: string }>('/api/{{ name }}', { method: 'POST', body: JSON.stringify(body) });
    return { ok: true, id: created.id };
{% endif %}
{% else %}
    return { ok: false, errorCode: 'PERMISSION_DENIED' };
{% endif %}
  } catch (err) {
    return toActionFailure(err);
  }
}

{% endif %}
{% if can_delete %}
/** Deletes the records. Resolves to an ActionFailure, or `{ ok: true }`; never rejects. */
export async function remove{{ pascal }}(ids: string[]): Promise<ActionFailure | { ok: true }> {
  try {
    for (const id of ids) {
      await apiFetch(`/api/{{ name }}/${id}`, { method: 'DELETE' });
    }
    return { ok: true };
  } catch (err) {
    return toActionFailure(err);
  }
}


/** Deletes several records in one call; the result lists the ids removed and a failure per refused id. */
export function bulkRemove{{ pascal }}(ids: string[]): Promise<BulkDeleteResult> {
  return bulkDelete('{{ name }}', ids);
}

{% endif %}
/** The caller's flags for this entity, overlaid with the row's own when an id is given. */
export function get{{ pascal }}Permissions(id?: string): Promise<ModelPermissions> {
  return fetchPermissions('{{ name }}', id);
}
{% if has_approval %}

/** Who may approve, reject or withdraw this record's current round, as the server answers it. */
export function get{{ pascal }}ApprovalState(id: string): Promise<ApprovalState | null> {
  return fetchApprovalState('{{ name }}', id);
}
{% endif %}
{% if split %}

export const {{ const_name }}_SPLIT: SplitConfig = {{ split_json }};

/** Splits the record into the given parts (`POST /api/{{ name }}/<id>/actions/split`). */
export function split{{ pascal }}(id: string, parts: Record<string, unknown>[]): Promise<SplitFailure | { ok: true }> {
  return postSplit('{{ name }}', id, parts);
}
{% endif %}
