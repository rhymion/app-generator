import { useState } from 'react';
import { router } from 'expo-router';
import { Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';
import { NavIcon } from '@/components/NavIcon';
import { SEARCH_TAB } from '@/lib/nav';
import type { NavNode, SearchTab } from '@/lib/nav';
import { useLocale } from '@/lib/locale';
import { useNav } from '@/lib/nav-context';

type Tab = NavNode | SearchTab;

function tabId(tab: Tab): string {
  if (tab.kind === 'group') return tab.slug;
  if (tab.kind === 'link') return tab.entity;
  return 'search';
}

function hrefOf(tab: Tab): string {
  if (tab.kind === 'group') return `/section/${tab.slug}`;
  if (tab.kind === 'link') return `/entity/${tab.entity}`;
  return '/search';
}

/**
 * Footer tab bar: icon first, small label below. The bar scrolls
 * horizontally, so every tab stays reachable however many there are.
 */
export function FooterBar() {
  const { tabs } = useNav();
  const { labelOf } = useLocale();
  const [activeKey, setActiveKey] = useState<string | null>(null);
  const allTabs: Tab[] = SEARCH_TAB ? [...tabs, SEARCH_TAB] : tabs;

  return (
    <View style={styles.bar} testID="footer-bar">
      <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={styles.content}>
        {allTabs.map((tab) => {
          const active = activeKey === tab.key;
          return (
            <Pressable
              key={tab.key}
              testID={`footer-tab-${tabId(tab)}`}
              accessibilityRole="button"
              accessibilityLabel={labelOf(tab)}
              style={[styles.tab, active ? styles.tabActive : null]}
              onPress={() => {
                setActiveKey(tab.key);
                router.navigate(hrefOf(tab) as never);
              }}
            >
              <NavIcon icon={tab.icon} color={active ? '#2563eb' : '#374151'} />
              <Text numberOfLines={1} style={[styles.label, active ? styles.labelActive : null]}>
                {labelOf(tab)}
              </Text>
            </Pressable>
          );
        })}
      </ScrollView>
    </View>
  );
}

const styles = StyleSheet.create({
  bar: { borderTopWidth: 1, borderTopColor: '#e5e7eb', backgroundColor: '#ffffff' },
  content: { paddingHorizontal: 4 },
  tab: { width: 76, paddingVertical: 8, alignItems: 'center', gap: 2 },
  tabActive: { borderTopWidth: 2, borderTopColor: '#2563eb' },
  label: { fontSize: 10, color: '#374151', maxWidth: 70 },
  labelActive: { color: '#2563eb' },
});
