import { StyleSheet, Text } from 'react-native';
import { webOriginMismatch } from '@/lib/web-origin';

/** On web, tells the user to open the app from the API's origin when this page was opened from another one. */
export function WebOriginHint() {
  const apiOrigin = webOriginMismatch();
  if (!apiOrigin) return null;
  return (
    <Text testID="web-origin-hint" style={styles.hint}>
      This page was opened from a different address than the server. Open {apiOrigin} instead.
    </Text>
  );
}

const styles = StyleSheet.create({
  hint: { color: '#92400e', fontSize: 13 },
});
