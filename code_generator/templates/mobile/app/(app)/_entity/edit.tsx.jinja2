import { useEffect, useState } from 'react';
import { useLocalSearchParams, router } from 'expo-router';
import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import {
  View,
  Text,
  TextInput,
  Pressable,
  ScrollView,
  ActivityIndicator,
  Alert,
  StyleSheet,
{% if mobile_toggle_fields %}
  Switch,
{% endif %}
} from 'react-native';
import {
  fetch{{ label }}ById,
  create{{ label }},
  update{{ label }},
{% for rel in mobile_m2m_relations %}
  fetch{{ rel.label }}Autocomplete,
{% endfor %}
{% for rel in mobile_fk_relations %}
  fetch{{ rel.label }}Autocomplete,
{% endfor %}
} from '@/lib/{{ snake_name }}-api';
{% if mobile_m2m_relations or mobile_fk_relations %}
import { MobilePicker, MobilePickerItem } from '@/components/MobilePicker';
{% endif %}

export default function {{ label }}EditScreen() {
  const { id } = useLocalSearchParams<{ id?: string }>();
  const isEdit = !!id;
  const queryClient = useQueryClient();

  const [name, setName] = useState('');
{% if has_description %}
  const [description, setDescription] = useState('');
{% endif %}
{% for field in mobile_toggle_fields %}
  const [{{ field.var_name }}, {{ field.setter_name }}] = useState(false);
{% endfor %}
{% for rel in mobile_m2m_relations %}
  const [selected{{ rel.label }}Ids, setSelected{{ rel.label }}Ids] = useState<string[]>([]);
  const [{{ rel.snake }}Options, set{{ rel.label }}Options] = useState<MobilePickerItem[]>([]);
{% endfor %}
{% for rel in mobile_fk_relations %}
  const [selected{{ rel.label }}Ids, setSelected{{ rel.label }}Ids] = useState<string[]>([]);
  const [{{ rel.snake }}Options, set{{ rel.label }}Options] = useState<MobilePickerItem[]>([]);
{% endfor %}

  const { data, isLoading } = useQuery({
    queryKey: ['{{ snake_name }}', id],
    queryFn: () => fetch{{ label }}ById(id as string),
    enabled: isEdit,
  });

  useEffect(() => {
    if (data) {
      setName(data.name ?? '');
{% if has_description %}
      setDescription(data.description ?? '');
{% endif %}
{% for field in mobile_toggle_fields %}
      {{ field.setter_name }}(Boolean(data.{{ field.name }}));
{% endfor %}
{% for rel in mobile_m2m_relations %}
      setSelected{{ rel.label }}Ids(data.{{ rel.prop }}.map((item) => item.id));
{% endfor %}
{% for rel in mobile_fk_relations %}
      setSelected{{ rel.label }}Ids(data.{{ rel.prop }} ? [data.{{ rel.prop }}] : []);
{% endfor %}
    }
  }, [data]);
{% for rel in mobile_m2m_relations %}

  useEffect(() => {
    fetch{{ rel.label }}Autocomplete().then(set{{ rel.label }}Options).catch(() => {});
  }, []);
{% endfor %}
{% for rel in mobile_fk_relations %}

  useEffect(() => {
    fetch{{ rel.label }}Autocomplete().then(set{{ rel.label }}Options).catch(() => {});
  }, []);
{% endfor %}

  const mutation = useMutation({
    mutationFn: async () => {
      const input = {
        name,
{% if has_description %}
        description: description || null,
{% endif %}
{% for field in mobile_toggle_fields %}
        {{ field.name }}: {{ field.var_name }},
{% endfor %}
{% for rel in mobile_m2m_relations %}
        {{ rel.ids_field }}: selected{{ rel.label }}Ids, // always explicit — never omit (cmd_366 guard)
{% endfor %}
{% for rel in mobile_fk_relations %}
        {{ rel.prop }}: selected{{ rel.label }}Ids[0] ?? null,
{% endfor %}
      };
      if (isEdit) {
        await update{{ label }}(id as string, input);
      } else {
        await create{{ label }}(input);
      }
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['{{ snake_name }}-list'] });
      router.replace('/(app)/{{ snake_name }}/');
    },
    onError: (error: unknown) => {
      Alert.alert('Error', error instanceof Error ? error.message : 'Something went wrong.');
    },
  });

  if (isEdit && isLoading) {
    return (
      <View style={styles.center}>
        <ActivityIndicator />
      </View>
    );
  }

  return (
    <ScrollView style={styles.container} contentContainerStyle={styles.content}>
      <Text style={styles.label}>Name</Text>
      <TextInput style={styles.input} value={name} onChangeText={setName} placeholder="Name" />
{% if has_description %}
      <Text style={styles.label}>Description</Text>
      <TextInput
        style={[styles.input, styles.multiline]}
        value={description}
        onChangeText={setDescription}
        placeholder="Description"
        multiline
      />
{% endif %}
{% for field in mobile_toggle_fields %}
      <View style={styles.toggleRow}>
        <Text style={styles.label}>{{ field.label }}</Text>
        <Switch value={ {{ field.var_name }} } onValueChange={ {{ field.setter_name }} } />
      </View>
{% endfor %}
{% for rel in mobile_m2m_relations %}
      <MobilePicker
        label="{{ rel.label }}s"
        items={ {{ rel.snake }}Options }
        value={selected{{ rel.label }}Ids}
        onChange={setSelected{{ rel.label }}Ids}
        onSearch={(q) => fetch{{ rel.label }}Autocomplete(q).then(set{{ rel.label }}Options).catch(() => {})}
        multi
      />
{% endfor %}
{% for rel in mobile_fk_relations %}
      <MobilePicker
        label="{{ rel.label }}"
        items={ {{ rel.snake }}Options }
        value={selected{{ rel.label }}Ids}
        onChange={setSelected{{ rel.label }}Ids}
        onSearch={(q) => fetch{{ rel.label }}Autocomplete(q).then(set{{ rel.label }}Options).catch(() => {})}
        multi={false}
      />
{% endfor %}
      <Pressable
        style={styles.button}
        onPress={() => mutation.mutate()}
        disabled={mutation.isPending || !name.trim()}
      >
        <Text style={styles.buttonText}>{mutation.isPending ? 'Saving…' : 'Save'}</Text>
      </Pressable>
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1 },
  center: { flex: 1, alignItems: 'center', justifyContent: 'center' },
  content: { padding: 16, gap: 8 },
  label: { fontSize: 13, color: '#666', marginTop: 8 },
  input: {
    borderWidth: 1,
    borderColor: '#ccc',
    borderRadius: 8,
    padding: 12,
    fontSize: 16,
  },
  multiline: { minHeight: 80, textAlignVertical: 'top' },
  toggleRow: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
    marginTop: 8,
  },
  button: {
    backgroundColor: '#2563eb',
    borderRadius: 8,
    padding: 14,
    alignItems: 'center',
    marginTop: 20,
  },
  buttonText: { color: '#fff', fontSize: 16, fontWeight: '600' },
});
