import { useState } from 'react';
import { router } from 'expo-router';
import { FlatList, Pressable, StyleSheet, Text, TextInput, View } from 'react-native';
import { apiFetch } from '@/lib/api-base';
import { ENTITY_SCREENS } from '@/lib/entity-registry';
import { useMessages } from '@/lib/messages';

/** Search result entity type -> the EntityLabel key that names it. */
const LABEL_KEYS: Record<string, string> = {{ search_labels_json }};

type SearchResult = { entity_type: string; id: string; snippet: string; rank: number };
type SearchPage = { results: SearchResult[]; total: number };

/** The snippet with the server's match markers (<<< >>>) turned into bold runs. */
function Snippet({ text }: { text: string }) {
  const parts = text.split(/(<<<|>>>)/);
  let marked = false;
  const runs: { text: string; marked: boolean }[] = [];
  for (const part of parts) {
    if (part === '<<<') marked = true;
    else if (part === '>>>') marked = false;
    else if (part) runs.push({ text: part, marked });
  }
  return (
    <Text style={styles.rowSnippet} numberOfLines={2}>
      {runs.map((run, i) => (run.marked ? <Text key={i} style={styles.match}>{run.text}</Text> : run.text))}
    </Text>
  );
}

/**
 * Cross-entity search (GET /api/search), reached from the fixed footer tab. A result opens the record's
 * detail screen, or the entity list when the entity has no detail screen; an entity without native
 * screens is marked and does not navigate.
 */
export default function SearchScreen() {
  const { t, tmsg } = useMessages();
  const [query, setQuery] = useState('');
  const [results, setResults] = useState<SearchResult[] | null>(null);
  const [error, setError] = useState<string | null>(null);

  async function run() {
    const q = query.trim();
    if (q.length < 2) {
      setError(t('Search.minLength'));
      return;
    }
    setError(null);
    try {
      const page = await apiFetch<SearchPage>(`/api/search?q=${encodeURIComponent(q)}`);
      setResults(page.results);
    } catch {
      setError(t('Search.failed'));
    }
  }

  return (
    <View style={styles.container} testID="search-screen">
      <TextInput
        style={styles.input}
        value={query}
        onChangeText={setQuery}
        onSubmitEditing={run}
        placeholder={t('Common.search')}
        returnKeyType="search"
        autoCapitalize="none"
        autoCorrect={false}
        testID="search-input"
      />
      {error ? <Text style={styles.error} testID="search-error">{error}</Text> : null}
      <FlatList
        data={results ?? []}
        keyExtractor={(item) => `${item.entity_type}:${item.id}`}
        ListEmptyComponent={
          results ? <Text style={styles.empty} testID="search-empty">{t('Search.noResults')}</Text> : undefined
        }
        renderItem={({ item }) => {
          const screens = ENTITY_SCREENS[item.entity_type];
          const labelKey = `EntityLabel.${LABEL_KEYS[item.entity_type] ?? item.entity_type}`;
          const label = tmsg.has(labelKey) ? tmsg(labelKey) : screens?.title ?? item.entity_type;
          const href = screens
            ? screens.View
              ? `/entity/${item.entity_type}/${item.id}`
              : `/entity/${item.entity_type}`
            : null;
          return (
            <Pressable
              style={[styles.row, !href && styles.rowDisabled]}
              disabled={!href}
              onPress={() => href && router.push(href as never)}
              testID={`search-result-${item.entity_type}`}
            >
              <Text style={styles.rowType}>{label}</Text>
              <Snippet text={item.snippet} />
              {!href ? (
                <Text style={styles.unavailable} testID={`search-result-unavailable-${item.entity_type}`}>
                  {t('Search.notAvailable')}
                </Text>
              ) : null}
            </Pressable>
          );
        }}
      />
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1 },
  input: { margin: 12, borderWidth: 1, borderColor: '#ccc', borderRadius: 8, padding: 10, fontSize: 16 },
  error: { marginHorizontal: 12, color: '#b91c1c' },
  empty: { textAlign: 'center', color: '#666', marginTop: 24 },
  row: { paddingHorizontal: 16, paddingVertical: 12, borderBottomWidth: 1, borderBottomColor: '#eee' },
  rowType: { fontSize: 12, color: '#6b7280' },
  rowDisabled: { opacity: 0.6 },
  rowSnippet: { fontSize: 15 },
  match: { fontWeight: '700' },
  unavailable: { fontSize: 12, color: '#b45309', marginTop: 2 },
});
