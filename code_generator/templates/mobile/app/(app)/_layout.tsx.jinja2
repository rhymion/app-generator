import { useEffect, useState } from 'react';
import { Redirect, Tabs } from 'expo-router';
import { View, ActivityIndicator, StyleSheet } from 'react-native';
import { getRefreshToken } from '@/lib/token-storage';

export default function AppLayout() {
  const [checking, setChecking] = useState(true);
  const [authenticated, setAuthenticated] = useState(false);

  useEffect(() => {
    // Presence-only check, same as the old API-key guard: a stored refresh
    // token means "has a session worth trying". Actual validity (expired /
    // revoked) is enforced per-request by apiFetch's 401 + refresh handling
    // in lib/api-base.ts, not here.
    getRefreshToken().then((token) => {
      setAuthenticated(!!token);
      setChecking(false);
    });
  }, []);

  if (checking) {
    return (
      <View style={styles.center}>
        <ActivityIndicator />
      </View>
    );
  }

  if (!authenticated) {
    return <Redirect href="/login" />;
  }

  return (
    <Tabs screenOptions={ { headerShown: false } }>
      <Tabs.Screen name="index" options={ { title: 'Home' } } />
{% for entity in mobile_entities %}
      <Tabs.Screen name="{{ entity.entity_name }}" options={ { title: '{{ entity.plural_label }}' } } />
{% endfor %}
    </Tabs>
  );
}

const styles = StyleSheet.create({
  center: { flex: 1, alignItems: 'center', justifyContent: 'center' },
});
