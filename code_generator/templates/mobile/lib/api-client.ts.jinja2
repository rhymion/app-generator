import { apiFetch } from './api-base';

export interface {{ label }} {
  {{ pk_field }}: string;
{% for field in display_fields %}
  {{ field.name }}: {{ field.ts_type }};
{% endfor %}
{% for rel in mobile_m2m_relations %}
  {{ rel.prop }}: { id: string }[];
{% endfor %}
}

export interface {{ label }}PageResult {
  rows: {{ label }}[];
  total: number;
  page: number;
  pageSize: number;
}

export interface {{ label }}Input {
{% for field in edit_fields %}
  {{ field.name }}: {{ field.ts_type }};
{% endfor %}
{% for rel in mobile_m2m_relations %}
  {{ rel.ids_field }}: string[];
{% endfor %}
}
{% if mobile_m2m_relations %}

export interface AutocompleteItem {
  id: string;
  label: string;
}
{% endif %}

export async function fetch{{ label }}List(page = 0, pageSize = 50): Promise<{{ label }}PageResult> {
  return apiFetch<{{ label }}PageResult>(`{{ api_path }}?page=${page}&pageSize=${pageSize}`);
}

export async function fetch{{ label }}ById(id: string): Promise<{{ label }}> {
  return apiFetch<{{ label }}>(`{{ api_path }}/${id}`);
}

export async function create{{ label }}(input: {{ label }}Input): Promise<{ id: string }> {
  return apiFetch<{ id: string }>(`{{ api_path }}`, {
    method: 'POST',
    body: JSON.stringify(input),
  });
}

export async function update{{ label }}(id: string, input: {{ label }}Input): Promise<{ success: boolean }> {
  return apiFetch<{ success: boolean }>(`{{ api_path }}/${id}`, {
    method: 'PUT',
    body: JSON.stringify(input),
  });
}

export async function delete{{ label }}(id: string): Promise<void> {
  return apiFetch<void>(`{{ api_path }}/${id}`, {
    method: 'DELETE',
  });
}
{% for rel in mobile_m2m_relations %}

export async function fetch{{ rel.label }}Autocomplete(q = ''): Promise<AutocompleteItem[]> {
  return apiFetch<AutocompleteItem[]>(`{{ rel.api_path }}/autocomplete?q=${encodeURIComponent(q)}`);
}
{% endfor %}
