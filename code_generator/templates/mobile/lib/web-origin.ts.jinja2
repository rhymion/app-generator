import { Platform } from 'react-native';

const BASE_URL = process.env.EXPO_PUBLIC_API_BASE_URL ?? '';

/**
 * The origin the Expo web build should be opened from, or null when nothing needs saying.
 *
 * The REST routes send no CORS headers, so a browser only reaches the API when the page is served from the same origin
 * as `EXPO_PUBLIC_API_BASE_URL` (the same-origin proxy). Opening the bundle from the dev server's own port (the one Expo
 * opens automatically) makes every request fail in the browser. Native builds are not subject to CORS, and a relative
 * base URL is always same-origin, so both return null. This only explains a failure; it never grants or hides anything.
 */
export function webOriginMismatch(pageOrigin?: string): string | null {
  if (Platform.OS !== 'web') return null;
  const page = pageOrigin ?? (typeof window !== 'undefined' ? window.location.origin : '');
  if (!page || !/^https?:\/\//.test(BASE_URL)) return null;
  try {
    const apiOrigin = new URL(BASE_URL).origin;
    return apiOrigin === page ? null : apiOrigin;
  } catch {
    return null;
  }
}
