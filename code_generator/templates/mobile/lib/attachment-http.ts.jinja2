// Direct attachment fields: the file is stored through POST /api/upload, which answers with the id of the
// attachment it created; POST /api/attachment/direct then prepares that id for the field. The form
// submits the id with the entity, as the Web form does (components/_standard/SingleAttachmentUpload.tsx,
// mode 'fk').
// Bridge attachments (an entity that owns attachments through `attachable`): the file is stored through
// POST /api/upload and the record's whole set of ids is saved through PUT /api/<entity>/<id>/attachments.
// A stored file is read from GET /api/attachments/<id> with the access token (see fetchAttachmentBlob).
import { ApiError, apiFetch, authorizedImageSource, resolveApiUrl } from './api-base';
import { toActionFailure } from './entity-http';
import type { ActionFailure } from './_errors';

/** The attachment row the REST detail embeds under a field's relation name; the create route answers with the same shape. */
export type AttachmentRow = { id: string; name: string; path: string; type: string };

/** A file chosen with the system picker; `file` is set on the web build only. */
export type PickedFile = { uri: string; name: string; mimeType?: string | null; file?: Blob | null };

/** The file types `/api/upload` accepts (it refuses anything else). */
export const ATTACHMENT_MIME_TYPES = [
  'image/jpeg', 'image/png', 'image/gif', 'image/webp',
  'application/pdf',
  'application/msword',
  'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
  'application/vnd.ms-excel',
  'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
  'text/csv',
  'text/plain',
  'application/zip',
];

/** The attachment kind the Web form records for a file: by its MIME type. */
export function attachmentKind(mimeType?: string | null): 'image' | 'video' | 'audio' | 'file' {
  if (mimeType?.startsWith('image/')) return 'image';
  if (mimeType?.startsWith('video/')) return 'video';
  if (mimeType?.startsWith('audio/')) return 'audio';
  return 'file';
}

/** The server's own text for a refused upload (for example an unsupported type or a file that is too large), or null. */
export function uploadErrorMessage(err: unknown): string | null {
  if (!(err instanceof ApiError)) return null;
  try {
    const body = JSON.parse(err.message) as { error?: unknown };
    return typeof body.error === 'string' ? body.error : null;
  } catch {
    return null;
  }
}

/** What POST /api/upload answers: the id of the attachment it created, and the file name for display. */
export type UploadedFile = { id: string; name: string };

/** Stores the file through POST /api/upload and answers the attachment it created. Rejects with an ApiError when the server refuses it. */
export async function uploadFile(picked: PickedFile): Promise<UploadedFile> {
  const form = new FormData();
  if (picked.file) {
    form.append('file', picked.file, picked.name);
  } else {
    // React Native reads a file part from its local URI.
    form.append('file', { uri: picked.uri, name: picked.name, type: picked.mimeType ?? 'application/octet-stream' } as unknown as Blob);
  }
  return apiFetch<UploadedFile>('/api/upload', { method: 'POST', body: form });
}

/** Uploads the file and prepares its attachment for a direct field. Rejects with an ApiError when the server refuses either step. */
export async function uploadAttachment(picked: PickedFile): Promise<AttachmentRow> {
  const { id } = await uploadFile(picked);
  return apiFetch<AttachmentRow>('/api/attachment/direct', {
    method: 'POST',
    body: JSON.stringify({ id, type: attachmentKind(picked.mimeType) }),
  });
}

/** The image source for an attachment's URL, carrying the access token the file route requires. */
export function attachmentImageSource(path: string) {
  return authorizedImageSource(path);
}

/**
 * Opens a stored file. The file route needs the access token, which a link handed to the system browser
 * cannot carry, so the file is fetched with the token and opened from a local object URL (Web build).
 */
export async function openAttachment(path: string): Promise<void> {
  if (typeof window === 'undefined' || typeof URL.createObjectURL !== 'function') {
    throw new ApiError(0, 'Opening a file is supported on the Web build only');
  }
  const source = authorizedImageSource(path);
  const res = await fetch(resolveApiUrl(path), { headers: source.headers });
  if (!res.ok) throw new ApiError(res.status, res.statusText);
  const blob = await res.blob();
  window.open(URL.createObjectURL(blob), '_blank', 'noopener');
}

/**
 * One attachment of a record that owns attachments through the `attachable` bridge, as the REST detail embeds it
 * (`id`, `name`, `path`, `type`, `order`). An entry the user just added carries the id its upload answered with.
 */
export type BridgeAttachment = { id?: string; name: string; path: string; type?: string; order?: number };

/**
 * `PUT /api/<entity>/<id>/attachments`: replaces the record's attachments of one type with `items`, in the order
 * listed (an entry with an `id` keeps its row, one without is created, a row not listed is deleted). Never rejects:
 * a refusal (no `update` on the record, a record of another organization, an id that is not the record's own)
 * comes back as an ActionFailure.
 */
export async function setBridgeAttachments(
  entity: string,
  recordId: string,
  type: string,
  items: BridgeAttachment[],
): Promise<{ ok: true } | ActionFailure> {
  try {
    await apiFetch(`/api/${encodeURIComponent(entity)}/${encodeURIComponent(recordId)}/attachments`, {
      method: 'PUT',
      body: JSON.stringify({ type, items: items.map(({ id }) => ({ id })) }),
    });
    return { ok: true };
  } catch (err) {
    return toActionFailure(err);
  }
}
