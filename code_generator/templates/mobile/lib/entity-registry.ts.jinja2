// Generated: the entities that have native list / detail / form screens.
import type { ComponentType } from 'react';
import { AuditLogList } from '@/components/audit_log/List';
import { AuditLogView } from '@/components/audit_log/View';
{% if has_scheduled_tasks %}
import { ScheduledTaskRunList } from '@/components/scheduled_task_run/List';
{% endif %}
{% for e in entities %}
import { {{ e.pascal }}List } from '@/components/{{ e.name }}/List';
{% if e.can_view %}
import { {{ e.pascal }}FormView } from '@/components/{{ e.name }}/FormView';
{% endif %}
{% if e.can_new or e.can_edit %}
import { {{ e.pascal }}FormUpsert } from '@/components/{{ e.name }}/FormUpsert';
{% endif %}
{% endfor %}

export type EntityScreens = {
  title: string;
  List: ComponentType;
  View: ComponentType<{ id: string }> | null;
  Form: ComponentType<{ id?: string }> | null;
};

export const ENTITY_SCREENS: Record<string, EntityScreens> = {
  // Built-in, read-only (not a schema entity): the audit log.
  audit_log: {
    title: 'Audit Log',
    List: AuditLogList,
    View: AuditLogView,
    Form: null,
  },
{% if has_scheduled_tasks %}
  // Built-in (not a schema entity), present when the schema declares a scheduled task.
  scheduled_task_run: {
    title: 'Scheduled tasks',
    List: ScheduledTaskRunList,
    View: null,
    Form: null,
  },
{% endif %}
{% for e in entities %}
  {{ e.name }}: {
    title: {{ e.title | tojson }},
    List: {{ e.pascal }}List,
    View: {% if e.can_view %}{{ e.pascal }}FormView{% else %}null{% endif %},
    Form: {% if e.can_new or e.can_edit %}{{ e.pascal }}FormUpsert{% else %}null{% endif %},
  },
{% endfor %}
};
