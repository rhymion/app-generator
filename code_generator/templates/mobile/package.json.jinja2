{# Versions are one Expo SDK's bundled set (`expo/bundledNativeModules.json` of expo 57). They are
   pinned together because the entity screens call hooks that Web shares and that need React 19
   (lib/<entity>/use_entity_form.ts starts an async transition, which React 18 types reject);
   Expo SDK 51 shipped React 18.2. Bump the whole set with `npx expo install --fix`, never one
   package alone. @playwright/test is not part of the SDK and is pinned for mobile/e2e. #}
{
  "name": "{{ app_slug }}-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:export": "expo export",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
{% if has_payment %}
    "expo-web-browser": "~57.0.3",
{% endif %}
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@playwright/test": "~1.63.0",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}
