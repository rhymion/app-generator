//
// GET /api/scheduled-task-runs[?date=YYYY-MM-DD]
//   200 { business_date, settings: { stuck_after_minutes, predecessor_recheck_minutes },
//         rows: [one per declared task], attention: [failed / stuck runs of other dates] }
