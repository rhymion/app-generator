export async function get{{ parent_pascal }}sForChart(startDate: Date, endDate: Date): Promise<{{ parent_pascal }}ForChart[]> {
  const { permissions: userPermissions, userId } = await getModelPermissions('{{ model }}');
  await assertPermission(userPermissions, 'read', '{{ model }}');

  const items = await prisma.{{ model }}.findMany({
    where: {
      {{ start_field }}: { lt: endDate },
      {{ end_field }}: { gt: startDate },
    },
    include: { {{ row_by }}: true },
    orderBy: [{ {{ start_field }}: 'asc' }],
  });

  return items.map((item) => ({
    id: item.id,
    {{ fk_field }}: item.{{ fk_field }},
    {{ row_by }}_name: (item.{{ row_by }} as { {{ label_field }}: string }).{{ label_field }},
    {{ start_field }}: (item.{{ start_field }} as Date).toISOString(),
    {{ end_field }}: (item.{{ end_field }} as Date).toISOString(),
{% for sel in extra_selects %}
    {{ sel }}
{% endfor %}
  }));
}
