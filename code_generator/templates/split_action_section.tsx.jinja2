'use client';

import { useState, useEffect{% if split_has_context_field %}, useCallback{% endif %} } from 'react';
import { AppButton, AppText, AppBox, AppIcon, AppIconButton, AppFieldInput, AppDialog } from '@/components/ui';
{% if split_has_relation_field %}
import EntityAutocomplete, { type EntityOption } from '@/components/_standard/EntityAutocomplete';
{% endif %}
{% if split_uses_format_label_value %}
import { formatLabelValue } from '@/lib/_format';
{% endif %}
{% if per_part_required %}
{% for f in per_part_required %}
{% if f.is_relation %}
import { search{{ f.target_pascal }}Options } from '@/lib/{{ f.target }}/getters';
{% endif %}
{% endfor %}
{% endif %}

type SplitPart = {
  {{ quantity_field }}: number;
  {% for f in per_part_required %}
  {{ f.field }}: string;
  {% endfor %}
};

const EMPTY_PART = (): SplitPart => ({
  {{ quantity_field }}: 0,
  {% for f in per_part_required %}
  {{ f.field }}: '',
  {% endfor %}
});

{% for f in per_part_required %}
{% if f.is_relation and not f.context_fields %}
async function search{{ pascal_name }}{{ f.field | pascal_case }}Options(query: string, includeIds: string[]): Promise<EntityOption[]> {
  const rows = await search{{ f.target_pascal }}Options(query, includeIds);
  return rows.map((item) => ({ id: item.id, label: String({{ f.label_expr }}) }));
}
{% endif %}
{% endfor %}

export function SplitActionSection({
  id,
  {{ quantity_field }},
  {% for cf in section_context_fields %}
  {{ cf }},
  {% endfor %}
  onSuccess,
}: {
  id: string;
  {{ quantity_field }}: number;
  {% for cf in section_context_fields %}
  {{ cf }}?: unknown;
  {% endfor %}
  onSuccess?: () => void;
}) {
  const [open, setOpen] = useState(false);
  const [parts, setParts] = useState<SplitPart[]>([EMPTY_PART(), EMPTY_PART()]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  {% for f in per_part_required %}
  {% if f.is_relation %}
  const [{{ f.field | camel_case }}Options, set{{ f.field | pascal_case }}Options] = useState<EntityOption[]>([]);
  {% endif %}
  {% endfor %}

  {% for f in per_part_required %}
  {% if f.is_relation and f.context_fields %}
  // DP-B (cmd_424): component-scoped (not module-level) so it can close over
  // this section's context props — narrows candidates via the same
  // AutocompleteFilterContext.formValues contract DP-3/DP-5 established for
  // FormUpsert relation fields (search{{ f.target_pascal }}Options' context param, applied
  // here to this split perPartRequired field only).
  const search{{ pascal_name }}{{ f.field | pascal_case }}Options = useCallback(async (query: string, includeIds: string[]): Promise<EntityOption[]> => {
    const rows = await search{{ f.target_pascal }}Options(query, includeIds, 50, { callerEntity: '{{ entity_name }}', formValues: { {% for cf in f.context_fields %}{{ cf }}{% if not loop.last %}, {% endif %}{% endfor %} } });
    return rows.map((item) => ({ id: item.id, label: String({{ f.label_expr }}) }));
  }, [{% for cf in f.context_fields %}{{ cf }}{% if not loop.last %}, {% endif %}{% endfor %}]);
  {% endif %}
  {% endfor %}

  {% for f in per_part_required %}
  {% if f.is_relation %}
  useEffect(() => {
    search{{ pascal_name }}{{ f.field | pascal_case }}Options('', []).then(set{{ f.field | pascal_case }}Options);
    {% if f.context_fields %}
  }, [search{{ pascal_name }}{{ f.field | pascal_case }}Options]);
    {% else %}
    {# module-scope function (not useCallback-wrapped) — a stable outer-scope
       reference is not a valid dep (react-hooks/exhaustive-deps). #}
  }, []);
    {% endif %}
  {% endif %}
  {% endfor %}

  const totalAssigned = parts.reduce((s, p) => s + (p.{{ quantity_field }} || 0), 0);
  const remaining = {{ quantity_field }} - totalAssigned;

  function updatePart<K extends keyof SplitPart>(idx: number, field: K, value: SplitPart[K]) {
    setParts((prev) => prev.map((p, i) => (i === idx ? { ...p, [field]: value } : p)));
  }

  function addPart() {
    setParts((prev) => [...prev, EMPTY_PART()]);
  }

  function removePart(idx: number) {
    if (parts.length <= 2) return;
    setParts((prev) => prev.filter((_, i) => i !== idx));
  }

  async function handleSubmit() {
    if (remaining !== 0) {
      setError(`Total must equal ${ {{ quantity_field }} } (current remaining: ${remaining})`);
      return;
    }
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(`/api/{{ entity_name }}/${id}/actions/split`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ parts }),
      });
      if (!res.ok) {
        const msg = await res.text();
        throw new Error(msg);
      }
      setOpen(false);
      setParts([EMPTY_PART(), EMPTY_PART()]);
      onSuccess?.();
    } catch (e) {
      setError(String(e));
    } finally {
      setLoading(false);
    }
  }

  return (
    <>
      <AppButton variant="outlined" color="secondary" onClick={() => setOpen(true)}>
        Split
      </AppButton>
      <AppDialog
        open={open}
        onClose={() => { if (!loading) setOpen(false); }}
        maxWidth="sm"
        fullWidth
        title={`Split {{ entity_name | pascal_case }} (total: ${ {{ quantity_field }} })`}
        actions={
          <>
            <AppButton variant="text" onClick={() => setOpen(false)} disabled={loading}>Cancel</AppButton>
            <AppButton onClick={handleSubmit} disabled={loading || remaining !== 0} variant="contained">
              {loading ? 'Splitting...' : 'Split'}
            </AppButton>
          </>
        }
      >
        {error && <AppText color="error" mb={1}>{error}</AppText>}
        <AppText variant="body2" color={remaining === 0 ? 'success.main' : 'text.secondary'} mb={2}>
          Remaining: {remaining}
        </AppText>
        {parts.map((part, idx) => (
          <AppBox key={idx} display="flex" gap={1} alignItems="center" mb={1}>
            <AppFieldInput
              label="{{ quantity_field }}"
              type="number"
              size="small"
              value={String(part.{{ quantity_field }})}
              onChange={(value) => updatePart(idx, '{{ quantity_field }}', Number(value))}
              min={1}
              width={120}
            />
            {% for f in per_part_required %}
            {% if f.is_relation %}
            <EntityAutocomplete
              sx={% raw %}{{ flex: 1 }}{% endraw %} label="{{ f.field }}"
              value={part.{{ f.field }} || null}
              onChange={(newId) => updatePart(idx, '{{ f.field }}', newId ?? '')}
              searchAction={search{{ pascal_name }}{{ f.field | pascal_case }}Options}
              initialOptions={ {{ f.field | camel_case }}Options }
              openOnFocus
            />
            {% else %}
            <AppFieldInput
              label="{{ f.field }}"
              size="small"
              value={part.{{ f.field }}}
              onChange={(value) => updatePart(idx, '{{ f.field }}', value)}
              flex={1}
            />
            {% endif %}
            {% endfor %}
            <AppIconButton iconName="Delete" iconFontSize="small" onClick={() => removePart(idx)} disabled={parts.length <= 2} size="small" />
          </AppBox>
        ))}
        <AppButton variant="text" startIcon={<AppIcon name="Add" fontSize="small" />} onClick={addPart} size="small">
          Add Part
        </AppButton>
      </AppDialog>
    </>
  );
}
