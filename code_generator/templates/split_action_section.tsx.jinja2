'use client';

import { useState, useEffect } from 'react';
import Button from '@mui/material/Button';
import Dialog from '@mui/material/Dialog';
import DialogTitle from '@mui/material/DialogTitle';
import DialogContent from '@mui/material/DialogContent';
import DialogActions from '@mui/material/DialogActions';
import TextField from '@mui/material/TextField';
import Typography from '@mui/material/Typography';
import IconButton from '@mui/material/IconButton';
import AddIcon from '@mui/icons-material/Add';
import DeleteIcon from '@mui/icons-material/Delete';
import Box from '@mui/material/Box';
{% if split_has_relation_field %}
import EntityAutocomplete, { type EntityOption } from '@/components/_standard/EntityAutocomplete';
{% endif %}
{% if split_uses_format_label_value %}
import { formatLabelValue } from '@/lib/_format';
{% endif %}
{% if per_part_required %}
{% for f in per_part_required %}
{% if f.is_relation %}
import { search{{ f.target_pascal }}Options } from '@/lib/{{ f.target }}/getters';
{% endif %}
{% endfor %}
{% endif %}

type SplitPart = {
  {{ quantity_field }}: number;
  {% for f in per_part_required %}
  {{ f.field }}: string;
  {% endfor %}
};

const EMPTY_PART = (): SplitPart => ({
  {{ quantity_field }}: 0,
  {% for f in per_part_required %}
  {{ f.field }}: '',
  {% endfor %}
});

{% for f in per_part_required %}
{% if f.is_relation %}
async function search{{ pascal_name }}{{ f.field | pascal_case }}Options(query: string, includeIds: string[]): Promise<EntityOption[]> {
  const rows = await search{{ f.target_pascal }}Options(query, includeIds);
  return rows.map((item) => ({ id: item.id, label: String({{ f.label_expr }}) }));
}
{% endif %}
{% endfor %}

export function SplitActionSection({
  id,
  {{ quantity_field }},
  onSuccess,
}: {
  id: string;
  {{ quantity_field }}: number;
  onSuccess?: () => void;
}) {
  const [open, setOpen] = useState(false);
  const [parts, setParts] = useState<SplitPart[]>([EMPTY_PART(), EMPTY_PART()]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  {% for f in per_part_required %}
  {% if f.is_relation %}
  const [{{ f.field | camel_case }}Options, set{{ f.field | pascal_case }}Options] = useState<EntityOption[]>([]);
  {% endif %}
  {% endfor %}

  {% for f in per_part_required %}
  {% if f.is_relation %}
  useEffect(() => {
    search{{ pascal_name }}{{ f.field | pascal_case }}Options('', []).then(set{{ f.field | pascal_case }}Options);
  }, []);
  {% endif %}
  {% endfor %}

  const totalAssigned = parts.reduce((s, p) => s + (p.{{ quantity_field }} || 0), 0);
  const remaining = {{ quantity_field }} - totalAssigned;

  function updatePart<K extends keyof SplitPart>(idx: number, field: K, value: SplitPart[K]) {
    setParts((prev) => prev.map((p, i) => (i === idx ? { ...p, [field]: value } : p)));
  }

  function addPart() {
    setParts((prev) => [...prev, EMPTY_PART()]);
  }

  function removePart(idx: number) {
    if (parts.length <= 2) return;
    setParts((prev) => prev.filter((_, i) => i !== idx));
  }

  async function handleSubmit() {
    if (remaining !== 0) {
      setError(`Total must equal ${ {{ quantity_field }} } (current remaining: ${remaining})`);
      return;
    }
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(`/api/{{ entity_name }}/${id}/actions/split`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ parts }),
      });
      if (!res.ok) {
        const msg = await res.text();
        throw new Error(msg);
      }
      setOpen(false);
      setParts([EMPTY_PART(), EMPTY_PART()]);
      onSuccess?.();
    } catch (e) {
      setError(String(e));
    } finally {
      setLoading(false);
    }
  }

  return (
    <>
      <Button variant="outlined" color="secondary" onClick={() => setOpen(true)}>
        Split
      </Button>
      <Dialog open={open} onClose={() => !loading && setOpen(false)} maxWidth="sm" fullWidth>
        <DialogTitle>Split {{ entity_name | pascal_case }} (total: { {{ quantity_field }} })</DialogTitle>
        <DialogContent>
          {error && <Typography color="error" sx={% raw %}{{ mb: 1 }}{% endraw %}>{error}</Typography>}
          <Typography variant="body2" color={remaining === 0 ? 'success.main' : 'text.secondary'} sx={% raw %}{{ mb: 2 }}{% endraw %}>
            Remaining: {remaining}
          </Typography>
          {parts.map((part, idx) => (
            <Box key={idx} sx={% raw %}{{ display: 'flex', gap: 1, alignItems: 'center', mb: 1 }}{% endraw %}>
              <TextField
                label="{{ quantity_field }}"
                type="number"
                size="small"
                value={part.{{ quantity_field }}}
                onChange={(e) => updatePart(idx, '{{ quantity_field }}', Number(e.target.value))}
                inputProps={% raw %}{{ min: 1 }}{% endraw %} sx={% raw %}{{ width: 120 }}{% endraw %}
              />
              {% for f in per_part_required %}
              {% if f.is_relation %}
              <EntityAutocomplete
                sx={% raw %}{{ flex: 1 }}{% endraw %} label="{{ f.field }}"
                value={part.{{ f.field }} || null}
                onChange={(newId) => updatePart(idx, '{{ f.field }}', newId ?? '')}
                searchAction={search{{ pascal_name }}{{ f.field | pascal_case }}Options}
                initialOptions={ {{ f.field | camel_case }}Options }
                openOnFocus
              />
              {% else %}
              <TextField
                label="{{ f.field }}"
                size="small"
                value={part.{{ f.field }}}
                onChange={(e) => updatePart(idx, '{{ f.field }}', e.target.value)}
                sx={% raw %}{{ flex: 1 }}{% endraw %}
              />
              {% endif %}
              {% endfor %}
              <IconButton onClick={() => removePart(idx)} disabled={parts.length <= 2} size="small">
                <DeleteIcon fontSize="small" />
              </IconButton>
            </Box>
          ))}
          <Button startIcon={<AddIcon />} onClick={addPart} size="small">
            Add Part
          </Button>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setOpen(false)} disabled={loading}>Cancel</Button>
          <Button onClick={handleSubmit} disabled={loading || remaining !== 0} variant="contained">
            {loading ? 'Splitting...' : 'Split'}
          </Button>
        </DialogActions>
      </Dialog>
    </>
  );
}
