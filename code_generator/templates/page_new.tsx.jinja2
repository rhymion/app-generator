import { Suspense } from 'react';
{% if required_relation_fields %}
import Alert from '@mui/material/Alert';
import { getTranslations } from 'next-intl/server';
{% endif %}
import FormSkeleton from '@/components/_standard/FormSkeleton';
import FormUpsert from '@/components/{{ parent }}/FormUpsert';
{% for target in selection_targets %}
{% if target == 'organization' %}
import { searchAssociatedOrganizationOptions } from '@/lib/organization/getters_associated';
{% else %}
import { search{{ target | pascal_case }}Options } from '@/lib/{{ target }}/getters';
{% endif %}
{% endfor %}
{% for oto in selector_oto_rels %}
import { getAvailable{{ oto.target | pascal_case }}sFor{{ parent_pascal }} } from '@/lib/{{ parent }}/getters';
{% endfor %}
import { get{{ parent_pascal }}NewPageAccessCheck } from '@/lib/{{ parent }}/getters';

{% if bridge_child_ir %}
type NewSearchParams = Record<string, string | string[] | undefined>;

export default function Add{{ parent_pascal }}Page({ searchParams }: { searchParams: Promise<NewSearchParams> }) {
  return (
    <Suspense fallback={<FormSkeleton />}>
      <{{ parent_pascal }}NewContent searchParams={searchParams} />
    </Suspense>
  );
}

async function {{ parent_pascal }}NewContent({ searchParams }: { searchParams: Promise<NewSearchParams> }) {
  const _sp = await searchParams;
  const _initialParentType = typeof _sp.parentType === 'string' ? _sp.parentType : '';
  const _initialParentId = typeof _sp.parentId === 'string' ? _sp.parentId : '';
{% else %}
export default function Add{{ parent_pascal }}Page() {
  return (
    <Suspense fallback={<FormSkeleton />}>
      <{{ parent_pascal }}NewContent />
    </Suspense>
  );
}

async function {{ parent_pascal }}NewContent() {
{% endif %}
{% if selection_targets or selector_oto_rels %}
  const [userPermissions, {% for target in selection_targets %}initial{{ target | pascal_case }}s{% if not loop.last or selector_oto_rels %}, {% endif %}{% endfor %}{% for oto in selector_oto_rels %}initialAvailable{{ oto.target | pascal_case }}s{% if not loop.last %}, {% endif %}{% endfor %}] = await Promise.all([
    get{{ parent_pascal }}NewPageAccessCheck(),
{% for target in selection_targets %}
{% if target == 'organization' %}
    searchAssociatedOrganizationOptions('', [], 50),
{% else %}
    search{{ target | pascal_case }}Options('', [], 50),
{% endif %}
{% endfor %}
{% for oto in selector_oto_rels %}
    getAvailable{{ oto.target | pascal_case }}sFor{{ parent_pascal }}(),
{% endfor %}{# selector OTO returns full record array; FormUpsert maps it client-side #}
  ]);
{% else %}
  const userPermissions = await get{{ parent_pascal }}NewPageAccessCheck();
{% endif %}
{% if required_relation_fields %}
  // Option B (cmd_516, item v): a required FK whose target the current user
  // can't read has no way to be populated on /new — block with an
  // explanatory message instead of rendering a create form that can never
  // successfully submit. See docs/knowledge/fk-read-permission-graceful-degradation.md.
  const _blockedRelationFieldKeys: string[] = [];
{% for f in required_relation_fields %}
  if ((initial{{ f.target | pascal_case }}s as { permissionDenied?: boolean } | undefined)?.permissionDenied) {
    _blockedRelationFieldKeys.push('{{ f.field_key }}');
  }
{% endfor %}
  if (_blockedRelationFieldKeys.length > 0) {
    const tc = await getTranslations('Common');
    const tf = await getTranslations('Fields');
    const te = await getTranslations('EntityLabel');
    return (
      <Alert severity="warning" sx={{ m: 2 }}>
        {tc('fkReadPermissionBlocksCreate', {
          entity: te('{{ parent_camel }}'),
          field: _blockedRelationFieldKeys.map((k) => tf(k)).join(', '),
        })}
      </Alert>
    );
  }
{% endif %}
  const src = {
    id: '',
{{ parent_default_props }}
{% for child in children_raw %}
    {{ child.property_name }}: [],
{% endfor %}
  };
  return <FormUpsert src={src} isEdit={false} permissions={userPermissions}{% for target in selection_targets %} initial{{ target | pascal_case }}s={ initial{{ target | pascal_case }}s } search{{ target | pascal_case }}Options={ {% if target == 'organization' %}searchAssociatedOrganizationOptions{% else %}search{{ target | pascal_case }}Options{% endif %} }{% endfor %}{% for oto in selector_oto_rels %} initial{{ oto.target | pascal_case }}s={ initialAvailable{{ oto.target | pascal_case }}s }{% endfor %}{% if bridge_child_ir %} initialParentType={_initialParentType} initialParentId={_initialParentId}{% endif %} />;
}
