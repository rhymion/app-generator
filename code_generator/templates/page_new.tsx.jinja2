{% if bridge_child_ir %}
type NewSearchParams = Record<string, string | string[] | undefined>;

export default function Add{{ parent_pascal }}Page({ searchParams }: { searchParams: Promise<NewSearchParams> }) {
  return (
    <Suspense fallback={<FormSkeleton />}>
      <{{ parent_pascal }}NewContent searchParams={searchParams} />
    </Suspense>
  );
}

async function {{ parent_pascal }}NewContent({ searchParams }: { searchParams: Promise<NewSearchParams> }) {
  const _sp = await searchParams;
  const _initialParentType = typeof _sp.parentType === 'string' ? _sp.parentType : '';
  const _initialParentId = typeof _sp.parentId === 'string' ? _sp.parentId : '';
{% else %}
export default function Add{{ parent_pascal }}Page() {
  return (
    <Suspense fallback={<FormSkeleton />}>
      <{{ parent_pascal }}NewContent />
    </Suspense>
  );
}

async function {{ parent_pascal }}NewContent() {
{% endif %}
