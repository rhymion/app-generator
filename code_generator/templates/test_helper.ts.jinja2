      entity_name: '{{ model_name }}',
      approver_role_id: approverRole1.id,
      creator_id: testUser.id,
      updater_id: testUser.id,
    },
  });
  const flow2 = await prisma.approval_flow.create({
    data: {
      entity_name: '{{ model_name }}',
