      name: 'Test {{ title }} Ordered Approver 1',
      email: 'test-{{ model_name }}-ordered-approver1@example.com',
      password: hashedPw,
      api_key: `test_mk_{{ model_name }}_ordered_approver1`,
      creator_id: testUser.id,
      updater_id: testUser.id,
