import { NextRequest, NextResponse } from 'next/server';
import { authenticate, requireApiPermission, handleApiError } from '@/lib/api-auth';
import prisma from '@/lib/prisma';
{% if can_view %}
import { get{{ parent_pascal }}Detail } from '@/lib/{{ parent }}/getters';
{% endif %}
{% if can_update or can_delete %}
import { {% if can_update %}update{{ parent_pascal }}{% endif %}{% if can_update and can_delete %}, {% endif %}{% if can_delete %}delete{{ parent_pascal }}{% endif %}{% if reservation_config and reservation_config.mode == 'count' %}, ReservationMutationError{% endif %} } from '@/lib/{{ parent }}/service';
{% endif %}
{% if can_delete %}
import { RecordInUseError } from '@/lib/prisma-errors';
{% endif %}

type Params = { params: Promise<{ id: string }> };
{% if can_view %}
export async function GET(request: NextRequest, { params }: Params) {
  try {
    const { id } = await params;
    const { userId: actorId } = await authenticate(request);
    const item = await get{{ parent_pascal }}Detail(id{% if should_filter_by_org %}, actorId{% endif %});
    if (!item) {
      return NextResponse.json({ error: 'Not found' }, { status: 404 });
    }
    await requireApiPermission(actorId, '{{ parent }}', 'read', item);
    return NextResponse.json(item);
  } catch (error) {
    return handleApiError(error);
  }
}
{% endif %}
{% if can_update %}
export async function PUT(request: NextRequest, { params }: Params) {
  try {
    const { id } = await params;
    const { userId: actorId } = await authenticate(request);
    const existing = await prisma.{{ model }}.findUnique({ where: { id }, select: {{ item_context_select }} });
    if (!existing) {
      return NextResponse.json({ error: 'Not found' }, { status: 404 });
    }
    await requireApiPermission(actorId, '{{ parent }}', 'update', existing);
    const body = await request.json();
    const { {{ all_body_fields_create }} } = body;
{% if readonly_fields_api %}
    // AP-3=B: reject submitted read-only field values that differ from persisted.
    const _roRow = await prisma.{{ model }}.findUnique({ where: { id }, select: {{ readonly_fields_api_select }} });
    if (_roRow) {
{% for f in readonly_fields_api %}
      if (body.{{ f }} !== undefined && String(body.{{ f }}) !== String(_roRow.{{ f }})) {
        return NextResponse.json({ error: 'Field {{ f }} is read-only and cannot be changed' }, { status: 400 });
      }
{% endfor %}
    }
{% endif %}
    await update{{ parent_pascal }}({{ service_args_for_update }}, null);
    return NextResponse.json({ success: true });
  } catch (error) {
{% if reservation_config and reservation_config.mode == 'count' %}
    if (error instanceof ReservationMutationError) {
      return NextResponse.json({ error: (error as Error).message }, { status: 409 });
    }
{% endif %}
    return handleApiError(error);
  }
}
{% endif %}
{% if can_delete %}
export async function DELETE(request: NextRequest, { params }: Params) {
  try {
    const { id } = await params;
    const { userId: actorId } = await authenticate(request);
    const existing = await prisma.{{ model }}.findUnique({ where: { id }, select: {{ item_context_select }} });
    if (!existing) {
      return NextResponse.json({ error: 'Not found' }, { status: 404 });
    }
    await requireApiPermission(actorId, '{{ parent }}', 'delete', existing);
    await delete{{ parent_pascal }}({% if is_audited %}actorId, {% endif %}[id]);
    return new NextResponse(null, { status: 204 });
  } catch (error) {
{% if reservation_config and reservation_config.mode == 'count' %}
    if (error instanceof ReservationMutationError) {
      return NextResponse.json({ error: (error as Error).message }, { status: 409 });
    }
{% endif %}
    if (error instanceof RecordInUseError) {
      return NextResponse.json({ error: error.message }, { status: 409 });
    }
    return handleApiError(error);
  }
}
{% endif %}
