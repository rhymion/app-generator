import { NextRequest, NextResponse } from 'next/server';
import { authenticateApiKey, requireApiPermission, handleApiError } from '@/lib/api-auth';
import prisma from '@/lib/prisma';
{% if can_view %}
import { get{{ parent_pascal }}Detail } from '@/lib/{{ parent }}/getters';
{% endif %}
{% if can_view and comment_has_mention %}
import { decodeMentions, extractMentionedUserIds, type UserContext } from '@/lib/mention/parser';
import { getTranslations } from 'next-intl/server';
{% endif %}
{% if can_update or can_delete %}
import { {% if can_update %}update{{ parent_pascal }}{% endif %}{% if can_update and can_delete %}, {% endif %}{% if can_delete %}delete{{ parent_pascal }}{% endif %}{% if reservation_config and reservation_config.mode == 'count' %}, ReservationMutationError{% endif %} } from '@/lib/{{ parent }}/service';
{% endif %}
{% if should_filter_by_org and (can_update or can_delete) %}
import { getAssociatedOrganizations } from '@/lib/organization/getters_associated';
{% endif %}

type Params = { params: Promise<{ id: string }> };
{% if can_view %}
export async function GET(request: NextRequest, { params }: Params) {
  try {
    const { id } = await params;
    const { userId: actorId } = await authenticateApiKey(request);
    const item = await get{{ parent_pascal }}Detail(id{% if should_filter_by_org %}, actorId{% endif %});
    if (!item) {
      return NextResponse.json({ error: 'Not found' }, { status: 404 });
    }
    await requireApiPermission(actorId, '{{ parent }}', 'read', item);
{% if comment_has_mention %}
    // Mention decode (cmd_522c): get{{ parent_pascal }}Detail() returns RAW
    // @[user_id:<id>] markers (needed by the page/FormView path's
    // <MentionText>). This REST route's JSON contract predates that split
    // and still returns plain decoded names (M1, test_api_spec.cy.ts.jinja2)
    // — so decoding happens here, at the API boundary, instead.
    const _mentionUserIds = new Set<string>();
{% if named_constants and has_commentable %}
    for (const c of item.{{ commentable_rel_name }}?.comments ?? []) {
      if (c.creator?.id) _mentionUserIds.add(c.creator.id);
      for (const uid of extractMentionedUserIds(c.message)) _mentionUserIds.add(uid);
    }
{% endif %}
{% for child in children_raw %}
{% if child.output_type == 'comments' %}
    for (const c of item.{{ child.property_name }} ?? []) {
      if (c.creator?.id) _mentionUserIds.add(c.creator.id);
      for (const uid of extractMentionedUserIds(c.message)) _mentionUserIds.add(uid);
    }
{% endif %}
{% endfor %}
    const _mentionUsers = _mentionUserIds.size
      ? await prisma.user.findMany({ where: { id: { in: [..._mentionUserIds] } }, select: { id: true, name: true } })
      : [];
    const _mentionUserContext: UserContext = Object.fromEntries(_mentionUsers.map((u) => [u.id, u.name]));
    const _tCommon = await getTranslations('Common');
    const _decodeComment = <T extends { message: string }>(c: T) => ({ ...c, message: decodeMentions(c.message, _mentionUserContext, _tCommon('deletedUser')) });
    const decodedItem = {
      ...item,
{% if named_constants and has_commentable %}
      {{ commentable_rel_name }}: item.{{ commentable_rel_name }}
        ? { ...item.{{ commentable_rel_name }}, comments: item.{{ commentable_rel_name }}.comments.map(_decodeComment) }
        : item.{{ commentable_rel_name }},
{% endif %}
{% for child in children_raw %}
{% if child.output_type == 'comments' %}
      {{ child.property_name }}: item.{{ child.property_name }}.map(_decodeComment),
{% endif %}
{% endfor %}
    };
    return NextResponse.json(decodedItem);
{% else %}
    return NextResponse.json(item);
{% endif %}
  } catch (error) {
    return handleApiError(error);
  }
}
{% endif %}
{% if can_update %}
export async function PUT(request: NextRequest, { params }: Params) {
  try {
    const { id } = await params;
    const { userId: actorId } = await authenticateApiKey(request);
{% if should_filter_by_org %}
    const _assocOrgs = await getAssociatedOrganizations(actorId);
    const _assocOrgIds = _assocOrgs.map((o) => o.id);
    const existing = await prisma.{{ model }}.findFirst({ where: { id, organization_id: { in: _assocOrgIds } }, select: {{ item_context_select }} });
{% else %}
    const existing = await prisma.{{ model }}.findUnique({ where: { id }, select: {{ item_context_select }} });
{% endif %}
    if (!existing) {
      return NextResponse.json({ error: 'Not found' }, { status: 404 });
    }
    await requireApiPermission(actorId, '{{ parent }}', 'update', existing);
    const body = await request.json();
    const { {{ all_body_fields_create }} } = body;
{% if readonly_fields_api %}
    // AP-3=B: reject submitted read-only field values that differ from persisted.
    const _roRow = await prisma.{{ model }}.findUnique({ where: { id }, select: {{ readonly_fields_api_select }} });
    if (_roRow) {
{% for f in readonly_fields_api %}
      if (body.{{ f }} !== undefined && String(body.{{ f }}) !== String(_roRow.{{ f }})) {
        return NextResponse.json({ error: 'Field {{ f }} is read-only and cannot be changed' }, { status: 400 });
      }
{% endfor %}
    }
{% endif %}
    await update{{ parent_pascal }}({{ service_args_for_update }}, null);
    return NextResponse.json({ success: true });
  } catch (error) {
{% if reservation_config and reservation_config.mode == 'count' %}
    if (error instanceof ReservationMutationError) {
      return NextResponse.json({ error: (error as Error).message }, { status: 409 });
    }
{% endif %}
    return handleApiError(error);
  }
}
{% endif %}
{% if can_delete %}
export async function DELETE(request: NextRequest, { params }: Params) {
  try {
    const { id } = await params;
    const { userId: actorId } = await authenticateApiKey(request);
{% if should_filter_by_org %}
    const _assocOrgs = await getAssociatedOrganizations(actorId);
    const _assocOrgIds = _assocOrgs.map((o) => o.id);
    const existing = await prisma.{{ model }}.findFirst({ where: { id, organization_id: { in: _assocOrgIds } }, select: {{ item_context_select }} });
{% else %}
    const existing = await prisma.{{ model }}.findUnique({ where: { id }, select: {{ item_context_select }} });
{% endif %}
    if (!existing) {
      return NextResponse.json({ error: 'Not found' }, { status: 404 });
    }
    await requireApiPermission(actorId, '{{ parent }}', 'delete', existing);
    await delete{{ parent_pascal }}({% if is_audited %}actorId, {% endif %}[id]);
    return new NextResponse(null, { status: 204 });
  } catch (error) {
{% if reservation_config and reservation_config.mode == 'count' %}
    if (error instanceof ReservationMutationError) {
      return NextResponse.json({ error: (error as Error).message }, { status: 409 });
    }
{% endif %}
    return handleApiError(error);
  }
}
{% endif %}
