// GENERATED ONCE — safe to edit (will not be overwritten on regeneration)

// x-payment: Stripe webhook receiver. This file only verifies the signature;
// what an event *does* -- confirming a paid record, removing an unpaid one --
// lives in the generated lib/payment/payment_webhook_dispatch.ts, which
// serves every x-payment entity at once and is idempotent (Stripe may
// deliver an event more than once). Add cases for other event types here
// (subscriptions are not covered). See docs/knowledge/stripe-payment-integration.md.

import { NextResponse } from 'next/server';
import type Stripe from 'stripe';
import { stripe } from '@/lib/stripe';
import { dispatchPaymentEvent } from '@/lib/payment/payment_webhook_dispatch';

export async function POST(req: Request) {
  // cmd_758: checked inside the handler, not at module top level. Next.js
  // evaluates every route module while collecting page data during
  // `next build`, regardless of which HTTP methods it exports -- a
  // top-level `throw` here used to fail the production build itself
  // whenever STRIPE_WEBHOOK_SECRET was unset (e.g. every Vercel Preview
  // deploy). Fail-closed behavior is unchanged: this still throws before
  // any webhook event is processed if the secret is missing -- only the
  // timing moves from build/import time to request time.
  const webhookSecret = process.env.STRIPE_WEBHOOK_SECRET;
  if (!webhookSecret) {
    throw new Error(
      'STRIPE_WEBHOOK_SECRET is not set. Generate one with `stripe listen` ' +
      '(dev) or the Stripe Dashboard webhook settings (prod), then add it to ' +
      '.env.test.local when running with NODE_ENV=test, .env.local for ' +
      'development, or your deployment env vars.'
    );
  }

  const signature = req.headers.get('stripe-signature');
  if (!signature) {
    return NextResponse.json({ error: 'Missing stripe-signature header' }, { status: 400 });
  }

  // Next.js App Router route handlers don't expose a raw body the way
  // Express's `req.body` does under `express.raw()` -- constructEvent needs
  // the exact bytes Stripe signed, so read the body as text, not JSON.
  const payload = await req.text();

  let event: Stripe.Event;
  try {
    event = stripe.webhooks.constructEvent(payload, signature, webhookSecret);
  } catch (err) {
    const message = err instanceof Error ? err.message : String(err);
    return NextResponse.json(
      { error: `Webhook signature verification failed: ${message}` },
      { status: 400 },
    );
  }

  try {
    await dispatchPaymentEvent(event);
  } catch (err) {
    // The event was not fully applied. Answer 500 so Stripe redelivers it;
    // the dispatcher is idempotent, so the retry is safe.
    console.error('[x-payment] webhook dispatch failed', event.id, err);
    return NextResponse.json({ error: 'Webhook handling failed' }, { status: 500 });
  }

  return NextResponse.json({ received: true });
}
