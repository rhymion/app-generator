import { NextRequest, NextResponse } from 'next/server';
import { authenticateApiKey, requireApiPermission, handleApiError } from '@/lib/api-auth';
import { getRateLimiter } from '@/lib/rate-limit';
{% if can_list %}
import { get{{ parent_pascal }}Page } from '@/lib/{{ parent }}/getters';
import { parsePageOpts, MAX_PAGE_SIZE } from '@/lib/_pagination';
{% endif %}
{% if can_create %}
import { hashIdempotencyBody } from '@/lib/idempotency';
{% if reservation_config %}
import { add{{ parent_pascal }}, InsufficientPoolCapacityError } from '@/lib/{{ parent }}/service';
{% else %}
import { add{{ parent_pascal }} } from '@/lib/{{ parent }}/service';
{% endif %}
{% endif %}
{% if can_list %}
export async function GET(request: NextRequest) {
  try {
    const { userId: actorId } = await authenticateApiKey(request);
    const _rl = await getRateLimiter().check('api:read', actorId);
    if (!_rl.allowed) {
      return NextResponse.json(
        { error: 'rate_limited', retryAfter: _rl.retryAfterSeconds },
        { status: 429, headers: { 'Retry-After': String(_rl.retryAfterSeconds), 'X-RateLimit-Bucket': 'api:read' } },
      );
    }
    const richPerms = await requireApiPermission(actorId, '{{ parent }}', 'read');
    const rawPageSize = request.nextUrl.searchParams.get('pageSize');
    if (rawPageSize && Number(rawPageSize) > MAX_PAGE_SIZE) {
      return NextResponse.json(
        { error: `pageSize exceeds maximum of ${MAX_PAGE_SIZE}` },
        { status: 400 },
      );
    }
    const opts = parsePageOpts(request.nextUrl.searchParams);
    const result = await get{{ parent_pascal }}Page(opts, richPerms, actorId);
    return NextResponse.json(result);
  } catch (error) {
    return handleApiError(error);
  }
}
{% endif %}
{% if can_create %}
export async function POST(request: NextRequest) {
  try {
    const { userId: actorId } = await authenticateApiKey(request);
    const _rl = await getRateLimiter().check('api:write', actorId);
    if (!_rl.allowed) {
      return NextResponse.json(
        { error: 'rate_limited', retryAfter: _rl.retryAfterSeconds },
        { status: 429, headers: { 'Retry-After': String(_rl.retryAfterSeconds), 'X-RateLimit-Bucket': 'api:write' } },
      );
    }
    await requireApiPermission(actorId, '{{ parent }}', 'create');
    const body = await request.json();
{% if readonly_fields_create_reject %}
    // Read-only fields can never be supplied by the client, even on create
    // (cmd_565 — CREATE has no existing row to compare against, unlike
    // PUT's AP-3=B, so any submitted value is rejected outright).
{% for f in readonly_fields_create_reject %}
    if (body.{{ f }} !== undefined) {
      return NextResponse.json({ error: 'Field {{ f }} is read-only and cannot be set' }, { status: 400 });
    }
{% endfor %}
{% endif %}
    const { {{ all_body_fields_create }} } = body;
    // Idempotency-Key (design: ai-agent-integration-design.md) -- optional;
    // absent for every existing caller, so this is a pure opt-in.
    const _idempotencyKeyHeader = request.headers.get('Idempotency-Key');
    const result = await add{{ parent_pascal }}({{ service_args_for_create }}, _idempotencyKeyHeader ? { key: _idempotencyKeyHeader, bodyHash: hashIdempotencyBody(body) } : undefined);
    return NextResponse.json(result, { status: 201 });
  } catch (error) {
{% if reservation_config %}
    if (error instanceof InsufficientPoolCapacityError) {
      return NextResponse.json({ error: (error as Error).message }, { status: 409 });
    }
{% endif %}
    return handleApiError(error);
  }
}
{% endif %}
