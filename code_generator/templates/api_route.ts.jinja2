import { NextRequest, NextResponse } from 'next/server';
import { authenticateApiKey, requireApiPermission, handleApiError } from '@/lib/api-auth';
{% if can_list %}
import { get{{ parent_pascal }}Page } from '@/lib/{{ parent }}/getters';
import { parsePageOpts } from '@/lib/_pagination';
{% endif %}
{% if can_create %}
import { add{{ parent_pascal }} } from '@/lib/{{ parent }}/service';
{% endif %}
{% if can_list %}
export async function GET(request: NextRequest) {
  try {
    const { userId: actorId } = await authenticateApiKey(request);
    const richPerms = await requireApiPermission(actorId, '{{ parent }}', 'read');
    const opts = parsePageOpts(request.nextUrl.searchParams);
    const result = await get{{ parent_pascal }}Page(opts, richPerms, actorId);
    return NextResponse.json(result);
  } catch (error) {
    return handleApiError(error);
  }
}
{% endif %}
{% if can_create %}
export async function POST(request: NextRequest) {
  try {
    const { userId: actorId } = await authenticateApiKey(request);
    await requireApiPermission(actorId, '{{ parent }}', 'create');
    const body = await request.json();
    const { {{ all_body_fields_create }} } = body;
    const result = await add{{ parent_pascal }}({{ service_args_for_create }});
    return NextResponse.json(result, { status: 201 });
  } catch (error) {
    return handleApiError(error);
  }
}
{% endif %}
