# Project command policy corresponding to .claude/settings.json.
# These rules allow common project verification commands to run outside the
# sandbox when Codex asks for escalation.

prefix_rule(
    pattern = ["npm", "run", "docker:up:test"],
    decision = "allow",
    justification = "Required gate step for test database services (generate-schema, update-generator, add-component, update-code tasks).",
)

prefix_rule(
    pattern = ["npm", "run", "docker:down:test"],
    decision = "allow",
    justification = "Allowed cleanup for test database services.",
)

prefix_rule(
    pattern = ["npm", "run", "docker:up:dev"],
    decision = "allow",
    justification = "Allowed dev database startup for local development tasks.",
)

prefix_rule(
    pattern = ["npm", "run", "docker:down:dev"],
    decision = "allow",
    justification = "Allowed cleanup for dev database services.",
)

prefix_rule(
    pattern = ["npm", "run", "generate-code"],
    decision = "allow",
    justification = "Required gate step for code generation (generate-schema, update-generator, add-component, update-code tasks).",
)

prefix_rule(
    pattern = ["npm", "run", "build"],
    decision = "allow",
    justification = "Required gate step for build validation (update-generator, add-component, update-code tasks).",
)

prefix_rule(
    pattern = ["npm", "run", "test"],
    decision = "allow",
    justification = "Required gate step for unit tests (update-generator, add-component, update-code tasks).",
)

prefix_rule(
    pattern = ["npm", "run", "test:coverage"],
    decision = "allow",
    justification = "Allowed project test coverage command.",
)

prefix_rule(
    pattern = ["npm", "run", "test:e2e:build"],
    decision = "allow",
    justification = "Required e2e build gate step (update-generator, add-component, update-code tasks).",
)

prefix_rule(
    pattern = ["npm", "run", "test:e2e:cy:api"],
    decision = "allow",
    justification = "Required API e2e gate step (update-generator, add-component tasks).",
)

prefix_rule(
    pattern = ["npm", "run", "test:e2e:cy:start"],
    decision = "allow",
    justification = "Required full e2e Cypress gate step.",
)

prefix_rule(
    pattern = ["npm", "run", "test:e2e"],
    decision = "allow",
    justification = "Required full e2e pipeline gate step.",
)

prefix_rule(
    pattern = ["npm", "run", "test:pytest"],
    decision = "allow",
    justification = "Required Python generator test gate (update-generator tasks).",
)

prefix_rule(
    pattern = ["npm", "run", "check:generated"],
    decision = "allow",
    justification = "Required generated-code drift check gate step.",
)

prefix_rule(
    pattern = ["npm", "run", "db:push"],
    decision = "allow",
    justification = "Required database schema push step (generate-schema, update-code tasks).",
)

prefix_rule(
    pattern = ["npm", "run", "db:seed-tenant"],
    decision = "allow",
    justification = "Required tenant seed step for e2e test setup.",
)

prefix_rule(
    pattern = ["npm", "run", "db:generate"],
    decision = "allow",
    justification = "Allowed database client generation step when schema drift is suspected.",
)

prefix_rule(
    pattern = ["npm", "run", "lint"],
    decision = "allow",
    justification = "Allowed project lint command.",
)

prefix_rule(
    pattern = ["npx", "vitest"],
    decision = "allow",
    justification = "Allowed targeted Vitest invocation corresponding to Claude npx vitest:* permission.",
)

prefix_rule(
    pattern = ["npx", "cypress", "run", "--browser", "chromium", "--spec", "cypress/e2e/api"],
    decision = "allow",
    justification = "Allowed API Cypress run from local Claude settings.",
)

prefix_rule(
    pattern = ["npx", "cypress", "run", "--browser", "chromium", "--spec", "cypress/e2e/api*"],
    decision = "allow",
    justification = "Allowed API Cypress run from shared Claude settings.",
)

prefix_rule(
    pattern = ["pytest", "code_generator/tests"],
    decision = "allow",
    justification = "Required Python generator test gate (update-generator tasks).",
)

prefix_rule(
    pattern = ["npm", "audit"],
    decision = "allow",
    justification = "Allowed security audit command for dependency vulnerability checks.",
)

prefix_rule(
    pattern = ["pip-audit"],
    decision = "allow",
    justification = "Allowed Python dependency security audit command.",
)

prefix_rule(
    pattern = ["npm", "install"],
    decision = "prompt",
    justification = "Dependency installation changes lockfiles and may need network access.",
)
