# Test environment configuration

PORT=3000
POSTGRES_PORT=5432
POSTGRES_DB=my_next_test
REDIS_PORT=6379
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_next_test"
NEXTAUTH_URL="http://localhost:3000"
REDIS_URL="redis://localhost:6379"
NODE_ENV="test"

AUTH_TRUST_HOST=true

# Enables /api/_test/reset-caches so cypress can clear in-process LRU caches
# (api-key, permission) after cy.task('db:reset'). Production deployments
# leave this unset; the route then returns 404.
TEST_RESET_TOKEN="cypress-reset-token"

# Disable Prisma Accelerate in test env (use direct local DB connection)
PRISMA_DATABASE_URL=

# The Cypress UI suite logs in fresh for every `it()` (~150+ credential POSTs
# from one IP over the full run), all sharing the Redis-backed
# `auth:signin:credentials` counter. Widen just that bucket so the suite's
# own legitimate volume doesn't trip the production-tuned ceiling of 10/min.
# See lib/rate-limit/index.ts for why this can't be a NODE_ENV check instead.
RATE_LIMIT_AUTH_CREDENTIALS_LIMIT=500

# NotificationBell.tsx poll interval — short so e2e specs asserting the bell
# reflects a new notification don't have to wait the production default
# (see .env). Mount/open/focus refetch triggers already cover most cases;
# this backstops the plain-interval path within a Cypress spec's timeout.
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL_MS=3000
