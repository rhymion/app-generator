# Test environment configuration
# This file is loaded during e2e tests.
#
# Values below are DEFAULTS. Override any of them by exporting the same
# variable in your shell before running npm scripts (useful for running
# parallel worktrees on different ports). dotenv-cli does not override
# pre-existing shell env vars, so shell values win.

# Application port (Next.js dev/start respects this natively)
#PORT=3001

# Postgres host port (mapped to container's 5432). proj_b's docker-compose
# binds to 5434 on the host so it doesn't collide with proj_a on 5432.
#POSTGRES_PORT=5434

# Test database name
#POSTGRES_DB=my_next_test

# Redis host port (mapped to redis-test container's 6379). Bumped off the
# default 6379 so it doesn't collide with another local Redis if one is
# already running.
#REDIS_PORT=6381

# Composed URLs — override these directly if you need a different host/user/etc.
# The :-default syntax keeps committed defaults usable as-is even when the
# port vars above stay commented out; shell env (and uncommented vars
# above) still win.
DATABASE_URL="postgresql://postgres:postgres@localhost:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-my_next_test}"
NEXTAUTH_URL="http://localhost:${PORT:-3000}"
REDIS_URL="redis://localhost:${REDIS_PORT:-6379}"

NODE_ENV="test"


# NextAuth secret - must match the variable name used in auth.ts (AUTH_SECRET)
AUTH_SECRET="3cec2cbfc3a51813606e15d9aa0a5922564c785bb2d1b99a394b886e4cc8a7a0"

# Enables /api/_test/reset-caches so cypress can clear in-process LRU caches
# (api-key, permission) after cy.task('db:reset'). Production deployments
# leave this unset; the route then returns 404.
TEST_RESET_TOKEN="cypress-reset-token"
