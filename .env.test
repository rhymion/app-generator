# Test environment configuration

PORT=3000
# 5433/6380, not the 5432/6379 defaults: this checkout's docker-compose
# project name (derived from the app-generator-1 directory) already has its
# own postgres-test/redis-test containers up on these ports, distinct from
# a sibling app-generator checkout's containers on the 5432/6379 defaults.
# Keep these two in sync with `docker ps` if the containers are ever
# recreated (cmd_357 fix — was pointing at 5432/6379 and silently drifting
# from the actually-running containers).
POSTGRES_PORT=5433
POSTGRES_DB=my_next_test
REDIS_PORT=6380
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/my_next_test"
NEXTAUTH_URL="http://localhost:3000"
REDIS_URL="redis://localhost:6380"
NODE_ENV="test"

AUTH_TRUST_HOST=true

# Enables /api/_test/reset-caches so cypress can clear in-process LRU caches
# (api-key, permission) after cy.task('db:reset'). Production deployments
# leave this unset; the route then returns 404.
TEST_RESET_TOKEN="cypress-reset-token"

# Disable Prisma Accelerate in test env (use direct local DB connection)
PRISMA_DATABASE_URL=

# The Cypress UI suite logs in fresh for every `it()` (~150+ credential POSTs
# from one IP over the full run), all sharing the Redis-backed
# `auth:signin:credentials` counter. Widen just that bucket so the suite's
# own legitimate volume doesn't trip the production-tuned ceiling of 10/min.
# See lib/rate-limit/index.ts for why this can't be a NODE_ENV check instead.
RATE_LIMIT_AUTH_CREDENTIALS_LIMIT=500

# Same reason as RATE_LIMIT_AUTH_CREDENTIALS_LIMIT above, for the mobile
# password-grant endpoint (cmd_357): cypress/e2e/api/mobile_auth.cy.ts makes
# several legitimate POST /api/mobile/auth/token calls against the same
# seeded test identity within one run, all sharing the IP+email-keyed
# counter. See lib/rate-limit/index.ts.
RATE_LIMIT_MOBILE_AUTH_TOKEN_LIMIT=500
