# Test environment configuration
# This file is loaded during e2e tests

# Use a separate test database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_next_test"

# For Cypress e2e tests
NODE_ENV="test"
NEXTAUTH_URL="http://localhost:3000"

# NextAuth secret - must match the variable name used in auth.ts (AUTH_SECRET)
AUTH_SECRET="test-secret-key-change-in-production"
