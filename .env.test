# Test environment configuration
# This file is loaded during e2e tests.
#
# Values below are DEFAULTS. Override any of them by exporting the same
# variable in your shell before running npm scripts (useful for running
# parallel worktrees on different ports). dotenv-cli does not override
# pre-existing shell env vars, so shell values win.

# Application port (Next.js dev/start respects this natively)
PORT=3000

# Postgres host port (mapped to container's 5432)
POSTGRES_PORT=5432

# Test database name
POSTGRES_DB=my_next_test

# Composed URLs — override these directly if you need a different host/user/etc.
DATABASE_URL="postgresql://postgres:postgres@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"
NEXTAUTH_URL="http://localhost:${PORT}"

NODE_ENV="test"

# NextAuth secret - must match the variable name used in auth.ts (AUTH_SECRET)
AUTH_SECRET="3cec2cbfc3a51813606e15d9aa0a5922564c785bb2d1b99a394b886e4cc8a7a0"
