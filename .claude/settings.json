{
  "permissions": {
    "allow": [
      "Bash(npm run docker:up:test)",
      "Bash(npm run docker:down:test)",
      "Bash(npm run docker:up:dev)",
      "Bash(npm run docker:down:dev)",
      "Bash(npm run generate-code)",
      "Bash(npm run check:generated)",
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run test:vitest)",
      "Bash(npm run test:pytest)",
      "Bash(npm run test:e2e:build)",
      "Bash(npm run test:e2e:cy:api)",
      "Bash(npm run test:e2e:cy:ui)",
      "Bash(npm run test:e2e:cy:start)",
      "Bash(npm run test:e2e)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:push)",
      "Bash(npm run db:seed-baseline)",
      "Bash(npm run lint)",
      "Bash(npm audit --omit=dev --audit-level=high)",
      "Bash(pip-audit -r requirements.txt)",
      "Bash(npx vitest:*)",
      "Bash(npx cypress run --browser chromium --spec *)",
      "Bash(pytest code_generator/tests*)",
      "Bash(cd *)",
      "Bash(docker compose --env-file .env.test -f docker-compose.test.yml *)",
      "Bash(docker compose --env-file .env.development -f docker-compose.dev.yml *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree list*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf /mnt/*)",
      "Bash(rm -rf /mnt/c/*)",
      "Bash(rm -rf /home/*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(tmux kill-server*)",
      "Bash(tmux kill-session*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git clean -f*)",
      "Bash(git stash*)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(fdisk*)",
      "Bash(mount*)",
      "Bash(umount*)",
      "Bash(chmod -R * /)",
      "Bash(chown -R * /)",
      "Bash(bash)",
      "Bash(sh)",
      "Bash(zsh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/project_hooks.py\" session-env",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/project_hooks.py\" investigate-snapshot",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/project_hooks.py\" guard-generated",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/project_hooks.py\" check-written-file",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/project_hooks.py\" investigate-verify",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Judge only the latest user request: the user's own words in the most recent user message (a slash command's task text counts). Do not infer goals the user did not state (for example 'get CI passing' when the user only asked a question). Return {\"ok\": true} when all of these hold, otherwise {\"ok\": false, \"reason\": \"...\"} naming the one thing Claude can still do on its own: (a) Claude's final message states the task type (generate-schema / update-generator / add-component / update-code / investigate, per CLAUDE.md). (b) For generate-schema, update-generator, add-component or update-code, the final message reports each required gate of CLAUDE.md as run and passed; for investigate, it states that no source files were modified. (c) Nothing the user asked for is left that Claude could do without the user's approval. These count as satisfied, not outstanding: a question that has been answered; a step that needs the user's decision or approval (push, merge, deploy, closing or commenting on an issue, dismissing an alert, choosing between options) when Claude asked for it; a result Claude cannot observe from here (for example CI after a push) when Claude said so; an environmental failure Claude reported per CLAUDE.md. If a stop hook already blocked this stop and Claude's reply only repeats that it is waiting for the user, return {\"ok\": true}."
          }
        ]
      }
    ]
  }
}
