{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(npm run docker:up:test)",
      "Bash(npm run docker:down:test)",
      "Bash(npm run docker:up:dev)",
      "Bash(npm run docker:down:dev)",
      "Bash(npm run generate-code)",
      "Bash(npm run check:generated)",
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run test:vitest)",
      "Bash(npm run test:pytest)",
      "Bash(npm run test:e2e:build)",
      "Bash(npm run test:e2e:cy:api)",
      "Bash(npm run test:e2e:cy:ui)",
      "Bash(npm run test:e2e:cy:start)",
      "Bash(npm run test:e2e)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:push)",
      "Bash(npm run db:seed-tenant)",
      "Bash(npm run lint)",
      "Bash(npm audit --omit=dev --audit-level=high)",
      "Bash(pip-audit -r requirements.txt)",
      "Bash(npx vitest:*)",
      "Bash(npx cypress run --browser chromium --spec *)",
      "Bash(pytest code_generator/tests*)",
      "Bash(cd *)",
      "Bash(docker compose --env-file .env.test -f docker-compose.test.yml *)",
      "Bash(docker compose --env-file .env.development -f docker-compose.dev.yml *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree list*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf /mnt/*)",
      "Bash(rm -rf /mnt/c/*)",
      "Bash(rm -rf /home/*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(tmux kill-server*)",
      "Bash(tmux kill-session*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git clean -f*)",
      "Bash(git stash*)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(fdisk*)",
      "Bash(mount*)",
      "Bash(umount*)",
      "Bash(chmod -R * /)",
      "Bash(chown -R * /)",
      "Bash(bash)",
      "Bash(sh)",
      "Bash(zsh)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Before stopping: (a) state which task type the work was (generate-schema / update-generator / add-component / update-code / investigate, per CLAUDE.md). (b) For generate-schema, update-generator, add-component, or update-code: confirm each required gate ran successfully end-to-end (check the gate matrix in CLAUDE.md). For investigate: confirm no source files were modified. (c) Confirm nothing in the original request is still outstanding. If any of these is not satisfied, respond with {\"ok\": false, \"reason\": \"...\"}."
          }
        ]
      }
    ]
  }
}
